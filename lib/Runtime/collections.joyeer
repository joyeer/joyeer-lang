@c_extern(symbol: "joyeer_panic")
private func panic(message: Int): Never

@c_extern(symbol: "joyeer_intrinsic_literal_address")
private func literalAddress(text: String): Int

@c_extern(symbol: "joyeer_array_create_owned_abi")
private func createOwned(output: Int, values: Int, count: Int, elementSize: Int,
        cloneElement: Int, destroyElement: Int): Void

@c_extern(symbol: "joyeer_array_clone_abi")
private func cloneArray(output: Int, data: Int, count: Int): Void

@c_extern(symbol: "joyeer_array_append_owned_abi")
private func appendOwned(array: Int, element: Int): Void

@c_extern(symbol: "joyeer_array_remove_last_abi")
private func removeLastOwned(array: Int, element: Int): Int

@c_extern(symbol: "joyeer_array_consume_empty_abi")
private func consumeEmptyArray(array: Int): Void

@c_extern(symbol: "joyeer_array_destroy_abi")
private func destroyArray(array: Int): Void

@compiler_role(array_type)
public struct Array<T> {
    private var address: Int
    private var count: Int
    private var capacity: Int

    @compiler_role(array_element)
    private borrowing func element(index: Int): Int {
        if index < 0 {
            panic(message: literalAddress(text: "array index out of bounds"))
        }
        // Every live array has a header, so address == 0 implies count == 0.
        if index >= self.count {
            panic(message: literalAddress(text: "array index out of bounds"))
        }
        return joyeer_intrinsic_slot_address<T>(base: self.address, index: index)
    }

    @compiler_role(array_copy)
    private borrowing func duplicate(): Array<T> {
        let slot = joyeer_intrinsic_stack_slot<Array<T>>()
        cloneArray(output: slot, data: self.address, count: self.count)
        return joyeer_intrinsic_move_out<Array<T>>(address: slot)
    }

    public mutating func append(element: consuming T): Void {
        let slot = joyeer_intrinsic_stack_slot<T>()
        joyeer_intrinsic_move_in<T>(address: slot, value: consume element)
        appendOwned(array: joyeer_intrinsic_place_address<Array<T>>(value: &self), element: slot)
    }

    public mutating func removeLast(): Optional<T> {
        let slot = joyeer_intrinsic_stack_slot<T>()
        if removeLastOwned(array: joyeer_intrinsic_place_address<Array<T>>(value: &self), element: slot) == 0 {
            return .None
        }
        return .Some(joyeer_intrinsic_move_out<T>(address: slot))
    }

    // `text.utf8()`: an owned copy of a String's bytes (decision 0028 stage 3), called on an inert zero value. The
    // compiler instantiates it only for `[UInt8]`, so each byte is one element.
    @compiler_role(string_utf8)
    private consuming func utf8(text: String): Array<T> {
        let slot = joyeer_intrinsic_stack_slot<Array<T>>()
        createOwned(output: slot, values: stringData(text: text), count: stringCount(text: text),
                elementSize: joyeer_intrinsic_size_of<T>(), cloneElement: joyeer_intrinsic_clone_callback<T>(),
                destroyElement: joyeer_intrinsic_destroy_callback<T>())
        return joyeer_intrinsic_move_out<Array<T>>(address: slot)
    }

    @compiler_role(container_end)
    public consuming func consumeEmpty(): Void {
        consumeEmptyArray(array: joyeer_intrinsic_place_address<Array<T>>(value: &self))
    }

    @compiler_role(array_literal)
    private consuming func literal(address: Int, count: Int): Array<T> {
        let slot = joyeer_intrinsic_stack_slot<Array<T>>()
        createOwned(output: slot,
                values: address, count: count, elementSize: joyeer_intrinsic_size_of<T>(),
                cloneElement: joyeer_intrinsic_clone_callback<T>(),
                destroyElement: joyeer_intrinsic_destroy_callback<T>())
        return joyeer_intrinsic_move_out<Array<T>>(address: slot)
    }

    deinit() {
        joyeer_intrinsic_destroy_range<T>(address: self.address, count: self.count)
        if self.address == 0 { return }
        &self.count = 0
        destroyArray(array: joyeer_intrinsic_place_address<Array<T>>(value: &self))
    }
}

// The library dictionary (decision 0027): the `{data, count, capacity}` handle of the runtime dictionary ABI in
// `core/dictionaries.joyeer`, which keeps the algorithms (a linear scan comparing keys by the runtime key kind), the
// traps, the allocation sizes and the growth. Keys are passed by `borrow_address`; owned keys and values move through
// stack slots, because the runtime adopts their bytes.

@c_extern(symbol: "joyeer_dictionary_create_owned_abi")
private func createDictionary(output: Int, entries: Int, count: Int, keySize: Int, valueSize: Int,
        entrySize: Int, valueOffset: Int, keyKind: Int32, cloneKey: Int, destroyKey: Int,
        cloneValue: Int, destroyValue: Int): Void

@c_extern(symbol: "joyeer_dictionary_clone_abi")
private func cloneDictionary(output: Int, data: Int, count: Int): Void

@c_extern(symbol: "joyeer_dictionary_set_owned_abi")
private func setOwned(dictionary: Int, key: Int, value: Int): Void

@c_extern(symbol: "joyeer_dictionary_find_abi")
private func findValue(data: Int, count: Int, key: Int, keySize: Int, keyKind: Int32): Int

@c_extern(symbol: "joyeer_dictionary_at_abi")
private func valueAt(data: Int, count: Int, key: Int, keySize: Int, keyKind: Int32): Int

@c_extern(symbol: "joyeer_dictionary_destroy_abi")
private func destroyDictionary(dictionary: Int): Void

// One entry as a literal packs it: its ordinary layout is the runtime's entry layout, the key at offset 0 and the
// value at `alignTo(size_of<K>, align_of<V>)`. It is never a value.
@compiler_role(dict_entry)
private struct DictEntry<K, V> {
    var key: K
    var value: V
}

@compiler_role(dict_type)
public struct Dict<K, V> {
    private var address: Int
    private var count: Int
    private var capacity: Int

    // The address of the stored value: `d[k]` reads, borrows, consumes and mutates through it. A missing key traps
    // with `dictionary key not found` and never inserts.
    @compiler_role(dict_element)
    private borrowing func element(key: K): Int {
        return valueAt(data: self.address, count: self.count,
                key: joyeer_intrinsic_borrow_address<K>(value: key), keySize: joyeer_intrinsic_size_of<K>(),
                keyKind: joyeer_intrinsic_key_kind<K>() as Int32)
    }

    // `&d[k] = v`: inserts, or replaces the value of an existing key (the runtime then destroys the incoming key and
    // the old value).
    @compiler_role(dict_set)
    private mutating func insert(key: consuming K, value: consuming V): Void {
        let keySlot = joyeer_intrinsic_stack_slot<K>()
        let valueSlot = joyeer_intrinsic_stack_slot<V>()
        joyeer_intrinsic_move_in<K>(address: keySlot, value: consume key)
        joyeer_intrinsic_move_in<V>(address: valueSlot, value: consume value)
        setOwned(dictionary: joyeer_intrinsic_place_address<Dict<K, V>>(value: &self), key: keySlot,
                value: valueSlot)
    }

    // An independent copy of the stored value, or `.None` for a missing key. One local returned once: after inlining
    // its stack slot splits into scalars, so the caller's `match` folds (two returns leave an aggregate phi that
    // LLVM does not split, measurably slower in a lookup loop).
    @compiler_role(dict_get)
    public borrowing func get(key: K): Optional<V> {
        let value = findValue(data: self.address, count: self.count,
                key: joyeer_intrinsic_borrow_address<K>(value: key), keySize: joyeer_intrinsic_size_of<K>(),
                keyKind: joyeer_intrinsic_key_kind<K>() as Int32)
        var found: Optional<V> = .None
        if value != 0 {
            let slot = joyeer_intrinsic_stack_slot<V>()
            joyeer_intrinsic_clone_at<V>(destination: slot, source: value)
            found = .Some(joyeer_intrinsic_move_out<V>(address: slot))
        }
        return found
    }

    @compiler_role(dict_copy)
    private borrowing func duplicate(): Dict<K, V> {
        let slot = joyeer_intrinsic_stack_slot<Dict<K, V>>()
        cloneDictionary(output: slot, data: self.address, count: self.count)
        return joyeer_intrinsic_move_out<Dict<K, V>>(address: slot)
    }

    // A literal: `count` entries packed at `address`, moved into a new dictionary (duplicate keys keep the last
    // value). Called on an inert zero value.
    @compiler_role(dict_literal)
    private consuming func literal(address: Int, count: Int): Dict<K, V> {
        // The runtime's entry formula: the value at the key's size rounded up to the value's alignment. Written
        // here, not as a helper: a non-generic prelude function would be emitted into every module.
        let valueAlignment = joyeer_intrinsic_align_of<V>()
        let valueOffset = (joyeer_intrinsic_size_of<K>() + valueAlignment - 1) / valueAlignment * valueAlignment
        let slot = joyeer_intrinsic_stack_slot<Dict<K, V>>()
        createDictionary(output: slot, entries: address, count: count, keySize: joyeer_intrinsic_size_of<K>(),
                valueSize: joyeer_intrinsic_size_of<V>(), entrySize: joyeer_intrinsic_size_of<DictEntry<K, V>>(),
                valueOffset: valueOffset, keyKind: joyeer_intrinsic_key_kind<K>() as Int32,
                cloneKey: joyeer_intrinsic_clone_callback<K>(), destroyKey: joyeer_intrinsic_destroy_callback<K>(),
                cloneValue: joyeer_intrinsic_clone_callback<V>(),
                destroyValue: joyeer_intrinsic_destroy_callback<V>())
        return joyeer_intrinsic_move_out<Dict<K, V>>(address: slot)
    }

    deinit() {
        // A moved-from or zero value owns nothing: no runtime call.
        if self.address == 0 { return }
        destroyDictionary(dictionary: joyeer_intrinsic_place_address<Dict<K, V>>(value: &self))
    }
}

// The String operations (decision 0028 stage 3). A String is a borrowed `{ data, count }` pair: the two projection
// intrinsics read its halves, and the runtime functions take them as Int words, as their exports in
// `core/strings.joyeer` and `core/text.joyeer` declare them. Lowering calls these private functions for `s.count`,
// `s[i]`, `+` and `+=`, `==` and `!=`, and the orderings, and always inlines them; `s.utf8()` is `Array`'s
// `string_utf8` method. They must not use those String operations themselves. Lowering emits each only into a
// module that uses it, but every module checks their signatures, so these name no library type.

@c_extern(symbol: "joyeer_intrinsic_string_data")
private func stringData(text: String): Int

@c_extern(symbol: "joyeer_intrinsic_string_count")
private func stringCount(text: String): Int

@c_extern(symbol: "joyeer_intrinsic_load_u8")
private func loadByte(address: Int): UInt8

@c_extern(symbol: "joyeer_string_concat_abi")
private func concatenateBytes(output: Int, leftData: Int, leftCount: Int, rightData: Int, rightCount: Int): Void

@c_extern(symbol: "joyeer_string_equal_abi")
private func equalBytes(leftData: Int, leftCount: Int, rightData: Int, rightCount: Int): Bool

@c_extern(symbol: "joyeer_string_compare_abi")
private func compareBytes(leftData: Int, leftCount: Int, rightData: Int, rightCount: Int): Int

@compiler_role(string_count)
private func byteCount(text: String): Int {
    return stringCount(text: text)
}

// `text[index]`: the index is checked against the byte count, then one byte is read. `slot_address` has no overflow
// check; the index is already within the String.
@compiler_role(string_byte)
private func byteAt(text: String, index: Int): UInt8 {
    if index < 0 {
        panic(message: literalAddress(text: "string index out of bounds"))
    }
    if index >= stringCount(text: text) {
        panic(message: literalAddress(text: "string index out of bounds"))
    }
    return loadByte(address: joyeer_intrinsic_slot_address<UInt8>(base: stringData(text: text), index: index))
}

// `left + right`: a new owned String.
@compiler_role(string_concat)
private func concatenate(left: String, right: String): String {
    let slot = joyeer_intrinsic_stack_slot<String>()
    concatenateBytes(output: slot, leftData: stringData(text: left), leftCount: stringCount(text: left),
            rightData: stringData(text: right), rightCount: stringCount(text: right))
    return joyeer_intrinsic_move_out<String>(address: slot)
}

// `left == right`; `!=` is its negation.
@compiler_role(string_equal)
private func equals(left: String, right: String): Bool {
    return equalBytes(leftData: stringData(text: left), leftCount: stringCount(text: left),
            rightData: stringData(text: right), rightCount: stringCount(text: right))
}

// -1, 0 or 1 by the first differing byte, else by length: each ordering compares the result with 0.
@compiler_role(string_order)
private func order(left: String, right: String): Int {
    return compareBytes(leftData: stringData(text: left), leftCount: stringCount(text: left),
            rightData: stringData(text: right), rightCount: stringCount(text: right))
}
