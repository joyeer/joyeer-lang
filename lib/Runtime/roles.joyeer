// The compiler-bundled role prelude: library declarations that the compiler binds to language
// syntax by closed `@compiler_role` roles (decision 0024). It is always loaded, separately from the
// concurrency prelude, so a caller-supplied concurrency prelude never removes these declarations.
//
// `T?`, `nil`, implicit wrapping, `x!`, `x?.field` and postfix `?` bind to `Optional`; postfix `?`
// and the values the compiler creates for `as?` bind to `Result`. The declarations carry no code,
// and the cases are in tag order.

@compiler_role(optional_type)
public enum Optional<T> {
    Some(T),
    None,
}

@compiler_role(result_type)
public enum Result<T, E> {
    Ok(T),
    Err(E),
}

// `==` and `!=` bind to this protocol by its role (decision 0031, spec 20.13). The integer types, `Bool`, `UInt8`,
// `Float`, `Double`, `String` and `Void` conform by the compiler, with no witness method.
@compiler_role(equatable)
public protocol Equatable {
    func equals(other: Self): Bool
}

// `X?` and `Result<X, Y>` conform when their payloads do: derived, they compare the tags and then the payloads
// (decision 0031, spec 20.13.3). These two empty extensions are the one extension the role enums admit.
extension Optional<T>: Equatable {}

extension Result<T, E>: Equatable {}
