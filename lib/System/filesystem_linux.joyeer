import Foundation

// Linux primitives for filesystem.joyeer, over the kernel's system calls (decision
// 0011): no C library, stream or `errno`. Paths are UTF-8 with a NUL terminator. A handle
// is a file descriptor. Results are >= 0 on success and the negated errno on failure,
// which is what the kernel returns.
//
// A file opens with O_CLOEXEC, so it is not inherited by a child process the program
// starts. Exclusive create is open(O_CREAT | O_EXCL, 0666). The struct layouts below are
// the kernel's, the same on every architecture: struct statx and struct linux_dirent64.
// Only the system call numbers and O_DIRECTORY differ between x86-64 and AArch64.

private let interrupted: Int = 4
private let statxBufferSize: Int = 256
private let entriesBufferSize: Int = 32768
private let kindMask: Int = 61440
private let kindFile: Int = 32768
private let kindDirectory: Int = 16384
private let kindSymlink: Int = 40960
private let currentDirectory: Int = 0 - 100
private let closeOnExec: Int = 524288
private let createExclusive: Int = 193
private let writeOnly: Int = 1

@platform(linux)
func nativeExecutableAccess(path: [UInt8]): Int {
    var bytes = path
    // faccessat(AT_FDCWD, path, X_OK), using real IDs like access(2).
    return linuxCall(x86: 269, arm: 48, first: currentDirectory, second: addressOfBytes(bytes: &bytes),
        third: 1, fourth: 0, fifth: 0, sixth: 0)
}

@platform(linux)
func nativeReadLink(path: [UInt8], buffer: inout [UInt8]): Int {
    var bytes = path
    let capacity = buffer.count
    return linuxCall(x86: 267, arm: 78, first: currentDirectory, second: addressOfBytes(bytes: &bytes),
        third: addressOfBytes(bytes: &buffer), fourth: capacity, fifth: 0, sixth: 0)
}

// The kernel's O_DIRECTORY differs between architectures.
@platform(linux)
private func directoryFlag(): Int {
    if onArm() { return 16384 }
    return 65536
}

// openat(AT_FDCWD, path, flags, mode)
@platform(linux)
private func openPath(path: [UInt8], flags: Int, mode: Int): Int {
    var bytes = path
    let address = addressOfBytes(bytes: &bytes)
    var outcome = 0 - interrupted
    while outcome == 0 - interrupted {
        outcome = linuxCall(x86: 257, arm: 56, first: currentDirectory, second: address, third: flags,
            fourth: mode, fifth: 0, sixth: 0)
    }
    return outcome
}

@platform(linux)
func nativeOpenRead(path: [UInt8]): Int {
    return openPath(path: path, flags: closeOnExec, mode: 0)
}

@platform(linux)
func nativeOpenIdentity(path: [UInt8], directory: Bool): Int {
    // O_PATH acquires a metadata handle without requiring directory listing access.
    if directory { return openPath(path: path, flags: closeOnExec | directoryFlag() | 0x200000, mode: 0) }
    let noFollow = if onArm() { 32768 } else { 131072 }
    return openPath(path: path, flags: closeOnExec | noFollow | 2048, mode: 0)
}

@platform(linux)
func nativeFileIdentity(handle: Int, directory: Bool): Result<FileIdentity, FileSystemError> {
    var path: [UInt8] = [0]
    var info = zeroBuffer(count: statxBufferSize)
    // AT_EMPTY_PATH asks statx to inspect the open descriptor, not the path.
    let status = linuxCall(x86: 332, arm: 291, first: handle, second: addressOfBytes(bytes: &path),
        third: 4096, fourth: 257, fifth: addressOfBytes(bytes: &info), sixth: 0)
    if kernelFailed(outcome: status) { return .Err(failure(code: 0 - status)) }
    let isExpected = modeKind(mode: halfWord(bytes: info, offset: 28)) == (if directory { 1 } else { 0 })
    if !isExpected || (hostWord(bytes: info, offset: 0) & 257) != 257 {
        return .Err(.Other(invalidInputCode()))
    }

    return .Ok(FileIdentity(volume: hostWord(bytes: info, offset: 136),
        low: hostWord(bytes: info, offset: 32), high: 0))
}

@platform(linux)
func nativeOpenNew(path: [UInt8]): Int {
    return openPath(path: path, flags: createExclusive + writeOnly + closeOnExec, mode: 438)
}

// A read the kernel interrupted before it transferred anything is repeated.
@platform(linux)
func nativeRead(handle: Int, buffer: inout [UInt8], count: Int): Int {
    let address = addressOfBytes(bytes: &buffer)
    var outcome = 0 - interrupted
    while outcome == 0 - interrupted {
        outcome = linuxCall(x86: 0, arm: 63, first: handle, second: address, third: count, fourth: 0,
            fifth: 0, sixth: 0)
    }
    return outcome
}

@platform(linux)
func nativeWrite(handle: Int, buffer: [UInt8], count: Int): Int {
    var bytes = buffer
    let address = addressOfBytes(bytes: &bytes)
    var outcome = 0 - interrupted
    while outcome == 0 - interrupted {
        outcome = linuxCall(x86: 1, arm: 64, first: handle, second: address, third: count, fourth: 0,
            fifth: 0, sixth: 0)
    }
    return outcome
}

@platform(linux)
func nativeClose(handle: Int): Int {
    let outcome = linuxCall(x86: 3, arm: 57, first: handle, second: 0, third: 0, fourth: 0, fifth: 0,
        sixth: 0)
    if kernelFailed(outcome: outcome) { return outcome }
    return 0
}

@platform(linux)
func nativeReplaceFile(source: [UInt8], destination: [UInt8]): Int {
    var from = source
    var to = destination
    // renameat: do not fall back to copying across filesystems.
    return linuxCall(x86: 264, arm: 38, first: currentDirectory, second: addressOfBytes(bytes: &from),
        third: currentDirectory, fourth: addressOfBytes(bytes: &to), fifth: 0, sixth: 0)
}

// mkdirat(AT_FDCWD, path, 0777)
@platform(linux)
func nativeCreateDirectory(path: [UInt8]): Int {
    var bytes = path
    let outcome = linuxCall(x86: 258, arm: 34, first: currentDirectory, second: addressOfBytes(bytes: &bytes),
        third: 511, fourth: 0, fifth: 0, sixth: 0)
    if kernelFailed(outcome: outcome) { return outcome }
    return 0
}

// unlinkat(AT_FDCWD, path, flags): flags 0 removes a file, AT_REMOVEDIR (512) a directory.
@platform(linux)
private func unlink(path: [UInt8], flags: Int): Int {
    var bytes = path
    let outcome = linuxCall(x86: 263, arm: 35, first: currentDirectory, second: addressOfBytes(bytes: &bytes),
        third: flags, fourth: 0, fifth: 0, sixth: 0)
    if kernelFailed(outcome: outcome) { return outcome }
    return 0
}

@platform(linux)
func nativeRemoveFile(path: [UInt8]): Int {
    return unlink(path: path, flags: 0)
}

@platform(linux)
func nativeRemoveDirectory(path: [UInt8]): Int {
    let kind = nativeKind(path: path)
    if kind < 0 { return kind }
    if kind != 1 { return -20 }
    return unlink(path: path, flags: 512)
}

@platform(linux)
private func modeKind(mode: Int): Int {
    let format = mode & kindMask
    if format == kindFile { return 0 }
    if format == kindDirectory { return 1 }
    if format == kindSymlink { return 2 }
    return 3
}

// Kind tags: 0 file, 1 directory, 2 symlink, 3 other. The leaf is never followed.
// statx(AT_FDCWD, path, AT_SYMLINK_NOFOLLOW, STATX_TYPE, buffer); stx_mode sits at
// offset 28 of struct statx.
@platform(linux)
func nativeKind(path: [UInt8]): Int {
    var bytes = path
    var buffer = zeroBuffer(count: statxBufferSize)
    let outcome = linuxCall(x86: 332, arm: 291, first: currentDirectory,
        second: addressOfBytes(bytes: &bytes), third: 256, fourth: 1,
        fifth: addressOfBytes(bytes: &buffer), sixth: 0)
    if kernelFailed(outcome: outcome) { return outcome }
    return modeKind(mode: halfWord(bytes: buffer, offset: 28))
}

@platform(linux)
func nativeDirectoryNext(directory: inout DirectoryReader): Result<String?, Int> {
    if directory.cursor == directory.limit {
        let handle = directory.handle
        let address = addressOfBytes(bytes: &directory.buffer)
        var used = 0 - interrupted
        while used == 0 - interrupted {
            used = linuxCall(x86: 217, arm: 61, first: handle, second: address,
                third: entriesBufferSize, fourth: 0, fifth: 0, sixth: 0)
        }
        if used < 0 { return .Err(0 - used) }
        if used == 0 { return .Ok(nil) }
        &directory.cursor = 0
        &directory.limit = used
    }
    // linux_dirent64: record length at byte 16, NUL-terminated name at byte 19.
    let start = directory.cursor
    let remaining = directory.limit - start
    if remaining < 20 { return .Err(writeFaultCode()) }
    let length = halfWord(bytes: directory.buffer, offset: start + 16)
    if length < 20 || length > remaining { return .Err(writeFaultCode()) }
    &directory.cursor = start + length
    return posixDirectoryName(bytes: directory.buffer, start: start + 19, end: start + length)
}

@platform(linux)
func nativeOpenDirectory(path: String, bytes: [UInt8]): Result<DirectoryReader, FileSystemError> {
    let handle = openPath(path: bytes, flags: directoryFlag() + closeOnExec, mode: 0)
    if handle < 0 { return .Err(classifyError(code: 0 - handle)) }
    return .Ok(DirectoryReader(handle: handle, state: 0, buffer: zeroBuffer(count: entriesBufferSize),
        cursor: 0, limit: 0))
}

@platform(linux)
func nativeCloseDirectory(handle: Int): Int {
    return nativeClose(handle: handle)
}
