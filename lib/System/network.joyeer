import Foundation

// Blocking IPv4 TCP (spec §18.6, decision 0012), written in Joyeer. This file
// holds what is the same on every platform: the public types, argument
// validation, the dotted-quad parser, the send loop and the error handling.
// network_windows.joyeer and network_posix.joyeer hold the primitives.
//
// Primitive results are plain Ints: a value >= 0 is success (a handle, a byte
// count, a port, 0), and a negative value is the negated native error code.
// An IPv4 address crosses to the primitives as one Int, a.b.c.d packed as
// (a << 24) | (b << 16) | (c << 8) | d.

public enum NetworkError {
    InvalidInput(Int),
    AddressInUse(Int),
    AddressNotAvailable(Int),
    PermissionDenied(Int),
    ConnectionRefused(Int),
    ConnectionReset(Int),
    TimedOut(Int),
    Other(Int),
}

// A listening socket. The handle is not visible outside System. A listener owns its socket
// (decision 0015): it is noncopyable, and destroying it closes the socket. An explicit close
// stores -1, which tells the `deinit` there is nothing left to close.
public struct TcpListener {
    var handle: Int

    deinit() {
        if self.handle >= 0 { discard(handle: self.handle) }
    }
}

// A connected socket, owned and closed the same way.
public struct TcpConnection {
    var handle: Int

    deinit() {
        if self.handle >= 0 { discard(handle: self.handle) }
    }
}

public struct TcpReadiness {
    public let connections: [Int]
    public let listeners: [Int]
}

struct NativeTcpReadQueue {
    let handle: Int
    let records: Int  // Windows only; never points into Joyeer-managed storage.
    let capacity: Int
}

struct TcpReadQueueEvent {
    var index: Int
    var status: Int  // 0 for readiness, or a negated per-socket probe error.
}

public struct TcpReadQueue {
    var connections: [TcpConnection]
    var native: NativeTcpReadQueue
    var remaining: Int
    var current: Int
    var probeStatus: Int
    var readStatus: Int  // 1 live, 0 confirmed EOF, negative terminal error.
    var failure: NetworkError?

    deinit() {
        shutdownReadQueue(queue: &self)
    }
}

private let maximumReceiveBytes: Int = 1048576
private let maximumSendChunk: Int = 1073741824
private let maximumTimeoutMillis: Int = 2147483647
private let maximumPollSockets: Int = 64
private let maximumReadQueueSockets: Int = 4096
private let lowestPort: Int = 0
private let highestPort: Int = 65535

// The packed address of a dotted quad, or -1. Four decimal fields of one to
// three digits, each 0...255, with no leading zero except a lone "0".
func parseIpv4(text: String): Int {
    var packed = 0
    var fields = 0
    var index = 0
    while fields < 4 {
        var digits = 0
        var value = 0
        let start = index
        while index < text.count && text[index] >= 48 && text[index] <= 57 {
            value = value * 10 + (byteToInt(value: text[index]) - 48)
            digits = digits + 1
            index = index + 1
            if digits > 3 { return -1 }
        }
        if digits == 0 || value > 255 { return -1 }
        if digits > 1 && text[start] == 48 { return -1 }
        packed = (packed << 8) | value
        fields = fields + 1
        if fields < 4 {
            if index >= text.count || text[index] != 46 { return -1 }
            index = index + 1
        }
    }
    if index != text.count { return -1 }
    return packed
}

private func failed(status: Int): NetworkError {
    return classifyNetworkError(code: 0 - status)
}

func socketErrorNumber(bytes: [UInt8]): Int {
    return (bytes[0] as Int) | ((bytes[1] as Int) << 8) |
        ((bytes[2] as Int) << 16) | ((bytes[3] as Int) << 24)
}

private func networkClock(): Result<Int, NetworkError> {
    return match monotonicMilliseconds() {
        .Ok(millis) => .Ok(millis),
        .Err(.InvalidInput(code)) => .Err(.Other(code)),
        .Err(.InvalidEncoding(code)) => .Err(.Other(code)),
        .Err(.QueryFailed(code)) => .Err(.Other(code)),
        .Err(.OutOfRange(code)) => .Err(.Other(code)),
    }
}

private func timeRemaining(started: Int, timeoutMillis: Int): Result<Int, NetworkError> {
    if timeoutMillis == 0 { return .Ok(0) }
    let elapsed = networkClock()? - started
    if elapsed >= timeoutMillis { return .Err(.TimedOut(networkTimeoutCode())) }
    return .Ok(timeoutMillis - elapsed)
}

// Closes a socket whose close result is not reported: after another failure, which is the one
// reported, or when the owning value is destroyed.
private func discard(handle: Int) {
    if nativeTcpClose(handle: handle) < 0 { }
}

public func tcpListen(address: String, port: Int, backlog: Int): Result<TcpListener, NetworkError> {
    let packed = parseIpv4(text: address)
    if packed < 0 || port < lowestPort || port > highestPort || backlog < 1 {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    let handle = nativeTcpOpen()
    if handle < 0 { return .Err(failed(status: handle)) }
    var status = nativeTcpPrepareListener(handle: handle)
    if status >= 0 { status = nativeTcpBind(handle: handle, address: packed, port: port) }
    if status >= 0 { status = nativeTcpListen(handle: handle, backlog: backlog) }
    if status < 0 {
        discard(handle: handle)
        return .Err(failed(status: status))
    }
    return .Ok(TcpListener(handle: handle))
}

// -1 waits without limit, 0 does not wait, 1...2147483647 is a limit in milliseconds.
private func validTimeout(timeoutMillis: Int): Bool {
    return timeoutMillis >= -1 && timeoutMillis <= maximumTimeoutMillis
}

// Waits for the handle to become ready unless the timeout is -1. Returns .None when
// the call may go ahead, or the error to report; an expired wait is `.TimedOut`.
// The primitive's status is 1 ready, 0 expired, or the negated native error code.
private func waitFailure(handle: Int, timeoutMillis: Int): Optional<NetworkError> {
    if timeoutMillis < 0 { return .None }
    let waited = nativeTcpWait(handle: handle, timeoutMillis: timeoutMillis)
    if waited < 0 { return .Some(failed(status: waited)) }
    if waited == 0 { return .Some(.TimedOut(networkTimeoutCode())) }
    return .None
}

public func tcpAccept(listener: TcpListener, timeoutMillis: Int): Result<TcpConnection, NetworkError> {
    if !validTimeout(timeoutMillis: timeoutMillis) { return .Err(.InvalidInput(networkInvalidCode())) }
    return acceptConnection(listener: listener.handle, timeoutMillis: timeoutMillis)
}

@platform(windows, linux)
private func acceptConnection(listener: Int, timeoutMillis: Int): Result<TcpConnection, NetworkError> {
    let problem = waitFailure(handle: listener, timeoutMillis: timeoutMillis)
    match problem {
        .Some(error) => { return .Err(error) },
        .None => { },
    }
    let handle = nativeTcpAccept(handle: listener)
    if handle < 0 { return .Err(failed(status: handle)) }
    return .Ok(TcpConnection(handle: handle))
}

@platform(macos)
private func waitAfterWouldBlock(handle: Int, started: Int, timeoutMillis: Int): Result<Void, NetworkError> {
    if timeoutMillis == 0 { return .Err(.TimedOut(networkTimeoutCode())) }
    let limit = if timeoutMillis > 0 { timeRemaining(started: started, timeoutMillis: timeoutMillis)? } else { -1 }
    let ready = nativeTcpWait(handle: handle, timeoutMillis: limit)
    if ready < 0 { return .Err(failed(status: ready)) }
    if ready == 0 { return .Err(.TimedOut(networkTimeoutCode())) }
    return .Ok(())
}

@platform(macos)
private func acceptConnection(listener: Int, timeoutMillis: Int): Result<TcpConnection, NetworkError> {
    let started = if timeoutMillis > 0 { networkClock()? } else { 0 }
    var handle = nativeTcpAccept(handle: listener)
    while nativeTcpWouldBlock(status: handle) {
        waitAfterWouldBlock(handle: listener, started: started, timeoutMillis: timeoutMillis)?
        handle = nativeTcpAccept(handle: listener)
    }
    if handle < 0 { return .Err(failed(status: handle)) }
    return .Ok(TcpConnection(handle: handle))
}

public func tcpConnect(address: String, port: Int): Result<TcpConnection, NetworkError> {
    let packed = parseIpv4(text: address)
    if packed < 0 || port < 1 || port > highestPort {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    let handle = nativeTcpOpen()
    if handle < 0 { return .Err(failed(status: handle)) }
    let status = nativeTcpConnect(handle: handle, address: packed, port: port)
    if status < 0 {
        discard(handle: handle)
        return .Err(failed(status: status))
    }
    return .Ok(TcpConnection(handle: handle))
}

private func connectNonblocking(handle: Int, address: Int, port: Int, started: Int,
    timeoutMillis: Int): Result<Void, NetworkError> {
    let mode = nativeTcpSetNonblocking(handle: handle, enabled: true)
    if mode < 0 { return .Err(failed(status: mode)) }
    let _remaining = timeRemaining(started: started, timeoutMillis: timeoutMillis)?
    let connected = nativeTcpConnect(handle: handle, address: address, port: port)
    if connected < 0 {
        if !nativeTcpConnectPending(status: connected) { return .Err(failed(status: connected)) }
        while true {
            let remaining = timeRemaining(started: started, timeoutMillis: timeoutMillis)?
            let ready = nativeTcpWaitConnect(handle: handle, timeoutMillis: remaining)
            if ready >= 0 {
                if ready == 0 { return .Err(.TimedOut(networkTimeoutCode())) }
                break
            }
            if timeoutMillis == 0 || !nativeTcpInterrupted(status: ready) {
                return .Err(failed(status: ready))
            }
        }
        let status = nativeTcpSocketError(handle: handle)
        if status < 0 { return .Err(failed(status: status)) }
    }
    let restored = nativeTcpSetNonblocking(handle: handle, enabled: false)
    if restored < 0 { return .Err(failed(status: restored)) }
    return .Ok(())
}

public func tcpConnectWithin(address: String, port: Int, timeoutMillis: Int): Result<TcpConnection, NetworkError> {
    if timeoutMillis == -1 { return tcpConnect(address: address, port: port) }
    let packed = parseIpv4(text: address)
    if !validTimeout(timeoutMillis: timeoutMillis) || packed < 0 || port < 1 || port > highestPort {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    let started = if timeoutMillis == 0 { 0 } else { networkClock()? }
    let handle = nativeTcpOpen()
    if handle < 0 { return .Err(failed(status: handle)) }
    return match connectNonblocking(handle: handle, address: packed, port: port, started: started,
        timeoutMillis: timeoutMillis) {
        .Ok(_) => .Ok(TcpConnection(handle: handle)),
        .Err(error) => {
            discard(handle: handle)
            .Err(error)
        },
    }
}

public func tcpLocalPort(listener: TcpListener): Result<Int, NetworkError> {
    let port = nativeTcpPort(handle: listener.handle)
    if port < 0 { return .Err(failed(status: port)) }
    return .Ok(port)
}

public func tcpPoll(connections: [TcpConnection], listeners: [TcpListener],
    timeoutMillis: Int): Result<TcpReadiness, NetworkError> {
    if !validTimeout(timeoutMillis: timeoutMillis) ||
        connections.count > maximumPollSockets || listeners.count > maximumPollSockets - connections.count {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    let total = connections.count + listeners.count
    if total == 0 { return .Err(.InvalidInput(networkInvalidCode())) }

    var handles: [Int] = []
    var index = 0
    while index < connections.count {
        if connections[index].handle < 0 { return .Err(.InvalidInput(networkInvalidCode())) }
        &handles.append(element: connections[index].handle)
        index = index + 1
    }
    index = 0
    while index < listeners.count {
        &handles.append(element: listeners[index].handle)
        index = index + 1
    }
    var ready = zeroBuffer(count: total)
    let status = nativeTcpPoll(handles: handles, readiness: &ready, timeoutMillis: timeoutMillis)
    if status < 0 { return .Err(failed(status: status)) }

    var readyConnections: [Int] = []
    var readyListeners: [Int] = []
    index = 0
    while index < total {
        if ready[index] != 0 {
            if index < connections.count {
                &readyConnections.append(element: index)
            } else {
                &readyListeners.append(element: index - connections.count)
            }
        }
        index = index + 1
    }
    return .Ok(TcpReadiness(connections: consume readyConnections, listeners: consume readyListeners))
}

private func closeReadQueueSlot(queue: inout TcpReadQueue, index: Int): Int {
    let status = nativeReadQueueCloseSocket(handle: queue.connections[index].handle)
    &queue.connections[index].handle = -1
    &queue.remaining = queue.remaining - 1
    return status
}

private func shutdownReadQueue(queue: inout TcpReadQueue) {
    if queue.native.handle == -1 { return }
    var index = 0
    while index < queue.connections.count {
        if queue.connections[index].handle >= 0 {
            if closeReadQueueSlot(queue: &queue, index: index) < 0 { }
        }
        index = index + 1
    }
    nativeReadQueueDestroy(port: queue.native)
    &queue.native = NativeTcpReadQueue(handle: -1, records: 0, capacity: 0)
    &queue.current = -1
}

public func tcpOpenReadQueue(connections: consuming [TcpConnection]): Result<TcpReadQueue, NetworkError> {
    let count = connections.count
    if count < 1 || count > maximumReadQueueSockets { return .Err(.InvalidInput(networkInvalidCode())) }
    var index = 0
    while index < count {
        if connections[index].handle < 0 { return .Err(.InvalidInput(networkInvalidCode())) }
        index = index + 1
    }
    let port = nativeReadQueueOpen(capacity: count)?
    var queue = TcpReadQueue(connections: consume connections, native: port, remaining: count,
        current: -1, probeStatus: 0, readStatus: 1, failure: nil)
    index = 0
    while index < count {
        let handle = queue.connections[index].handle
        let mode = nativeTcpSetNonblocking(handle: handle, enabled: true)
        if mode < 0 { return .Err(failed(status: mode)) }
        let registered = nativeReadQueueRegister(port: port, handle: handle, index: index)
        if registered < 0 { return .Err(failed(status: registered)) }
        index = index + 1
    }
    return .Ok(consume queue)
}

private func waitReadQueue(queue: inout TcpReadQueue, timeoutMillis: Int): Result<Int?, NetworkError> {
    if queue.remaining == 0 { return .Ok(nil) }
    let started = if timeoutMillis > 0 { networkClock()? } else { 0 }
    let previous = queue.current
    &queue.current = -1
    if previous >= 0 {
        if queue.readStatus <= 0 {
            if closeReadQueueSlot(queue: &queue, index: previous) < 0 { }
        } else {
            let armed = nativeReadQueueArm(port: queue.native, handle: queue.connections[previous].handle,
                index: previous)
            if armed < 0 { return .Err(failed(status: armed)) }
        }
    }
    var event = TcpReadQueueEvent(index: -1, status: 0)
    while queue.remaining > 0 {
        var limit = timeoutMillis
        if timeoutMillis > 0 {
            let elapsed = networkClock()? - started
            if elapsed >= timeoutMillis { return .Ok(nil) }
            limit = timeoutMillis - elapsed
        }
        let waited = nativeReadQueueWait(port: queue.native, timeoutMillis: limit, event: &event)
        if waited == 0 { return .Ok(nil) }
        if waited < 0 {
            if !nativeTcpInterrupted(status: waited) { return .Err(failed(status: waited)) }
            if timeoutMillis == 0 { return .Ok(nil) }
            continue
        }
        precondition(condition: event.index >= 0 && event.index < queue.connections.count &&
            queue.connections[event.index].handle >= 0, message: "invalid TCP read queue event")
        if nativeReadQueueCancelled(status: event.status) {
            let armed = nativeReadQueueArm(port: queue.native, handle: queue.connections[event.index].handle,
                index: event.index)
            if armed < 0 { return .Err(failed(status: armed)) }
            continue
        }
        &queue.current = event.index
        &queue.probeStatus = event.status
        &queue.readStatus = 1
        return .Ok(.Some(event.index))
    }
    return .Ok(nil)
}

public func tcpReadQueueWait(queue: inout TcpReadQueue, timeoutMillis: Int): Result<Int?, NetworkError> {
    if !validTimeout(timeoutMillis: timeoutMillis) { return .Err(.InvalidInput(networkInvalidCode())) }
    match queue.failure {
        .Some(error) => { return .Err(error) },
        .None => { },
    }
    let waited = waitReadQueue(queue: &queue, timeoutMillis: timeoutMillis)
    match waited {
        .Err(error) => {
            shutdownReadQueue(queue: &queue)
            &queue.failure = .Some(error)
        },
        .Ok(_) => { },
    }
    return waited
}

private func readQueueSelection(queue: TcpReadQueue): Result<Int, NetworkError> {
    match queue.failure {
        .Some(error) => { return .Err(error) },
        .None => { },
    }
    if queue.current < 0 { return .Err(.InvalidInput(networkInvalidCode())) }
    return .Ok(queue.current)
}

public func tcpReadQueueReceive(queue: inout TcpReadQueue, maximumBytes: Int): Result<String?, NetworkError> {
    if maximumBytes < 1 || maximumBytes > maximumReceiveBytes { return .Err(.InvalidInput(networkInvalidCode())) }
    let index = readQueueSelection(queue: queue)?
    if queue.readStatus < 0 { return .Err(failed(status: queue.readStatus)) }
    if queue.readStatus == 0 { return .Ok(.Some("")) }

    var buffer = zeroBuffer(count: maximumBytes)
    let received = nativeTcpReceive(handle: queue.connections[index].handle, buffer: &buffer, count: maximumBytes)
    if received > 0 { return .Ok(.Some(stringFromBytes(bytes: buffer, count: received))) }
    if nativeTcpInterrupted(status: received) { return .Err(failed(status: received)) }
    if queue.probeStatus < 0 {
        &queue.readStatus = queue.probeStatus
    } else if received < 0 && !nativeTcpWouldBlock(status: received) {
        &queue.readStatus = received
    } else if received == 0 {
        &queue.readStatus = 0
    } else {
        return .Ok(nil)
    }
    if queue.readStatus < 0 { return .Err(failed(status: queue.readStatus)) }
    return .Ok(.Some(""))
}

public func tcpReadQueueSendWithin(queue: inout TcpReadQueue, contents: String,
    timeoutMillis: Int): Result<Void, NetworkError> {
    if timeoutMillis < 0 || !validTimeout(timeoutMillis: timeoutMillis) {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    let index = readQueueSelection(queue: queue)?
    if contents.count == 0 { return .Ok(()) }
    let started = if timeoutMillis == 0 { 0 } else { networkClock()? }
    return sendNonblocking(handle: queue.connections[index].handle, contents: contents, started: started,
        timeoutMillis: timeoutMillis)
}

public func tcpReadQueueCloseCurrent(queue: inout TcpReadQueue): Result<Void, NetworkError> {
    let index = readQueueSelection(queue: queue)?
    &queue.current = -1
    let status = closeReadQueueSlot(queue: &queue, index: index)
    if status < 0 { return .Err(failed(status: status)) }
    return .Ok(())
}

public func tcpReceive(connection: TcpConnection, maximumBytes: Int,
    timeoutMillis: Int): Result<String, NetworkError> {
    if connection.handle < 0 || maximumBytes < 1 || maximumBytes > maximumReceiveBytes ||
        !validTimeout(timeoutMillis: timeoutMillis) {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    return receiveWithin(handle: connection.handle, maximumBytes: maximumBytes, timeoutMillis: timeoutMillis)
}

@platform(windows, linux)
private func receiveWithin(handle: Int, maximumBytes: Int, timeoutMillis: Int): Result<String, NetworkError> {
    let problem = waitFailure(handle: handle, timeoutMillis: timeoutMillis)
    match problem {
        .Some(error) => { return .Err(error) },
        .None => { },
    }
    var buffer = zeroBuffer(count: maximumBytes)
    let received = nativeTcpReceive(handle: handle, buffer: &buffer, count: maximumBytes)
    if received < 0 { return .Err(failed(status: received)) }
    return .Ok(stringFromBytes(bytes: buffer, count: received))
}

@platform(macos)
private func receiveWithin(handle: Int, maximumBytes: Int, timeoutMillis: Int): Result<String, NetworkError> {
    var buffer = zeroBuffer(count: maximumBytes)
    if timeoutMillis < 0 {
        let received = nativeTcpReceive(handle: handle, buffer: &buffer, count: maximumBytes)
        if received < 0 { return .Err(failed(status: received)) }
        return .Ok(stringFromBytes(bytes: buffer, count: received))
    }
    let started = if timeoutMillis > 0 { networkClock()? } else { 0 }
    var received = nativeTcpReceiveNonblocking(handle: handle, buffer: &buffer, count: maximumBytes)
    while nativeTcpWouldBlock(status: received) {
        waitAfterWouldBlock(handle: handle, started: started, timeoutMillis: timeoutMillis)?
        received = nativeTcpReceiveNonblocking(handle: handle, buffer: &buffer, count: maximumBytes)
    }
    if received < 0 { return .Err(failed(status: received)) }
    return .Ok(stringFromBytes(bytes: buffer, count: received))
}

// The bytes of `bytes` from `start` on, as a new array.
private func bytesFrom(bytes: [UInt8], start: Int): [UInt8] {
    var rest: [UInt8] = []
    var index = start
    while index < bytes.count {
        &rest.append(element: bytes[index])
        index = index + 1
    }
    return rest
}

public func tcpSend(connection: TcpConnection, contents: String): Result<Void, NetworkError> {
    if connection.handle < 0 { return .Err(.InvalidInput(networkInvalidCode())) }
    if contents.count == 0 { return .Ok(()) }
    var pending = contents.utf8()
    while pending.count > 0 {
        var chunk = pending.count
        if chunk > maximumSendChunk { chunk = maximumSendChunk }
        let sent = nativeTcpSend(handle: connection.handle, buffer: pending, count: chunk, retry: true)
        if sent < 0 { return .Err(failed(status: sent)) }
        // A blocking send that accepts nothing would loop forever; report it.
        if sent == 0 { return .Err(.Other(networkInvalidCode())) }
        if sent >= pending.count { return .Ok(()) }
        pending = bytesFrom(bytes: pending, start: sent)
    }
    return .Ok(())
}

private func sendNonblocking(handle: Int, contents: String, started: Int,
    timeoutMillis: Int): Result<Void, NetworkError> {
    var position = 0
    while position < contents.count {
        var count = contents.count - position
        if count > 65536 { count = 65536 }
        var bytes = zeroBuffer(count: count)
        var index = 0
        while index < count {
            &bytes[index] = contents[position + index]
            index = index + 1
        }
        while true {
            let _remaining = timeRemaining(started: started, timeoutMillis: timeoutMillis)?
            let sent = nativeTcpSend(handle: handle, buffer: bytes, count: count, retry: false)
            if sent > 0 {
                position = position + sent
                break
            }
            if sent == 0 { return .Err(.Other(networkInvalidCode())) }
            if !nativeTcpWouldBlock(status: sent) {
                if timeoutMillis > 0 && nativeTcpInterrupted(status: sent) { continue }
                return .Err(failed(status: sent))
            }
            if timeoutMillis == 0 { return .Err(.TimedOut(networkTimeoutCode())) }
            let remaining = timeRemaining(started: started, timeoutMillis: timeoutMillis)?
            let ready = nativeTcpWaitWritable(handle: handle, timeoutMillis: remaining)
            if ready == 0 { return .Err(.TimedOut(networkTimeoutCode())) }
            if ready < 0 && !nativeTcpInterrupted(status: ready) { return .Err(failed(status: ready)) }
        }
    }
    return .Ok(())
}

public func tcpSendWithin(connection: inout TcpConnection, contents: String,
    timeoutMillis: Int): Result<Void, NetworkError> {
    if timeoutMillis == -1 { return tcpSend(connection: connection, contents: contents) }
    if connection.handle < 0 || !validTimeout(timeoutMillis: timeoutMillis) {
        return .Err(.InvalidInput(networkInvalidCode()))
    }
    if contents.count == 0 { return .Ok(()) }
    let started = if timeoutMillis == 0 { 0 } else { networkClock()? }
    let handle = connection.handle
    let mode = nativeTcpSetNonblocking(handle: handle, enabled: true)
    if mode < 0 { return .Err(failed(status: mode)) }
    let sent = sendNonblocking(handle: handle, contents: contents, started: started, timeoutMillis: timeoutMillis)
    let restored = nativeTcpSetNonblocking(handle: handle, enabled: false)
    if restored < 0 {
        &connection.handle = -1
        discard(handle: handle)
        return .Err(failed(status: restored))
    }
    return sent
}

public func tcpCloseConnection(connection: consuming TcpConnection): Result<Void, NetworkError> {
    if connection.handle < 0 { return .Ok(()) }
    let status = nativeTcpClose(handle: connection.handle)
    &connection.handle = -1
    if status < 0 { return .Err(failed(status: status)) }
    return .Ok(())
}

public func tcpCloseListener(listener: consuming TcpListener): Result<Void, NetworkError> {
    let status = nativeTcpClose(handle: listener.handle)
    &listener.handle = -1
    if status < 0 { return .Err(failed(status: status)) }
    return .Ok(())
}
