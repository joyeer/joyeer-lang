import Foundation

public enum HostQueryError {
    InvalidInput(Int),
    InvalidEncoding(Int),
    QueryFailed(Int),
    OutOfRange(Int),
}

public func environmentVariable(name: String): Result<String?, HostQueryError> {
    if name.count == 0 { return .Err(.InvalidInput(invalidInputCode())) }
    var index = 0
    while index < name.count {
        if name[index] == 0 || name[index] == b'=' {
            return .Err(.InvalidInput(invalidInputCode()))
        }
        index = index + 1
    }
    if !isValidUtf8(text: name) { return .Err(.InvalidEncoding(invalidEncodingCode())) }
    return nativeEnvironmentVariable(name: name)
}

public func currentDirectory(): Result<String, HostQueryError> {
    let path = nativeCurrentDirectory()?
    if !isValidUtf8(text: path) { return .Err(.InvalidEncoding(invalidEncodingCode())) }
    return .Ok(path)
}

public func executablePath(): Result<String, HostQueryError> {
    let path = nativeExecutablePath()?
    if !isValidUtf8(text: path) { return .Err(.InvalidEncoding(invalidEncodingCode())) }
    return .Ok(path)
}

public func monotonicMilliseconds(): Result<Int, HostQueryError> {
    return nativeClockMillis(monotonic: true)
}

public func wallClockMilliseconds(): Result<Int, HostQueryError> {
    return nativeClockMillis(monotonic: false)
}

func hostWord(bytes: [UInt8], offset: Int): UInt64 {
    var word: UInt64 = 0
    var remaining = 8
    while remaining > 0 {
        remaining = remaining - 1
        word = (word << 8) | (bytes[offset + remaining] as UInt64)
    }
    return word
}
