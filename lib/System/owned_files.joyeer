import Foundation

// State: active (0), exhausted (-1), or the first native I/O error (> 0).
public struct FileReader {
    var handle: Int
    var state: Int

    deinit() {
        if self.handle >= 0 { nativeClose(handle: self.handle) }
    }
}

public struct FileWriter {
    var handle: Int
    var state: Int

    deinit() {
        if self.handle >= 0 { ownedCloseWriter(handle: self.handle) }
    }
}

public struct DirectoryReader {
    var handle: Int
    var state: Int
    var buffer: [UInt8]
    var cursor: Int
    var limit: Int

    deinit() {
        if self.handle >= 0 { nativeCloseDirectory(handle: self.handle) }
    }
}

@platform(windows, linux)
func ownedOpenRead(path: [UInt8]): Int { return nativeOpenRead(path: path) }

@platform(windows, linux)
func ownedOpenNew(path: [UInt8]): Int { return nativeOpenNew(path: path) }

@platform(windows, linux)
func ownedWrite(handle: Int, buffer: [UInt8], count: Int): Int {
    return nativeWrite(handle: handle, buffer: buffer, count: count)
}

@platform(windows, linux)
func ownedCloseWriter(handle: Int): Int { return nativeClose(handle: handle) }

public func openFileRead(path: String): Result<FileReader, FileSystemError> {
    let bytes = encodePath(path: path)?
    let handle = ownedOpenRead(path: bytes)
    if handle < 0 {
        let code = 0 - handle
        if opensAsDirectory(path: bytes, code: code) { return .Err(.IsDirectory(code)) }
        return .Err(failure(code: code))
    }
    return .Ok(FileReader(handle: handle, state: 0))
}

public func openFileNew(path: String): Result<FileWriter, FileSystemError> {
    let bytes = encodePath(path: path)?
    let handle = ownedOpenNew(path: bytes)
    if handle < 0 { return .Err(failure(code: 0 - handle)) }
    return .Ok(FileWriter(handle: handle, state: 0))
}

public func readFileChunk(file: inout FileReader, maximumBytes: Int): Result<String, FileSystemError> {
    if maximumBytes < 1 || maximumBytes > 65536 { return .Err(.Other(invalidInputCode())) }
    if file.state < 0 { return .Ok("") }
    if file.state > 0 { return .Err(failure(code: file.state)) }
    var buffer = zeroBuffer(count: maximumBytes)
    let length = nativeRead(handle: file.handle, buffer: &buffer, count: maximumBytes)
    if length < 0 {
        &file.state = 0 - length
        return .Err(failure(code: file.state))
    }
    if length == 0 { &file.state = -1 }
    return .Ok(stringFromBytes(bytes: buffer, count: length))
}

public func writeFileChunk(file: inout FileWriter, contents: String): Result<Void, FileSystemError> {
    if file.state != 0 { return .Err(failure(code: file.state)) }
    let code = writeLoop(handle: file.handle, contents: contents, owned: true)
    if code != 0 {
        &file.state = code
        return .Err(failure(code: code))
    }
    return .Ok(())
}

public func closeFileReader(file: consuming FileReader): Result<Void, FileSystemError> {
    let handle = file.handle
    &file.handle = -1
    return closeResult(status: nativeClose(handle: handle))
}

public func closeFileWriter(file: consuming FileWriter): Result<Void, FileSystemError> {
    let handle = file.handle
    &file.handle = -1
    return closeResult(status: ownedCloseWriter(handle: handle))
}

private func closeResult(status: Int): Result<Void, FileSystemError> {
    if status < 0 { return .Err(failure(code: 0 - status)) }
    return .Ok(())
}

public func openDirectory(path: String): Result<DirectoryReader, FileSystemError> {
    let bytes = encodePath(path: path)?
    return nativeOpenDirectory(path: path, bytes: bytes)
}

public func nextDirectoryEntry(directory: inout DirectoryReader): Result<String?, FileSystemError> {
    if directory.state < 0 { return .Ok(nil) }
    if directory.state > 0 { return .Err(failure(code: directory.state)) }
    while true {
        match nativeDirectoryNext(directory: &directory) {
            .Err(code) => {
                &directory.state = code
                return .Err(failure(code: code))
            },
            .Ok(.None) => {
                &directory.state = -1
                return .Ok(nil)
            },
            .Ok(.Some(name)) => {
                if name != "." && name != ".." { return .Ok(.Some(name)) }
            },
        }
    }
    return .Ok(nil)
}

public func closeDirectory(directory: consuming DirectoryReader): Result<Void, FileSystemError> {
    let handle = directory.handle
    &directory.handle = -1
    if handle < 0 { return .Ok(()) }
    return closeResult(status: nativeCloseDirectory(handle: handle))
}

@platform(posix)
func posixDirectoryName(bytes: [UInt8], start: Int, end: Int): Result<String?, Int> {
    var name: [UInt8] = []
    var offset = start
    while offset < end && bytes[offset] != 0 {
        &name.append(element: bytes[offset])
        offset = offset + 1
    }
    if offset == end { return .Err(writeFaultCode()) }
    let text = stringFromBytes(bytes: name, count: name.count)
    if !isValidUtf8(text: text) { return .Err(invalidEncodingCode()) }
    return .Ok(.Some(text))
}
