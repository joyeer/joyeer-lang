import Foundation

public struct ChildProcess {
    var handle: Int

    deinit() {
        if self.handle >= 0 { nativeWait(child: self.handle, emergency: false) }
    }
}

// 0 when `text` can be passed to the host, otherwise the platform error code:
// an empty or NUL-containing value is invalid input, malformed UTF-8 is an
// encoding failure.
func textProblem(text: String, allowEmpty: Bool): Int {
    if text.count == 0 {
        if allowEmpty { return 0 }
        return invalidInputCode()
    }
    var index = 0
    while index < text.count {
        if text[index] == 0 { return invalidInputCode() }
        index = index + 1
    }
    if !isValidUtf8(text: text) { return invalidEncodingCode() }
    return 0
}

private func launch(executable: String, arguments: [String], workingDirectory: String): Result<Int, ProcessError> {
    var code = textProblem(text: executable, allowEmpty: false)
    if code == 0 { code = textProblem(text: workingDirectory, allowEmpty: false) }
    var index = 0
    while code == 0 && index < arguments.count {
        code = textProblem(text: arguments[index], allowEmpty: true)
        index = index + 1
    }
    if code != 0 { return .Err(.InvalidInput(code)) }
    return nativeStart(executable: executable, arguments: arguments, workingDirectory: workingDirectory)
}

public func runProcess(
    executable: String,
    arguments: [String],
    workingDirectory: String
): Result<ProcessStatus, ProcessError> {
    let handle = launch(executable: executable, arguments: arguments, workingDirectory: workingDirectory)?
    return nativeWait(child: handle, emergency: true)
}

public func startProcess(
    executable: String,
    arguments: [String],
    workingDirectory: String
): Result<ChildProcess, ProcessError> {
    let handle = launch(executable: executable, arguments: arguments, workingDirectory: workingDirectory)?
    return .Ok(ChildProcess(handle: handle))
}

public func waitProcess(child: consuming ChildProcess): Result<ProcessStatus, ProcessError> {
    let handle = child.handle
    &child.handle = -1
    return nativeWait(child: handle, emergency: false)
}
