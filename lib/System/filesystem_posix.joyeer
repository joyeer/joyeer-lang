import Foundation

// POSIX primitives for filesystem.joyeer. The names, codes and path rules that Linux and
// macOS share are here for both; the operations are macOS only, over libSystem, because
// Linux calls the kernel directly (filesystem_linux.joyeer). Paths are UTF-8 with a NUL
// terminator. A handle is an Int (a file descriptor or DIR*). Results are >= 0 on success and the
// negated errno on failure.
//
// Files use openx_np instead of variadic open so O_CLOEXEC and the creation mode
// can be set together. The layouts below are struct stat and struct dirent on macOS.

private let interrupted: Int = 4
private let closeOnExec: Int32 = 0x01000000
private let createExclusiveWrite: Int32 = 0x0A01  // O_CREAT | O_EXCL | O_WRONLY
private let fileSecurityMode: UInt32 = 4
private let directoryMode: UInt32 = 511
private let statxBufferSize: Int = 256
private let direntBufferSize: Int = 2048
private let kindMask: Int = 61440
private let kindFile: Int = 32768
private let kindDirectory: Int = 16384
private let kindSymlink: Int = 40960

@platform(macos)
@c_extern(symbol: "openx_np", pointer: "path")
private func openWithSecurity(path: [UInt8], flags: Int32, security: Int): Int32

@platform(macos)
@c_extern(symbol: "filesec_init")
private func fileSecurity(): Int

@platform(macos)
@c_extern(symbol: "filesec_set_property", pointer: "value")
private func setFileSecurity(security: Int, property: UInt32, value: [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "filesec_free")
private func freeFileSecurity(security: Int): Void

@platform(macos)
@c_extern(symbol: "close")
private func closeDescriptorP(descriptor: Int32): Int32

@platform(macos)
@c_extern(symbol: "read", pointer: "buffer")
private func readDescriptorP(descriptor: Int32, buffer: inout [UInt8], count: Int): Int

@platform(macos)
@c_extern(symbol: "write", pointer: "buffer")
private func writeDescriptorP(descriptor: Int32, buffer: [UInt8], count: Int): Int

@platform(macos)
@c_extern(symbol: "mkdir", pointer: "path")
private func mkdirP(path: [UInt8], mode: UInt32): Int32

@platform(macos)
@c_extern(symbol: "unlink", pointer: "path")
private func unlinkP(path: [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "rename", pointer: "source", pointer: "destination")
private func renameP(source: [UInt8], destination: [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "rmdir", pointer: "path")
private func rmdirP(path: [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "opendir", pointer: "path")
private func opendirP(path: [UInt8]): Int

@platform(macos)
@c_extern(symbol: "closedir")
private func closedirP(directory: Int): Int32

@platform(macos)
@c_extern(symbol: "readdir_r", pointer: "entry", pointer: "found")
private func readdirP(directory: Int, entry: inout [UInt8], found: inout [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "lstat", pointer: "path", pointer: "buffer")
private func lstatP(path: [UInt8], buffer: inout [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "fstat", pointer: "buffer")
private func fstatP(descriptor: Int32, buffer: inout [UInt8]): Int32

@platform(macos)
@c_extern(symbol: "access", pointer: "path")
private func accessP(path: [UInt8], mode: Int32): Int32

@platform(macos)
@c_extern(symbol: "readlink", pointer: "path", pointer: "buffer")
private func readlinkP(path: [UInt8], buffer: inout [UInt8], capacity: Int): Int

@platform(macos)
func nativeReadLink(path: [UInt8], buffer: inout [UInt8]): Int {
    let capacity = buffer.count
    let length = readlinkP(path: path, buffer: &buffer, capacity: capacity)
    if length < 0 { return lastFailure() }
    return length
}

@platform(posix)
public func readSymbolicLink(path: String): Result<String, FileSystemError> {
    let bytes = encodePath(path: path)?
    let capacity = 4096
    var buffer = zeroBuffer(count: capacity)
    let length = nativeReadLink(path: bytes, buffer: &buffer)
    if length < 0 { return .Err(failure(code: 0 - length)) }
    if length >= capacity { return .Err(.InvalidPath(nameTooLongErrno())) }
    let target = stringFromBytes(bytes: buffer, count: length)
    if !isValidUtf8(text: target) { return .Err(.InvalidPath(invalidEncodingCode())) }
    return .Ok(target)
}

@platform(macos)
func nativeExecutableAccess(path: [UInt8]): Int {
    if accessP(path: path, mode: 1) != 0 { return lastFailure() }
    return 0
}

// errno values that differ between Linux and macOS.
@platform(linux)
func encodingErrno(): Int { return 84 }

@platform(macos)
func encodingErrno(): Int { return 92 }

@platform(linux)
func nameTooLongErrno(): Int { return 36 }

@platform(macos)
func nameTooLongErrno(): Int { return 63 }

@platform(posix)
func invalidInputCode(): Int { return 22 }

@platform(posix)
func invalidEncodingCode(): Int { return encodingErrno() }

@platform(posix)
func invalidNameCode(): Int { return 22 }

@platform(posix)
func writeFaultCode(): Int { return 5 }

@platform(posix)
func separator(): String { return "/" }

@platform(posix)
func classifyError(code: Int): FileSystemError {
    if code == 22 || code == encodingErrno() || code == nameTooLongErrno() { return .InvalidPath(code) }
    if code == 2 { return .NotFound(code) }
    if code == 13 || code == 1 || code == 30 { return .PermissionDenied(code) }
    if code == 17 { return .AlreadyExists(code) }
    if code == 20 { return .NotDirectory(code) }
    if code == 21 { return .IsDirectory(code) }
    return .Other(code)
}

@platform(posix)
func nativePathBytes(text: String): [UInt8] {
    var bytes = text.utf8()
    &bytes.append(element: 0)
    return bytes
}

@platform(posix)
func opensAsDirectory(path: [UInt8], code: Int): Bool {
    // A directory opens for reading; the failure arrives later, as EISDIR.
    return false
}

@platform(posix)
func replacesBase(path: String): Bool {
    return path[0] == b'/'
}

@platform(posix)
func needsSeparator(base: String): Bool {
    return base[base.count - 1] != b'/'
}

@platform(macos)
private func lastFailure(): Int {
    return 0 - (cErrno() as Int)
}

@platform(macos)
private func openDescriptor(path: [UInt8], flags: Int32, security: Int): Int {
    var status = 0 - interrupted
    while status == 0 - interrupted {
        let descriptor = openWithSecurity(path: path, flags: flags, security: security)
        status = if descriptor < 0 { lastFailure() } else { descriptor as Int }
    }
    return status
}

@platform(macos)
func nativeOpenRead(path: [UInt8]): Int {
    return openDescriptor(path: path, flags: closeOnExec, security: 0)
}

@platform(macos)
func nativeOpenIdentity(path: [UInt8], directory: Bool): Int {
    // O_SEARCH is O_EXEC | O_DIRECTORY on Darwin; it does not request listing access.
    if directory { return openDescriptor(path: path, flags: closeOnExec | 0x40100000, security: 0) }
    // O_NOFOLLOW | O_NONBLOCK.
    return openDescriptor(path: path, flags: closeOnExec | 0x0104, security: 0)
}

@platform(macos)
func nativeFileIdentity(handle: Int, directory: Bool): Result<FileIdentity, FileSystemError> {
    var info = zeroBuffer(count: statxBufferSize)
    if fstatP(descriptor: handle as Int32, buffer: &info) != 0 {
        return .Err(failure(code: 0 - lastFailure()))
    }

    if modeKind(mode: halfWord(bytes: info, offset: 4)) != (if directory { 1 } else { 0 }) {
        return .Err(.Other(invalidInputCode()))
    }
    return .Ok(FileIdentity(volume: hostWord(bytes: info, offset: 0) & 0xFFFFFFFF,
        low: hostWord(bytes: info, offset: 8), high: 0))
}

@platform(macos)
func nativeOpenNew(path: [UInt8]): Int {
    let security = fileSecurity()
    if security == 0 { return lastFailure() }
    let permissions: [UInt8] = [0xB6, 0x01]  // mode_t 0666; the kernel applies the umask.
    let changed = setFileSecurity(security: security, property: fileSecurityMode, value: permissions)
    if changed != 0 {
        let error = lastFailure()
        freeFileSecurity(security: security)
        return error
    }
    let descriptor = openDescriptor(path: path, flags: closeOnExec | createExclusiveWrite, security: security)
    freeFileSecurity(security: security)
    return descriptor
}

@platform(macos)
func nativeRead(handle: Int, buffer: inout [UInt8], count: Int): Int {
    var status = 0 - interrupted
    while status == 0 - interrupted {
        status = readDescriptorP(descriptor: handle as Int32, buffer: &buffer, count: count)
        if status < 0 { status = lastFailure() }
    }
    return status
}

@platform(macos)
func nativeWrite(handle: Int, buffer: [UInt8], count: Int): Int {
    var status = 0 - interrupted
    while status == 0 - interrupted {
        status = writeDescriptorP(descriptor: handle as Int32, buffer: buffer, count: count)
        if status < 0 { status = lastFailure() }
    }
    return status
}

@platform(macos)
func nativeClose(handle: Int): Int {
    if closeDescriptorP(descriptor: handle as Int32) != 0 { return lastFailure() }
    return 0
}

@platform(macos)
func nativeReplaceFile(source: [UInt8], destination: [UInt8]): Int {
    if renameP(source: source, destination: destination) != 0 { return lastFailure() }
    return 0
}

@platform(macos)
func nativeCreateDirectory(path: [UInt8]): Int {
    if mkdirP(path: path, mode: directoryMode) != 0 { return lastFailure() }
    return 0
}

@platform(macos)
func nativeRemoveFile(path: [UInt8]): Int {
    if unlinkP(path: path) != 0 { return lastFailure() }
    return 0
}

@platform(macos)
func nativeRemoveDirectory(path: [UInt8]): Int {
    let kind = nativeKind(path: path)
    if kind < 0 { return kind }
    if kind != 1 { return -20 }
    if rmdirP(path: path) != 0 { return lastFailure() }
    return 0
}

@platform(macos)
private func modeKind(mode: Int): Int {
    let format = mode & kindMask
    if format == kindFile { return 0 }
    if format == kindDirectory { return 1 }
    if format == kindSymlink { return 2 }
    return 3
}

func halfWord(bytes: [UInt8], offset: Int): Int {
    return byteToInt(value: bytes[offset]) | (byteToInt(value: bytes[offset + 1]) << 8)
}

// Kind tags: 0 file, 1 directory, 2 symlink, 3 other. The leaf is never followed.
// st_mode sits at offset 4 of the 64-bit struct stat.
@platform(macos)
func nativeKind(path: [UInt8]): Int {
    var buffer = zeroBuffer(count: statxBufferSize)
    if lstatP(path: path, buffer: &buffer) != 0 { return lastFailure() }
    return modeKind(mode: halfWord(bytes: buffer, offset: 4))
}

@platform(macos)
func nameOffset(): Int { return 21 }

@platform(macos)
func nativeDirectoryNext(directory: inout DirectoryReader): Result<String?, Int> {
    let handle = directory.handle
    var found = zeroBuffer(count: 8)
    var code = interrupted
    while code == interrupted {
        code = readdirP(directory: handle, entry: &directory.buffer, found: &found) as Int
    }
    if code != 0 { return .Err(code) }
    if hostWord(bytes: found, offset: 0) == 0 { return .Ok(nil) }
    return posixDirectoryName(bytes: directory.buffer, start: nameOffset(), end: direntBufferSize)
}

@platform(macos)
func nativeOpenDirectory(path: String, bytes: [UInt8]): Result<DirectoryReader, FileSystemError> {
    let handle = opendirP(path: bytes)
    if handle == 0 { return .Err(classifyError(code: 0 - lastFailure())) }
    return .Ok(DirectoryReader(handle: handle, state: 0, buffer: zeroBuffer(count: direntBufferSize),
        cursor: 0, limit: 0))
}

@platform(macos)
func nativeCloseDirectory(handle: Int): Int {
    if closedirP(directory: handle) != 0 { return lastFailure() }
    return 0
}
