private func projectCommand(options: CliOptions): Int {
    var resolved = options
    let project = match loadProject(options: &resolved) {
        .Ok(loaded) => loaded,
        .Err(error) => {
            return failureStatus(error: error.error, manifestPath: error.path,
                contents: error.contents, status: 1)
        },
    }
    let selected = match selectModules(project: project, options: resolved) {
        .Ok(modules) => modules,
        .Err(error) => {
            return failureStatus(error: error, manifestPath: "", contents: "", status: 2)
        },
    }
    if selected.count != 0 && resolved.compiler.count == 0 {
        let compiler = match discoverCompiler(explicit: "") {
            .Ok(path) => path,
            .Err(error) => { return failureStatus(error: error, manifestPath: "", contents: "", status: 1) },
        }
        resolved.compiler = compiler
    }
    return match executeProject(project: project, options: resolved, selected: selected) {
        .Ok(status) => status,
        .Err(error) => failureStatus(error: error, manifestPath: "", contents: "", status: 1),
    }
}

func main(args: [String]): Int {
    let options = match parseCli(args: args) {
        .Ok(parsed) => parsed,
        .Err(error) => {
            return failureStatus(error: error, manifestPath: "", contents: "", status: 2)
        },
    }
    if options.command == "--help" {
        printHelp()
        return 0
    }
    if options.command == "--version" {
        print(value: "fern 0.1.0")
        return 0
    }
    if options.command == "init" {
        return match initializeProject(options: options) {
            .Ok(status) => status,
            .Err(error) => failureStatus(error: error, manifestPath: "", contents: "", status: 1),
        }
    }
    return projectCommand(options: options)
}
