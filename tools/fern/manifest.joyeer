// All fern sources belong to the compiler-supplied fern.app module.
// This is a schema-directed TOML 1.0 profile, not a general TOML parser.
// Limits: 65536 bytes/document, 4096 bytes/string, 256 workspace members,
// and 1024 strings per module array. Arrays cannot be nested.
// Locations are zero-based byte offsets in the original manifest.

import Foundation
import System

struct ModuleSpec {
    let name: String
    let kind: String
    let output: String
    let sources: [String]
    let dependencies: [String]
    let pathDependencies: [String]
    let nativeLibraries: [String]
    let nativeBindings: Bool
    var nativeSearchPaths: [String]
    var nativeNames: [String]
    let pos: Int
}

// Keep only the input and cursor here. Borrowing this cursor does not clone
// accumulated records, and every mutation uses a supported field access.
private struct ManifestCursor {
    let input: String
    var pos: Int
}

private struct ManifestTable {
    let name: String
    let array: Bool
    let pos: Int
}

private func manifestLetter(byte: UInt8): Bool {
    return (byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
}

private func manifestDigit(byte: UInt8): Bool {
    return byte >= b'0' && byte <= b'9'
}

private func manifestFold(byte: UInt8): Int {
    let value = byteToInt(value: byte)
    if value >= 65 && value <= 90 { return value + 32 }
    return value
}

private func manifestAsciiEqual(first: String, second: String): Bool {
    if first.count != second.count { return false }
    var index = 0
    while index < first.count {
        if manifestFold(byte: first[index]) != manifestFold(byte: second[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

private func manifestDeviceName(name: String): Bool {
    if manifestAsciiEqual(first: name, second: "con") { return true }
    if manifestAsciiEqual(first: name, second: "prn") { return true }
    if manifestAsciiEqual(first: name, second: "aux") { return true }
    if manifestAsciiEqual(first: name, second: "nul") { return true }
    if manifestAsciiEqual(first: name, second: "conin$") { return true }
    if manifestAsciiEqual(first: name, second: "conout$") { return true }
    if name.count == 4 {
        let prefix = substring(text: name, start: 0, end: 3)
        let digit = name[3]
        if digit >= b'1' && digit <= b'9' {
            return manifestAsciiEqual(first: prefix, second: "com") ||
                manifestAsciiEqual(first: prefix, second: "lpt")
        }
    }
    return false
}

func validPortableName(name: String): Bool {
    if name.count == 0 || name.count > 64 { return false }
    if !manifestLetter(byte: name[0]) { return false }
    var index = 1
    while index < name.count {
        let byte = name[index]
        if !manifestLetter(byte: byte) && !manifestDigit(byte: byte) &&
            byte != b'-' && byte != b'_' {
            return false
        }
        index = index + 1
    }
    if System.isWindows() && manifestDeviceName(name: name) { return false }
    return true
}

// Match joyeer::isModuleName, not the portable output-component grammar.
// Logical identities remain case-sensitive, including on Windows.
func validModuleName(name: String): Bool {
    if name.count == 0 { return false }
    var componentStart = true
    var index = 0
    while index < name.count {
        let byte = name[index]
        if byte == b'.' {
            if componentStart { return false }
            componentStart = true
        } else {
            let head = manifestLetter(byte: byte) || byte == b'_'
            if !head && (componentStart || !manifestDigit(byte: byte)) {
                return false
            }
            componentStart = false
        }
        index = index + 1
    }
    return !componentStart
}

private func manifestRelativePath(path: String, allowParent: Bool): Bool {
    if path.count == 0 { return false }
    let windows = System.isWindows()
    if isPathSeparator(byte: path[0], windows: windows) { return false }
    // Drive-relative and drive-absolute spellings are forbidden on every host.
    if path.count >= 2 {
        if manifestLetter(byte: path[0]) && path[1] == b':' { return false }
    }
    if isPathSeparator(byte: path[path.count - 1], windows: windows) { return false }
    var start = 0
    var index = 0
    while index <= path.count {
        var boundary = index == path.count
        if index < path.count {
            let byte = path[index]
            let value = byteToInt(value: byte)
            if value == 0 { return false }
            boundary = isPathSeparator(byte: byte, windows: windows)
            if windows && !boundary {
                // Exclude ADS/device syntax and Win32 trimming aliases, which
                // could otherwise disguise a parent-traversal component.
                if value < 32 || byte == b':' || byte == b'*' || byte == b'?' ||
                    byte == b'"' || byte == b'<' || byte == b'>' || byte == b'|' {
                    return false
                }
            }
        }
        if boundary {
            let length = index - start
            let parent = length == 2 && path[start] == b'.' && path[start + 1] == b'.'
            if parent && !allowParent { return false }
            let dot = length == 1 && path[start] == b'.'
            if index == path.count && (length == 0 || (dot && !allowParent)) { return false }
            if windows && length > 0 && !dot && !parent {
                let last = path[index - 1]
                if last == b'.' || last == b' ' { return false }
                var stemEnd = start
                while stemEnd < index {
                    if path[stemEnd] == b'.' { break }
                    stemEnd = stemEnd + 1
                }
                let stem = substring(text: path, start: start, end: stemEnd)
                if manifestDeviceName(name: stem) { return false }
            }
            start = index + 1
        }
        index = index + 1
    }
    return true
}

private func manifestSourcePath(path: String): Bool {
    return manifestRelativePath(path: path, allowParent: false)
}

func validArtifactModuleName(name: String): Bool {
    return validModuleName(name: name) && manifestSourcePath(path: name)
}

func artifactModuleNamesEqual(first: String, second: String): Bool {
    if System.isWindows() { return manifestAsciiEqual(first: first, second: second) }
    return first == second
}

func manifestSourceKey(path: String): String {
    // A lexical duplicate key only. Physical aliases and Unicode filesystem
    // case folding remain the compiler's authoritative input checks.
    let windows = System.isWindows()
    let lower = "abcdefghijklmnopqrstuvwxyz"
    var key = ""
    var start = 0
    var index = 0
    while index <= path.count {
        var boundary = index == path.count
        if index < path.count { boundary = isPathSeparator(byte: path[index], windows: windows) }
        if boundary {
            let length = index - start
            let dot = length == 1 && path[start] == b'.'
            if length > 0 && !dot {
                if key.count > 0 { key = key + "/" }
                if windows {
                    var cursor = start
                    while cursor < index {
                        let byte = path[cursor]
                        let value = byteToInt(value: byte)
                        if value >= 65 && value <= 90 {
                            // value - 65 is in 0..25 by the guard above.
                            key = key + byteToString(value: lower[value - 65])
                        } else {
                            key = key + byteToString(value: byte)
                        }
                        cursor = cursor + 1
                    }
                } else {
                    key = key + substring(text: path, start: start, end: index)
                }
            }
            start = index + 1
        }
        index = index + 1
    }
    return key
}

private func manifestCurrent(p: borrowing ManifestCursor): UInt8 {
    if p.pos < 0 || p.pos >= p.input.count { return b'\0' }
    return p.input[p.pos]
}

private func manifestAdvance(p: inout ManifestCursor) {
    if p.pos >= 0 && p.pos < p.input.count { &p.pos = p.pos + 1 }
}

private func manifestHorizontal(p: inout ManifestCursor) {
    while p.pos < p.input.count {
        let byte = manifestCurrent(p: p)
        if byte != b' ' && byte != b'\t' { break }
        manifestAdvance(p: &p)
    }
}

private func manifestNewline(p: inout ManifestCursor): Result<Void, ToolError> {
    let pos = p.pos
    let byte = manifestCurrent(p: p)
    if byte == b'\n' {
        manifestAdvance(p: &p)
        return .Ok(())
    }
    if byte == b'\r' {
        manifestAdvance(p: &p)
        if p.pos < p.input.count && manifestCurrent(p: p) == b'\n' {
            manifestAdvance(p: &p)
            return .Ok(())
        }
    }
    return .Err(ToolError(message: "manifest newlines must be LF or CRLF", pos: pos))
}

private func manifestComment(p: inout ManifestCursor): Result<Void, ToolError> {
    manifestAdvance(p: &p)
    while p.pos < p.input.count {
        let byte = manifestCurrent(p: p)
        if byte == b'\n' || byte == b'\r' { break }
        let value = byteToInt(value: byte)
        if (value < 32 && byte != b'\t') || value == 127 {
            return .Err(ToolError(message: "control byte in TOML comment", pos: p.pos))
        }
        manifestAdvance(p: &p)
    }
    return .Ok(())
}

private func manifestTrivia(p: inout ManifestCursor): Result<Void, ToolError> {
    while p.pos < p.input.count {
        let byte = manifestCurrent(p: p)
        if byte == b' ' || byte == b'\t' {
            manifestAdvance(p: &p)
        } else if byte == b'#' {
            manifestComment(p: &p)?
        } else if byte == b'\n' || byte == b'\r' {
            manifestNewline(p: &p)?
        } else {
            break
        }
    }
    return .Ok(())
}

private func manifestLineEnd(p: inout ManifestCursor): Result<Void, ToolError> {
    manifestHorizontal(p: &p)
    if p.pos < p.input.count && manifestCurrent(p: p) == b'#' {
        manifestComment(p: &p)?
    }
    if p.pos == p.input.count { return .Ok(()) }
    let byte = manifestCurrent(p: p)
    if byte == b'\n' || byte == b'\r' {
        manifestNewline(p: &p)?
        return .Ok(())
    }
    return .Err(ToolError(message: "trailing input; expected comment or end of line", pos: p.pos))
}

private func manifestBare(byte: UInt8): Bool {
    return manifestLetter(byte: byte) || manifestDigit(byte: byte) ||
        byte == b'_' || byte == b'-'
}

private func manifestBareKey(p: inout ManifestCursor): Result<String, ToolError> {
    let start = p.pos
    while p.pos < p.input.count {
        if !manifestBare(byte: manifestCurrent(p: p)) { break }
        manifestAdvance(p: &p)
    }
    if p.pos == start {
        return .Err(ToolError(message: "expected bare key; quoted and dotted keys are unsupported", pos: start))
    }
    return .Ok(substring(text: p.input, start: start, end: p.pos))
}

private func manifestKey(p: inout ManifestCursor): Result<String, ToolError> {
    let key = manifestBareKey(p: &p)?
    manifestHorizontal(p: &p)
    if p.pos >= p.input.count || manifestCurrent(p: p) != b'=' {
        return .Err(ToolError(message: "expected '=' after bare key; dotted keys are unsupported", pos: p.pos))
    }
    manifestAdvance(p: &p)
    manifestHorizontal(p: &p)
    return .Ok(key)
}

private func manifestHeader(p: inout ManifestCursor, allowNative: Bool): Result<ManifestTable, ToolError> {
    let pos = p.pos
    if p.pos >= p.input.count || manifestCurrent(p: p) != b'[' {
        return .Err(ToolError(message: "expected [module] or [workspace]", pos: pos))
    }
    manifestAdvance(p: &p)
    var array = false
    if p.pos < p.input.count && manifestCurrent(p: p) == b'[' {
        array = true
        manifestAdvance(p: &p)
    }
    manifestHorizontal(p: &p)
    var name = manifestBareKey(p: &p)?
    manifestHorizontal(p: &p)
    if allowNative && !array && name == "native" && p.pos < p.input.count && manifestCurrent(p: p) == b'.' {
        manifestAdvance(p: &p)
        manifestHorizontal(p: &p)
        name = "native." + manifestBareKey(p: &p)?
        manifestHorizontal(p: &p)
    }
    if p.pos >= p.input.count || manifestCurrent(p: p) != b']' {
        return .Err(ToolError(message: "expected closing table bracket; dotted tables are unsupported", pos: p.pos))
    }
    manifestAdvance(p: &p)
    if array {
        if p.pos >= p.input.count || manifestCurrent(p: p) != b']' {
            return .Err(ToolError(message: "expected ']]' for array of tables", pos: p.pos))
        }
        manifestAdvance(p: &p)
    }
    manifestLineEnd(p: &p)?
    return .Ok(ManifestTable(name: name, array: array, pos: pos))
}

private func manifestHex(byte: UInt8): Int {
    if manifestDigit(byte: byte) {
        return byteToInt(value: byte) - byteToInt(value: b'0')
    }
    if byte >= b'a' && byte <= b'f' {
        return byteToInt(value: byte) - byteToInt(value: b'a') + 10
    }
    if byte >= b'A' && byte <= b'F' {
        return byteToInt(value: byte) - byteToInt(value: b'A') + 10
    }
    return -1
}

private func manifestSchemaValue(token: String, expected: Int): Bool {
    let formatted = decimalString(value: expected)
    if token == formatted || token == "+" + formatted { return true }
    if token.count < 3 { return false }
    if token[0] != b'0' { return false }
    var base = 0
    if token[1] == b'x' { base = 16 }
    if token[1] == b'o' { base = 8 }
    if token[1] == b'b' { base = 2 }
    if base == 0 { return false }
    var index = 2
    var value = 0
    var previousDigit = false
    while index < token.count {
        let byte = token[index]
        if byte == b'_' {
            if !previousDigit { return false }
            previousDigit = false
        } else {
            let digit = manifestHex(byte: byte)
            if digit < 0 || digit >= base { return false }
            if value > expected / base { return false }
            value = value * base + digit
            if value > expected { return false }
            previousDigit = true
        }
        index = index + 1
    }
    return previousDigit && value == expected
}

private func manifestSchema(p: inout ManifestCursor, expected: Int): Result<Void, ToolError> {
    let pos = p.pos
    while p.pos < p.input.count {
        let byte = manifestCurrent(p: p)
        if byte == b' ' || byte == b'\t' || byte == b'\n' || byte == b'\r' || byte == b'#' {
            break
        }
        manifestAdvance(p: &p)
    }
    let token = substring(text: p.input, start: pos, end: p.pos)
    if !manifestSchemaValue(token: token, expected: expected) {
        return .Err(ToolError(message: "schema-version must be the TOML integer " +
            decimalString(value: expected), pos: pos))
    }
    return .Ok(())
}

private func manifestByte(value: Int, pos: Int): Result<String, ToolError> {
    // Joyeer has no Int-to-UInt8 conversion. The ASCII lookup deliberately
    // contains raw C0 bytes (except the supported Joyeer newline escapes).
    // The other lookups are valid UTF-8 source strings: select continuation
    // bytes or leading bytes rather than assuming Unicode escape syntax in
    // Joyeer itself. All computed indexes are checked before subscripting.
    if value >= 0 && value < 128 {
        let ascii = "\0\t\n\r !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
        if value < ascii.count {
            return .Ok(byteToString(value: ascii[value]))
        }
    }
    if value >= 128 && value <= 191 {
        let continuation = "ĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĨĩĪīĬĭĮįİıĲĳĴĵĶķĸĹĺĻļĽľĿ"
        let index = (value - 128) * 2 + 1
        if index < continuation.count {
            return .Ok(byteToString(value: continuation[index]))
        }
    }
    if value >= 194 && value <= 223 {
        let leading = "ÀĀŀƀǀȀɀʀˀ̀̀΀πЀрҀӀԀՀր׀؀ـڀۀ܀݀ހ߀"
        let index = (value - 194) * 2
        if index < leading.count {
            return .Ok(byteToString(value: leading[index]))
        }
    }
    if value >= 224 && value <= 239 {
        let leading = "ࠀက 　䀀倀怀瀀耀退ꀀ뀀쀀퀀"
        let index = (value - 224) * 3
        if index < leading.count {
            return .Ok(byteToString(value: leading[index]))
        }
    }
    if value >= 240 && value <= 244 {
        let leading = "𐀀񀀀򀀀󀀀􀀀"
        let index = (value - 240) * 4
        if index < leading.count {
            return .Ok(byteToString(value: leading[index]))
        }
    }
    return .Err(ToolError(message: "invalid Unicode encoding byte", pos: pos))
}

private func manifestScalar(value: Int, pos: Int): Result<String, ToolError> {
    if value < 0 || value > 1114111 || (value >= 55296 && value <= 57343) {
        return .Err(ToolError(message: "Unicode escape is not a Unicode scalar", pos: pos))
    }
    if value < 128 { return manifestByte(value: value, pos: pos) }
    if value < 2048 {
        let first = manifestByte(value: 192 + value / 64, pos: pos)?
        let second = manifestByte(value: 128 + value % 64, pos: pos)?
        return .Ok(first + second)
    }
    if value < 65536 {
        let first = manifestByte(value: 224 + value / 4096, pos: pos)?
        let second = manifestByte(value: 128 + (value / 64) % 64, pos: pos)?
        let third = manifestByte(value: 128 + value % 64, pos: pos)?
        return .Ok(first + second + third)
    }
    let first = manifestByte(value: 240 + value / 262144, pos: pos)?
    let second = manifestByte(value: 128 + (value / 4096) % 64, pos: pos)?
    let third = manifestByte(value: 128 + (value / 64) % 64, pos: pos)?
    let fourth = manifestByte(value: 128 + value % 64, pos: pos)?
    return .Ok(first + second + third + fourth)
}

private func manifestEscape(p: inout ManifestCursor): Result<String, ToolError> {
    let pos = p.pos
    manifestAdvance(p: &p)
    if p.pos >= p.input.count {
        return .Err(ToolError(message: "unterminated basic string escape", pos: pos))
    }
    let byte = manifestCurrent(p: p)
    manifestAdvance(p: &p)
    if byte == b'"' { return .Ok("\"") }
    if byte == b'\\' { return .Ok("\\") }
    if byte == b'b' { return manifestByte(value: 8, pos: pos) }
    if byte == b't' { return .Ok("\t") }
    if byte == b'n' { return .Ok("\n") }
    if byte == b'f' { return manifestByte(value: 12, pos: pos) }
    if byte == b'r' { return .Ok("\r") }
    var digits = 0
    if byte == b'u' { digits = 4 }
    if byte == b'U' { digits = 8 }
    if digits == 0 {
        return .Err(ToolError(message: "unsupported TOML basic string escape", pos: pos))
    }
    var value = 0
    var index = 0
    while index < digits {
        if p.pos >= p.input.count {
            return .Err(ToolError(message: "incomplete Unicode escape", pos: pos))
        }
        let digit = manifestHex(byte: manifestCurrent(p: p))
        if digit < 0 {
            return .Err(ToolError(message: "expected hexadecimal Unicode escape digit", pos: p.pos))
        }
        // At most eight hex digits: the maximum is 4294967295, within Int.
        value = value * 16 + digit
        manifestAdvance(p: &p)
        index = index + 1
    }
    return manifestScalar(value: value, pos: pos)
}

private func manifestString(p: inout ManifestCursor): Result<String, ToolError> {
    let pos = p.pos
    if p.pos >= p.input.count {
        return .Err(ToolError(message: "expected single-line string", pos: pos))
    }
    let quote = manifestCurrent(p: p)
    if quote != b'"' && quote != b'\'' {
        return .Err(ToolError(message: "expected basic or literal single-line string", pos: pos))
    }
    manifestAdvance(p: &p)
    if p.input.count - p.pos >= 2 {
        if p.input[p.pos] == quote && p.input[p.pos + 1] == quote {
            return .Err(ToolError(message: "multiline strings are unsupported", pos: pos))
        }
    }
    var text = ""
    var start = p.pos
    while p.pos < p.input.count {
        let byte = manifestCurrent(p: p)
        if byte == quote {
            let tail = substring(text: p.input, start: start, end: p.pos)
            manifestAdvance(p: &p)
            return .Ok(text + tail)
        }
        if byte == b'\\' && quote == b'"' {
            text = text + substring(text: p.input, start: start, end: p.pos)
            let escaped = manifestEscape(p: &p)?
            if text.count + escaped.count > 4096 {
                return .Err(ToolError(message: "decoded string exceeds 4096 bytes", pos: pos))
            }
            text = text + escaped
            start = p.pos
        } else {
            let value = byteToInt(value: byte)
            if (value < 32 && byte != b'\t') || value == 127 {
                return .Err(ToolError(message: "unescaped control byte or newline in single-line string", pos: p.pos))
            }
            if text.count + p.pos - start >= 4096 {
                return .Err(ToolError(message: "decoded string exceeds 4096 bytes", pos: pos))
            }
            manifestAdvance(p: &p)
        }
    }
    return .Err(ToolError(message: "unterminated single-line string", pos: pos))
}

private func manifestNativeName(name: String): Bool {
    if name.count == 0 { return false }
    if !manifestLetter(byte: name[0]) && !manifestDigit(byte: name[0]) { return false }
    var index = 1
    while index < name.count {
        let byte = name[index]
        if !manifestLetter(byte: byte) && !manifestDigit(byte: byte) &&
            byte != b'_' && byte != b'.' && byte != b'+' && byte != b'-' { return false }
        index = index + 1
    }
    return true
}

private func manifestArray(p: inout ManifestCursor, category: String): Result<[String], ToolError> {
    let pos = p.pos
    if p.pos >= p.input.count || manifestCurrent(p: p) != b'[' {
        return .Err(ToolError(message: "expected array of strings", pos: pos))
    }
    manifestAdvance(p: &p)
    var values: [String] = []
    var keys: [String] = []
    manifestTrivia(p: &p)?
    while p.pos < p.input.count {
        if manifestCurrent(p: p) == b']' {
            manifestAdvance(p: &p)
            return .Ok(values)
        }
        let itemPos = p.pos
        if category == "members" && values.count >= 256 {
            return .Err(ToolError(message: "workspace exceeds 256 members", pos: itemPos))
        }
        if values.count >= 1024 {
            return .Err(ToolError(message: "array exceeds 1024 entries", pos: itemPos))
        }
        let value = manifestString(p: &p)?
        var key = value
        if category == "sources" || category == "native-libraries" {
            if !manifestSourcePath(path: value) {
                var description = "source"
                if category == "native-libraries" { description = "native library" }
                return .Err(ToolError(message: description + " must be a relative file path without parent traversal: " + value, pos: itemPos))
            }
            key = manifestSourceKey(path: value)
        } else if category == "path-dependencies" {
            if !manifestRelativePath(path: value, allowParent: true) {
                return .Err(ToolError(message: "path dependency must be a relative directory: " + value, pos: itemPos))
            }
        } else if category == "native-search" {
            if value != "." && !manifestSourcePath(path: value) {
                return .Err(ToolError(message: "native search path must be a relative directory without parent traversal: " + value,
                    pos: itemPos))
            }
            key = manifestSourceKey(path: value)
        } else if category == "native-libs" {
            if !manifestNativeName(name: value) {
                return .Err(ToolError(message: "invalid logical native library name: " + value, pos: itemPos))
            }
        } else if category == "members" {
            if value != "." && !manifestSourcePath(path: value) {
                return .Err(ToolError(message: "workspace member must be a relative directory without parent traversal: " + value, pos: itemPos))
            }
            key = manifestSourceKey(path: value)
        } else {
            if !validModuleName(name: value) {
                return .Err(ToolError(message: "invalid dependency logical module name: " + value, pos: itemPos))
            }
        }
        var index = 0
        while index < keys.count {
            if keys[index] == key {
                return .Err(ToolError(message: "repeated array entry: " + value, pos: itemPos))
            }
            index = index + 1
        }
        &values.append(element: value)
        &keys.append(element: key)
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count { break }
        let delimiter = manifestCurrent(p: p)
        if delimiter == b']' {
            manifestAdvance(p: &p)
            return .Ok(values)
        }
        if delimiter != b',' {
            return .Err(ToolError(message: "expected ',' or ']' after array string", pos: p.pos))
        }
        manifestAdvance(p: &p)
        manifestTrivia(p: &p)?
        // A following ']' is the supported trailing-comma form. Any other
        // value must start a string, so nested/mixed arrays are rejected.
    }
    return .Err(ToolError(message: "unterminated string array", pos: pos))
}

private func manifestModuleBody(p: inout ManifestCursor, pos: Int): Result<ModuleSpec, ToolError> {
    var name = ""
    var kind = ""
    var output = ""
    var sources: [String] = []
    var dependencies: [String] = []
    var pathDependencies: [String] = []
    var nativeLibraries: [String] = []
    var nativeBindings = false
    var nativeSearchPaths: [String] = []
    var nativeNames: [String] = []
    var hasName = false
    var hasKind = false
    var hasOutput = false
    var hasSources = false
    var hasDependencies = false
    var hasPathDependencies = false
    var hasNativeLibraries = false
    var hasNativeBindings = false
    var hasNativeSearch = false
    var hasNativeNames = false
    while p.pos < p.input.count {
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count || manifestCurrent(p: p) == b'[' { break }
        let keyPos = p.pos
        let key = manifestKey(p: &p)?
        let valuePos = p.pos
        if key == "name" {
            if hasName { return .Err(ToolError(message: "duplicate module.name", pos: keyPos)) }
            name = manifestString(p: &p)?
            if !validModuleName(name: name) {
                return .Err(ToolError(message: "invalid logical module name: " + name, pos: valuePos))
            }
            hasName = true
        } else if key == "kind" {
            if hasKind { return .Err(ToolError(message: "duplicate module.kind", pos: keyPos)) }
            kind = manifestString(p: &p)?
            if kind != "source" && kind != "bin" && kind != "test" {
                return .Err(ToolError(message: "module.kind must be source, bin, or test", pos: valuePos))
            }
            hasKind = true
        } else if key == "output" {
            if hasOutput { return .Err(ToolError(message: "duplicate module.output", pos: keyPos)) }
            output = manifestString(p: &p)?
            if !validPortableName(name: output) {
                return .Err(ToolError(message: "module.output must be a portable ASCII name of 1..64 bytes, not a reserved device name", pos: valuePos))
            }
            hasOutput = true
        } else if key == "sources" {
            if hasSources { return .Err(ToolError(message: "duplicate module.sources", pos: keyPos)) }
            sources = manifestArray(p: &p, category: "sources")?
            if sources.count == 0 {
                return .Err(ToolError(message: "module.sources must not be empty", pos: valuePos))
            }
            hasSources = true
        } else if key == "dependencies" {
            if hasDependencies { return .Err(ToolError(message: "duplicate module.dependencies", pos: keyPos)) }
            dependencies = manifestArray(p: &p, category: "dependencies")?
            hasDependencies = true
        } else if key == "path-dependencies" {
            if hasPathDependencies { return .Err(ToolError(message: "duplicate module.path-dependencies", pos: keyPos)) }
            pathDependencies = manifestArray(p: &p, category: "path-dependencies")?
            hasPathDependencies = true
        } else if key == "native-libraries" {
            if hasNativeLibraries { return .Err(ToolError(message: "duplicate module.native-libraries", pos: keyPos)) }
            nativeLibraries = manifestArray(p: &p, category: "native-libraries")?
            hasNativeLibraries = true
        } else if key == "native-search" {
            if hasNativeSearch { return .Err(ToolError(message: "duplicate module.native-search", pos: keyPos)) }
            nativeSearchPaths = manifestArray(p: &p, category: "native-search")?
            hasNativeSearch = true
        } else if key == "native-libs" {
            if hasNativeNames { return .Err(ToolError(message: "duplicate module.native-libs", pos: keyPos)) }
            nativeNames = manifestArray(p: &p, category: "native-libs")?
            hasNativeNames = true
        } else if key == "native-bindings" {
            if hasNativeBindings { return .Err(ToolError(message: "duplicate module.native-bindings", pos: keyPos)) }
            if substring(text: p.input, start: p.pos, end: p.pos + 4) == "true" {
                nativeBindings = true
                &p.pos = p.pos + 4
            } else if substring(text: p.input, start: p.pos, end: p.pos + 5) == "false" {
                &p.pos = p.pos + 5
            } else {
                return .Err(ToolError(message: "module.native-bindings must be true or false", pos: valuePos))
            }
            hasNativeBindings = true
        } else {
            return .Err(ToolError(message: "unknown module key: " + key, pos: keyPos))
        }
        manifestLineEnd(p: &p)?
    }
    if !hasName { return .Err(ToolError(message: "missing module.name", pos: pos)) }
    if !hasKind { return .Err(ToolError(message: "missing module.kind", pos: pos)) }
    if !hasSources { return .Err(ToolError(message: "missing module.sources", pos: pos)) }
    if !hasDependencies { return .Err(ToolError(message: "missing module.dependencies", pos: pos)) }
    if kind == "source" && hasOutput {
        return .Err(ToolError(message: "source modules do not declare an output artifact", pos: pos))
    }
    if kind == "source" && (hasNativeSearch || hasNativeNames) {
        return .Err(ToolError(message: "source modules do not declare native link names or search directories", pos: pos))
    }
    if kind != "source" && !hasOutput {
        return .Err(ToolError(message: "bin/test modules require module.output", pos: pos))
    }
    if kind != "source" && !validArtifactModuleName(name: name) {
        return .Err(ToolError(message: "bin/test module name must also be a valid artifact-directory component", pos: pos))
    }
    return .Ok(ModuleSpec(name: name, kind: kind, output: output,
        sources: sources, dependencies: dependencies, pathDependencies: pathDependencies, nativeLibraries: nativeLibraries,
        nativeBindings: nativeBindings, nativeSearchPaths: nativeSearchPaths, nativeNames: nativeNames, pos: pos))
}

@platform(windows)
private func nativePlatformTable(): String { return "native.windows" }

@platform(linux)
private func nativePlatformTable(): String { return "native.linux" }

@platform(macos)
private func nativePlatformTable(): String { return "native.macos" }

private func manifestNativeTable(p: inout ManifestCursor, spec: inout ModuleSpec, active: Bool): Result<Void, ToolError> {
    var hasSearch = false
    var hasNames = false
    while true {
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count || manifestCurrent(p: p) == b'[' { return .Ok(()) }
        let keyPos = p.pos
        let key = manifestKey(p: &p)?
        if key == "libs" {
            if hasNames { return .Err(ToolError(message: "duplicate native table libs", pos: keyPos)) }
            let names = manifestArray(p: &p, category: "native-libs")?
            if active {
                for name in names { &spec.nativeNames.append(element: name) }
            }
            hasNames = true
        } else if key == "search" {
            if hasSearch { return .Err(ToolError(message: "duplicate native table search", pos: keyPos)) }
            let paths = manifestArray(p: &p, category: "native-search")?
            if active {
                for path in paths { &spec.nativeSearchPaths.append(element: path) }
            }
            hasSearch = true
        } else {
            return .Err(ToolError(message: "unknown native platform key: " + key, pos: keyPos))
        }
        manifestLineEnd(p: &p)?
    }
    return .Ok(())
}

private func manifestWorkspaceBody(p: inout ManifestCursor, pos: Int): Result<[String], ToolError> {
    var members: [String] = []
    var hasMembers = false
    while p.pos < p.input.count {
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count || manifestCurrent(p: p) == b'[' { break }
        let keyPos = p.pos
        let key = manifestKey(p: &p)?
        if key == "members" {
            if hasMembers { return .Err(ToolError(message: "duplicate workspace.members", pos: keyPos)) }
            members = manifestArray(p: &p, category: "members")?
            if members.count == 0 {
                return .Err(ToolError(message: "workspace.members must not be empty", pos: keyPos))
            }
            hasMembers = true
        } else {
            return .Err(ToolError(message: "unknown workspace key: " + key, pos: keyPos))
        }
        manifestLineEnd(p: &p)?
    }
    if !hasMembers { return .Err(ToolError(message: "missing workspace.members", pos: pos)) }
    return .Ok(members)
}

private func manifestInput(contents: String): Result<Void, ToolError> {
    if contents.count > 65536 {
        return .Err(ToolError(message: "manifest exceeds 65536 bytes", pos: 65536))
    }
    if !isValidUtf8(text: contents) {
        return .Err(ToolError(message: "manifest contents must be valid UTF-8", pos: 0))
    }
    return .Ok(())
}

private func manifestPrefix(p: inout ManifestCursor, expected: Int): Result<Void, ToolError> {
    var hasSchema = false
    // TOML keys following a table belong to that table. Root schema keys
    // cannot resume after any header, even after a blank line.
    while p.pos < p.input.count {
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count || manifestCurrent(p: p) == b'[' { break }
        let keyPos = p.pos
        let key = manifestKey(p: &p)?
        if key != "schema-version" {
            return .Err(ToolError(message: "unknown root key: " + key, pos: keyPos))
        }
        if hasSchema {
            return .Err(ToolError(message: "duplicate schema-version", pos: keyPos))
        }
        manifestSchema(p: &p, expected: expected)?
        manifestLineEnd(p: &p)?
        hasSchema = true
    }
    if !hasSchema {
        return .Err(ToolError(message: "missing root schema-version before tables", pos: p.pos))
    }
    return .Ok(())
}

func parseManifest(contents: String): Result<ModuleSpec, ToolError> {
    manifestInput(contents: contents)?
    var p = ManifestCursor(input: contents, pos: 0)
    manifestPrefix(p: &p, expected: 1)?
    if p.pos >= contents.count { return .Err(ToolError(message: "missing [module] table", pos: p.pos)) }
    let table = manifestHeader(p: &p, allowNative: false)?
    if table.name != "module" || table.array {
        return .Err(ToolError(message: "one project.toml defines one [module]; migrate earlier [package]/[[modules]]/[[targets]] projects to workspace.toml", pos: table.pos))
    }
    var spec = manifestModuleBody(p: &p, pos: table.pos)?
    var platforms: [String] = []
    while p.pos < contents.count {
        manifestTrivia(p: &p)?
        if p.pos == contents.count { break }
        let platform = manifestHeader(p: &p, allowNative: true)?
        if platform.name == "module" {
            return .Err(ToolError(message: "only one [module] table is allowed; use workspace.toml for multiple modules", pos: platform.pos))
        }
        if platform.array || (platform.name != "native.windows" && platform.name != "native.linux" &&
            platform.name != "native.macos") {
            return .Err(ToolError(message: "unknown native platform table: " + platform.name, pos: platform.pos))
        }
        if spec.kind == "source" {
            return .Err(ToolError(message: "source modules do not declare native link names or search directories", pos: platform.pos))
        }
        for earlier in platforms {
            if earlier == platform.name {
                return .Err(ToolError(message: "duplicate native platform table: " + platform.name, pos: platform.pos))
            }
        }
        &platforms.append(element: platform.name)
        manifestNativeTable(p: &p, spec: &spec, active: platform.name == nativePlatformTable())?
    }
    return .Ok(spec)
}

// Reads <compiler directory>/lib/index.toml, the list of standard modules that
// ship with a toolchain. Only the module names matter to fern; the compiler
// validates the build stamp and resolves the modules.
func parseStandardIndex(contents: String): Result<[String], ToolError> {
    manifestInput(contents: contents)?
    var p = ManifestCursor(input: contents, pos: 0)
    var modules: [String] = []
    var hasSchema = false
    var hasModules = false
    while p.pos < p.input.count {
        manifestTrivia(p: &p)?
        if p.pos >= p.input.count { break }
        let keyPos = p.pos
        let key = manifestKey(p: &p)?
        if key == "schema-version" {
            if hasSchema { return .Err(ToolError(message: "duplicate schema-version", pos: keyPos)) }
            manifestSchema(p: &p, expected: 1)?
            hasSchema = true
        } else if key == "compiler-version" || key == "target" || key == "configuration" {
            let text = manifestString(p: &p)?
            if text.count == 0 { return .Err(ToolError(message: "empty " + key, pos: keyPos)) }
        } else if key == "modules" {
            if hasModules { return .Err(ToolError(message: "duplicate modules", pos: keyPos)) }
            modules = manifestArray(p: &p, category: "modules")?
            hasModules = true
        } else {
            return .Err(ToolError(message: "unknown index key: " + key, pos: keyPos))
        }
        manifestLineEnd(p: &p)?
    }
    if !hasSchema { return .Err(ToolError(message: "missing schema-version", pos: 0)) }
    if !hasModules { return .Err(ToolError(message: "missing modules", pos: 0)) }
    var index = 0
    while index < modules.count {
        if !validModuleName(name: modules[index]) {
            return .Err(ToolError(message: "invalid standard module name: " + modules[index], pos: 0))
        }
        index = index + 1
    }
    return .Ok(modules)
}

func parseWorkspace(contents: String): Result<[String], ToolError> {
    manifestInput(contents: contents)?
    var p = ManifestCursor(input: contents, pos: 0)
    manifestPrefix(p: &p, expected: 1)?
    if p.pos >= contents.count { return .Err(ToolError(message: "missing [workspace] table", pos: p.pos)) }
    let table = manifestHeader(p: &p, allowNative: false)?
    if table.name != "workspace" || table.array {
        return .Err(ToolError(message: "workspace.toml permits only [workspace]", pos: table.pos))
    }
    let members = manifestWorkspaceBody(p: &p, pos: table.pos)?
    manifestTrivia(p: &p)?
    if p.pos != contents.count {
        return .Err(ToolError(message: "only one [workspace] table is allowed per file; list a nested workspace's directory as a member", pos: p.pos))
    }
    return .Ok(members)
}