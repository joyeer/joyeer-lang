import System

struct ProjectModule {
    let spec: ModuleSpec
    let directory: String
    let path: String
    let dependencyIndexes: [Int]
}

struct Project {
    let modules: [ProjectModule]
    let rootCount: Int
    let directory: String
}

struct ProjectError {
    let error: ToolError
    let path: String
    let contents: String
}

// Original text is needed only until cross-manifest validation finishes.
private struct LoadedModule {
    let spec: ModuleSpec
    let identity: FileIdentity
    let directory: String
    let path: String
    let contents: String
}

private struct GraphError {
    let moduleIndex: Int
    let message: String
}

private func requireRegularManifest(path: String): Result<Void, ToolError> {
    let regular = match fileKind(path: path) {
        .Ok(kind) => match kind {
            .File => true,
            .Directory => false,
            .Symlink => false,
            .Other => false,
        },
        .Err(error) => {
            return .Err(ToolError(message: "cannot inspect manifest '" + path +
                "': " + fileSystemMessage(error: error), pos: -1))
        },
    }
    if !regular {
        return .Err(ToolError(message: "manifest must be an ordinary regular file: " + path, pos: -1))
    }
    return .Ok(())
}

private func readManifest(path: String): Result<String, ToolError> {
    requireRegularManifest(path: path)?
    // Classification and reading are separate host operations, not confinement.
    return match readFilePrefix(path: path, maximumBytes: 65537) {
        .Ok(contents) => .Ok(contents),
        .Err(error) => .Err(ToolError(message: "cannot read manifest '" + path +
            "': " + fileSystemMessage(error: error), pos: -1)),
    }
}

private func projectDocument(path: String): Result<String, ProjectError> {
    return match readManifest(path: path) {
        .Ok(contents) => .Ok(contents),
        .Err(error) => .Err(ProjectError(error: error, path: path, contents: "")),
    }
}

private func projectModule(path: String, directory: String): Result<LoadedModule, ProjectError> {
    let document = identifiedManifest(path: path)?
    return parseProjectModule(path: path, directory: directory, document: document)
}

private func identifiedManifest(path: String): Result<IdentifiedFilePrefix, ProjectError> {
    match requireRegularManifest(path: path) {
        .Ok(_) => {},
        .Err(error) => { return .Err(ProjectError(error: error, path: path, contents: "")) },
    }
    return match readIdentifiedFilePrefix(path: path, maximumBytes: 65537) {
        .Ok(document) => .Ok(document),
        .Err(error) => .Err(ProjectError(error: ToolError(message: "cannot read ordinary manifest '" +
            path + "': " + fileSystemMessage(error: error), pos: -1), path: path, contents: "")),
    }
}

private func parseProjectModule(path: String, directory: String,
    document: borrowing IdentifiedFilePrefix): Result<LoadedModule, ProjectError> {
    return match parseManifest(contents: document.contents) {
        .Ok(spec) => .Ok(LoadedModule(spec: spec, identity: document.identity,
            directory: directory, path: path, contents: document.contents)),
        .Err(error) => .Err(ProjectError(error: error, path: path, contents: document.contents)),
    }
}

private func projectJoin(base: String, path: String): Result<String, ProjectError> {
    return match toolJoin(base: base, path: path) {
        .Ok(joined) => .Ok(joined),
        .Err(error) => .Err(ProjectError(error: error, path: "", contents: "")),
    }
}

private func projectModuleIndex(modules: borrowing [LoadedModule], name: String): Int {
    var index = 0
    while index < modules.count {
        if modules[index].spec.name == name { return index }
        index = index + 1
    }
    return -1
}

private func moduleIdentityIndex(modules: borrowing [LoadedModule], identity: FileIdentity): Int {
    var index = 0
    while index < modules.count {
        if modules[index].identity == identity { return index }
        index = index + 1
    }
    return -1
}

private func sourceDirectoryIdentity(directory: String, manifest: String): Result<FileIdentity, ProjectError> {
    return match directoryIdentity(path: directory) {
        .Ok(identity) => .Ok(identity),
        .Err(error) => .Err(ProjectError(error: ToolError(message: "cannot identify source directory '" +
            directory + "': " + fileSystemMessage(error: error), pos: -1), path: manifest, contents: "")),
    }
}

@platform(windows)
private func dependencyDirectory(base: String, relative: String): Result<String, ProjectError> {
    let path = projectJoin(base: base, path: relative)?
    return match normalizedAbsolutePath(path: path) {
        .Ok(directory) => .Ok(directory),
        .Err(error) => .Err(ProjectError(error: ToolError(message: "cannot resolve dependency directory '" +
            path + "': " + fileSystemMessage(error: error), pos: -1), path: path, contents: "")),
    }
}

@platform(posix)
private func dependencyDirectory(base: String, relative: String): Result<String, ProjectError> {
    return projectJoin(base: base, path: relative)
}

private func containsEdge(edges: borrowing [Int], destination: Int): Bool {
    for previous in edges {
        if previous == destination { return true }
    }
    return false
}

private func loadPathDependencies(loaded: inout [LoadedModule]): Result<[[Int]], ProjectError> {
    var edges: [[Int]] = []
    var owner = 0
    var probes = 0
    while owner < loaded.count {
        var direct: [Int] = []
        let paths = loaded[owner].spec.pathDependencies
        let base = loaded[owner].directory
        for relative in paths {
            if probes >= 4096 {
                return .Err(ProjectError(error: ToolError(message: "project exceeds 4096 path dependency references",
                    pos: loaded[owner].spec.pos), path: loaded[owner].path, contents: loaded[owner].contents))
            }
            probes = probes + 1
            let directory = dependencyDirectory(base: base, relative: relative)?
            let path = projectJoin(base: directory, path: "project.toml")?
            let document = identifiedManifest(path: path)?
            var destination = moduleIdentityIndex(modules: loaded, identity: document.identity)
            if destination >= 0 {
                let earlier = loaded[destination].path
                let existingDirectory = loaded[destination].directory
                if existingDirectory != directory {
                    let first = sourceDirectoryIdentity(directory: existingDirectory, manifest: earlier)?
                    let second = sourceDirectoryIdentity(directory: directory, manifest: path)?
                    if first != second {
                        return .Err(ProjectError(error: ToolError(
                            message: "same manifest has different source directories: '" + earlier + "' and '" + path + "'",
                            pos: -1), path: path, contents: ""))
                    }
                }
            } else {
                if loaded.count >= 256 {
                    return .Err(ProjectError(error: ToolError(message: "project exceeds 256 modules at '" + path + "'",
                        pos: loaded[owner].spec.pos), path: loaded[owner].path, contents: loaded[owner].contents))
                }
                let module = parseProjectModule(path: path, directory: directory, document: document)?
                destination = loaded.count
                &loaded.append(element: module)
            }
            if loaded[destination].spec.kind != "source" {
                return .Err(ProjectError(error: ToolError(message: "path dependency must name a source module: " + path,
                    pos: loaded[owner].spec.pos), path: loaded[owner].path, contents: loaded[owner].contents))
            }
            if !containsEdge(edges: direct, destination: destination) { &direct.append(element: destination) }
        }
        &edges.append(element: direct)
        owner = owner + 1
    }
    return .Ok(edges)
}

private func projectIsStandard(standard: borrowing [String], name: String): Bool {
    var index = 0
    while index < standard.count {
        if standard[index] == name { return true }
        index = index + 1
    }
    return false
}

@platform(windows)
private func compilerIndexPath(compiler: String): Result<String, ProjectError> {
    return .Ok(compiler)
}

@platform(posix)
private func compilerIndexPath(compiler: String): Result<String, ProjectError> {
    var path = compiler
    var traversed = 0
    while true {
        match fileKind(path: path) {
            .Ok(.Symlink) => {},
            .Ok(_) => { return .Ok(path) },
            .Err(.NotFound(_)) => { return .Ok(path) },
            .Err(error) => {
                return .Err(ProjectError(error: ToolError(message: "cannot inspect compiler '" + path +
                    "': " + fileSystemMessage(error: error), pos: -1), path: path, contents: ""))
            },
        }
        if traversed >= 40 {
            return .Err(ProjectError(error: ToolError(message: "too many links resolving compiler '" +
                compiler + "'", pos: -1), path: compiler, contents: ""))
        }
        let destination = match readSymbolicLink(path: path) {
            .Ok(value) => value,
            .Err(error) => {
                return .Err(ProjectError(error: ToolError(message: "cannot read compiler link '" + path +
                    "': " + fileSystemMessage(error: error), pos: -1), path: path, contents: ""))
            },
        }
        path = projectJoin(base: pathDirectory(path: path, windows: false), path: destination)?
        traversed = traversed + 1
    }
    return .Ok(path)
}

// Standard modules ship with the compiler and are resolved by it, so they
// contribute no workspace edge and never appear in the loaded project. A
// compiler without lib/index.toml has no standard modules.
private func projectStandardModules(compiler: String): Result<[String], ProjectError> {
    let executable = compilerIndexPath(compiler: compiler)?
    let directory = pathDirectory(path: executable, windows: System.isWindows())
    let libraryDirectory = projectJoin(base: directory, path: "lib")?
    let path = projectJoin(base: libraryDirectory, path: "index.toml")?
    match fileKind(path: path) {
        .Ok(.File) => {},
        .Err(.NotFound(_)) => { return .Ok([]) },
        .Err(.NotDirectory(_)) => { return .Ok([]) },
        .Ok(_) => {
            return .Err(ProjectError(error: ToolError(message: "standard module index must be an ordinary file: " +
                path, pos: -1), path: path, contents: ""))
        },
        .Err(error) => {
            return .Err(ProjectError(error: ToolError(message: "cannot inspect standard module index '" + path +
                "': " + fileSystemMessage(error: error), pos: -1), path: path, contents: ""))
        },
    }
    let contents = projectDocument(path: path)?
    return match parseStandardIndex(contents: contents) {
        .Ok(names) => .Ok(names),
        .Err(error) => .Err(ProjectError(error: error, path: path, contents: contents)),
    }
}

private func projectModuleEdges(spec: borrowing ModuleSpec, modules: borrowing [LoadedModule],
    standard: borrowing [String], paths: [Int], owner: Int): Result<[Int], GraphError> {
    var edges = paths
    var index = 0
    while index < spec.dependencies.count {
        let name = spec.dependencies[index]
        let destination = projectModuleIndex(modules: modules, name: name)
        if destination < 0 && !projectIsStandard(standard: standard, name: name) {
            return .Err(GraphError(moduleIndex: owner, message: "module '" + spec.name +
                "' has unknown dependency '" + name + "' in the loaded project"))
        }
        if destination >= 0 && !containsEdge(edges: edges, destination: destination) {
            &edges.append(element: destination)
        }
        index = index + 1
    }
    return .Ok(edges)
}

private func needsStandardModules(modules: borrowing [LoadedModule]): Bool {
    var index = 0
    while index < modules.count {
        for dependency in modules[index].spec.dependencies {
            if projectModuleIndex(modules: modules, name: dependency) < 0 { return true }
        }
        index = index + 1
    }
    return false
}

private func projectGraph(modules: borrowing [LoadedModule], standard: borrowing [String],
    pathEdges: borrowing [[Int]]): Result<[[Int]], GraphError> {
    var index = 0
    while index < modules.count {
        let name = modules[index].spec.name
        let first = projectModuleIndex(modules: modules, name: name)
        if first != index {
            return .Err(GraphError(moduleIndex: index, message: "duplicate logical module name: " + name +
                " in '" + modules[first].path + "' and '" + modules[index].path + "'"))
        }
        if modules[index].spec.kind != "source" {
            var previous = 0
            while previous < index {
                if modules[previous].spec.kind != "source" &&
                    artifactModuleNamesEqual(first: modules[previous].spec.name, second: name) {
                    return .Err(GraphError(moduleIndex: index, message: "case-colliding output module name: " + name))
                }
                previous = previous + 1
            }
        }
        index = index + 1
    }
    var edges: [[Int]] = []
    var colors: [Int] = []
    var offsets: [Int] = []
    var stack: [Int] = []
    index = 0
    while index < modules.count {
        let destinations = projectModuleEdges(spec: modules[index].spec, modules: modules, standard: standard,
            paths: pathEdges[index], owner: index)?
        &edges.append(element: destinations)
        &colors.append(element: 0)
        &offsets.append(element: 0)
        &stack.append(element: 0)
        index = index + 1
    }
    // Visit the entire graph iteratively, not just selected dependency closures.
    var root = 0
    while root < modules.count {
        if colors[root] == 0 {
            &stack[0] = root
            &colors[root] = 1
            var depth = 1
            while depth > 0 {
                let top = depth - 1
                let node = stack[top]
                let offset = offsets[node]
                if offset >= edges[node].count {
                    &colors[node] = 2
                    depth = depth - 1
                } else {
                    let destination = edges[node][offset]
                    let nextOffset = offset + 1
                    &offsets[node] = nextOffset
                    let color = colors[destination]
                    if color == 1 {
                        var begin = 0
                        while begin < depth {
                            if stack[begin] == destination { break }
                            begin = begin + 1
                        }
                        var path = ""
                        var cursor = begin
                        while cursor < depth {
                            if path.count > 0 { path = path + " -> " }
                            let member = stack[cursor]
                            path = path + modules[member].spec.name
                            cursor = cursor + 1
                        }
                        path = path + " -> " + modules[destination].spec.name
                        return .Err(GraphError(moduleIndex: node, message: "module dependency cycle: " + path))
                    }
                    if color == 0 {
                        if depth >= stack.count {
                            return .Err(GraphError(moduleIndex: node,
                                message: "module graph exceeds bounded traversal depth"))
                        }
                        &stack[depth] = destination
                        &colors[destination] = 1
                        depth = depth + 1
                    }
                }
            }
        }
        root = root + 1
    }
    return .Ok(edges)
}

private func projectHasWorkspace(directory: String): Result<String, ProjectError> {
    let path = projectJoin(base: directory, path: "workspace.toml")?
    let present = match fileKind(path: path) {
        .Ok(kind) => match kind {
            .File => true,
            .Directory => false,
            .Symlink => false,
            .Other => false,
        },
        .Err(_) => false,
    }
    if present { return .Ok(path) }
    return .Ok("")
}

// A member directory holding a workspace.toml is a nested workspace whose
// members are relative to it; any other member directory is one module. The
// member "." is always the workspace's own module, so a workspace can contain
// the module that sits beside its workspace.toml.
private func projectLoadWorkspace(path: String, directory: String, depth: Int,
    loaded: inout [LoadedModule]): Result<Void, ProjectError> {
    if depth > 8 {
        return .Err(ProjectError(error: ToolError(message: "nested workspaces exceed depth 8", pos: -1),
            path: path, contents: ""))
    }
    let text = projectDocument(path: path)?
    let members = match parseWorkspace(contents: text) {
        .Ok(entries) => entries,
        .Err(error) => {
            return .Err(ProjectError(error: error, path: path, contents: text))
        },
    }
    let ordered = sortedStrings(values: members)
    var index = 0
    while index < ordered.count {
        let memberDirectory = projectJoin(base: directory, path: ordered[index])?
        var nested = ""
        if ordered[index] != "." { nested = projectHasWorkspace(directory: memberDirectory)? }
        if nested.count != 0 {
            projectLoadWorkspace(path: nested, directory: memberDirectory, depth: depth + 1, loaded: &loaded)?
        } else {
            if loaded.count >= 256 {
                return .Err(ProjectError(error: ToolError(message: "workspace exceeds 256 modules", pos: -1),
                    path: path, contents: text))
            }
            let modulePath = projectJoin(base: memberDirectory, path: "project.toml")?
            let module = projectModule(path: modulePath, directory: memberDirectory)?
            &loaded.append(element: module)
        }
        index = index + 1
    }
    return .Ok(())
}

func loadProject(options: inout CliOptions): Result<Project, ProjectError> {
    var loaded: [LoadedModule] = []
    let windows = System.isWindows()
    var directory = pathDirectory(path: options.manifestPath, windows: windows)
    if options.workspacePath.count == 0 {
        let module = projectModule(path: options.manifestPath, directory: directory)?
        &loaded.append(element: module)
    } else {
        directory = pathDirectory(path: options.workspacePath, windows: windows)
        projectLoadWorkspace(path: options.workspacePath, directory: directory, depth: 0, loaded: &loaded)?
    }
    let rootCount = loaded.count
    let pathEdges = loadPathDependencies(loaded: &loaded)?
    var standard: [String] = []
    if needsStandardModules(modules: loaded) {
        let compiler = match discoverCompiler(explicit: options.compiler) {
            .Ok(path) => path,
            .Err(error) => { return .Err(ProjectError(error: error, path: "", contents: "")) },
        }
        &options.compiler = compiler
        standard = projectStandardModules(compiler: compiler)?
    }
    let edges = match projectGraph(modules: loaded, standard: standard, pathEdges: pathEdges) {
        .Ok(dependencies) => dependencies,
        .Err(error) => {
            let owner = error.moduleIndex
            return .Err(ProjectError(error: ToolError(message: error.message, pos: loaded[owner].spec.pos),
                path: loaded[owner].path, contents: loaded[owner].contents))
        },
    }
    var modules: [ProjectModule] = []
    var index = 0
    while index < loaded.count {
        &modules.append(element: ProjectModule(spec: loaded[index].spec,
            directory: loaded[index].directory, path: loaded[index].path,
            dependencyIndexes: edges[index]))
        index = index + 1
    }
    return .Ok(Project(modules: modules, rootCount: rootCount, directory: directory))
}
