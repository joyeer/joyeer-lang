import moss.archive
import moss.binary
import moss.jvm
import moss.model

// Persistent session (moss serve). One request per line, with the same arguments
// as the command line minus the program name, and one framed reply per request.
// The session keeps the most recent input in memory, so follow-up queries on it
// neither reread the file nor parse the class again.

public struct Reply {
    public let ok: Bool
    public let text: String
    public let quit: Bool
}

public struct Session {
    public var path: String
    public var hasInput: Bool
    public var input: String
    public var entry: String
    public var preview: Bool
    public var member: String
    // Zero or one parsed class. An array, so queries borrow the element instead
    // of copying an Optional payload.
    public var classes: [ClassFile]
    // Lifetime counters, kept across reset so tests can observe the cache.
    public var reads: Int
    public var parses: Int
}

public func newSession(): Session {
    return Session(path: "", hasInput: false, input: "", entry: "", preview: false, member: "",
        classes: [], reads: 0, parses: 0)
}

public func maximumRequestBytes(): Int {
    return 8192
}

public func diagnosticText(error: borrowing Diagnostic): String {
    var location = ""
    if error.offset >= 0 { location = " at byte " + decimal(value: error.offset) }
    return error.code + location + " [" + error.context + "]: " + error.message
}

private func unterminated(): Diagnostic {
    return Diagnostic(code: "serve.unterminated-quote", offset: -1, context: "request",
        message: "a quoted argument is not closed")
}

// Splits a request on spaces and tabs. Double quotes group text (including
// spaces and empty arguments); inside quotes a backslash escapes the next byte.
public func tokenize(line: borrowing String): Result<[String], Diagnostic> {
    var tokens: [String] = []
    var current = ""
    var started = false
    var quoted = false
    var index = 0
    while index < line.count {
        let byte = line[index]
        if quoted {
            if byte == 92 {
                if index + 1 >= line.count { return .Err(unterminated()) }
                current = current + byteToString(value: line[index + 1])
                index = index + 2
            } else if byte == 34 {
                quoted = false
                index = index + 1
            } else {
                current = current + byteToString(value: byte)
                index = index + 1
            }
        } else if byte == 34 {
            quoted = true
            started = true
            index = index + 1
        } else if byte == 32 || byte == 9 {
            if started {
                &tokens.append(element: current)
                current = ""
                started = false
            }
            index = index + 1
        } else {
            current = current + byteToString(value: byte)
            started = true
            index = index + 1
        }
    }
    if quoted { return .Err(unterminated()) }
    if started { &tokens.append(element: current) }
    return .Ok(tokens)
}

private func lineCount(text: borrowing String): Int {
    if text.count == 0 { return 0 }
    var lines = 1
    var index = 0
    while index < text.count {
        if text[index] == 10 { lines = lines + 1 }
        index = index + 1
    }
    return lines
}

// "moss: ok <lines>" or "moss: error <lines>", then exactly that many lines. The
// caller prints the result with one final newline. Counting lines rather than
// bytes keeps the frame valid where stdout turns LF into CRLF (Windows).
public func frame(reply: borrowing Reply): String {
    var kind = "error"
    if reply.ok { kind = "ok" }
    let header = "moss: " + kind + " " + decimal(value: lineCount(text: reply.text))
    if reply.text.count == 0 { return header }
    return header + "\n" + reply.text
}

private func failure(error: borrowing Diagnostic): Reply {
    return Reply(ok: false, text: diagnosticText(error: error), quit: false)
}

private func rejected(code: String, message: String): Reply {
    return failure(error: Diagnostic(code: code, offset: -1, context: "request", message: message))
}

private func success(text: String): Reply {
    return Reply(ok: true, text: text, quit: false)
}

private func hasZipMagic(input: borrowing String): Bool {
    return input.count >= 4 && byteToInt(value: input[0]) == 80 && byteToInt(value: input[1]) == 75 &&
        byteToInt(value: input[2]) == 3 && byteToInt(value: input[3]) == 4
}

private func clear(session: inout Session) {
    &session.path = ""
    &session.hasInput = false
    &session.input = ""
    &session.entry = ""
    &session.preview = false
    &session.member = ""
    &session.classes = []
}

// Makes the session hold what the query needs. State changes only after every
// fallible step has succeeded, so a failed request leaves the cache intact.
private func prepare(session: inout Session, options: borrowing Options): Result<Void, Diagnostic> {
    if !session.hasInput || session.path != options.path {
        let bytes = match readInput(path: options.path) {
            .Ok(value) => value,
            .Err(error) => { return .Err(inputDiagnostic(path: options.path, error: error)) },
        }
        clear(session: &session)
        &session.path = options.path
        &session.input = bytes
        &session.hasInput = true
        &session.reads = session.reads + 1
    }
    if options.command == "entries" { return .Ok(()) }
    if session.classes.count == 1 && session.entry == options.entry &&
        session.preview == options.allowPreview {
        return .Ok(())
    }
    var member = ""
    if options.entry.count != 0 {
        member = extractEntry(archive: session.input.utf8(), name: options.entry)?
    } else if hasZipMagic(input: session.input) {
        return .Err(Diagnostic(code: "input.archive-needs-entry", offset: -1, context: "input",
            message: "input is a ZIP/JAR archive; list names with moss entries and select one with --entry"))
    }
    var parsed: ClassFile
    if options.entry.count != 0 {
        parsed = parseClass(input: member, allowPreview: options.allowPreview)?
    } else {
        parsed = parseClass(input: session.input, allowPreview: options.allowPreview)?
    }
    &session.member = member
    &session.entry = options.entry
    &session.preview = options.allowPreview
    &session.classes = []
    &session.classes.append(element: parsed)
    &session.parses = session.parses + 1
    return .Ok(())
}

private func query(session: borrowing Session, options: borrowing Options): Result<String, Diagnostic> {
    if options.command == "entries" {
        return analyzeEntries(options: options, input: session.input)
    }
    if session.entry.count == 0 {
        return analyzeParsed(options: options, input: session.input, file: session.classes[0])
    }
    return analyzeParsed(options: options, input: session.member, file: session.classes[0])
}

public func respond(session: inout Session, line: borrowing String): Reply {
    let args = match tokenize(line: line) {
        .Ok(values) => values,
        .Err(error) => { return failure(error: error) },
    }
    if args.count == 0 { return success(text: "") }
    if args.count == 1 && (args[0] == "quit" || args[0] == "exit") {
        return Reply(ok: true, text: "bye", quit: true)
    }
    if args.count == 1 && args[0] == "reset" {
        clear(session: &session)
        return success(text: "reset")
    }
    let command = match parse(args: args) {
        .Ok(value) => value,
        .Err(error) => { return failure(error: error) },
    }
    return match command {
        .Help => success(text: helpText()),
        .Version => success(text: versionText()),
        .Serve => rejected(code: "serve.nested", message: "already in a moss serve session"),
        .Analyze(options) => {
            if options.output.count != 0 {
                return rejected(code: "serve.output-unsupported",
                    message: "--output is not available in a session; replies go to stdout")
            }
            match prepare(session: &session, options: options) {
                .Ok(_) => {},
                .Err(error) => { return failure(error: error) },
            }
            return match query(session: session, options: options) {
                .Ok(text) => success(text: text),
                .Err(error) => failure(error: error),
            }
        },
    }
}
