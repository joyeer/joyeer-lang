import moss.binary
import moss.model

private func opcodeNames(): [String] {
    return [
        "nop", "aconst_null", "iconst_m1", "iconst_0", "iconst_1", "iconst_2", "iconst_3", "iconst_4",
        "iconst_5", "lconst_0", "lconst_1", "fconst_0", "fconst_1", "fconst_2", "dconst_0", "dconst_1",
        "bipush", "sipush", "ldc", "ldc_w", "ldc2_w", "iload", "lload", "fload", "dload", "aload",
        "iload_0", "iload_1", "iload_2", "iload_3", "lload_0", "lload_1", "lload_2", "lload_3",
        "fload_0", "fload_1", "fload_2", "fload_3", "dload_0", "dload_1", "dload_2", "dload_3",
        "aload_0", "aload_1", "aload_2", "aload_3", "iaload", "laload", "faload", "daload", "aaload",
        "baload", "caload", "saload", "istore", "lstore", "fstore", "dstore", "astore",
        "istore_0", "istore_1", "istore_2", "istore_3", "lstore_0", "lstore_1", "lstore_2", "lstore_3",
        "fstore_0", "fstore_1", "fstore_2", "fstore_3", "dstore_0", "dstore_1", "dstore_2", "dstore_3",
        "astore_0", "astore_1", "astore_2", "astore_3", "iastore", "lastore", "fastore", "dastore",
        "aastore", "bastore", "castore", "sastore", "pop", "pop2", "dup", "dup_x1", "dup_x2", "dup2",
        "dup2_x1", "dup2_x2", "swap", "iadd", "ladd", "fadd", "dadd", "isub", "lsub", "fsub", "dsub",
        "imul", "lmul", "fmul", "dmul", "idiv", "ldiv", "fdiv", "ddiv", "irem", "lrem", "frem", "drem",
        "ineg", "lneg", "fneg", "dneg", "ishl", "lshl", "ishr", "lshr", "iushr", "lushr", "iand",
        "land", "ior", "lor", "ixor", "lxor", "iinc", "i2l", "i2f", "i2d", "l2i", "l2f", "l2d",
        "f2i", "f2l", "f2d", "d2i", "d2l", "d2f", "i2b", "i2c", "i2s", "lcmp", "fcmpl", "fcmpg",
        "dcmpl", "dcmpg", "ifeq", "ifne", "iflt", "ifge", "ifgt", "ifle", "if_icmpeq", "if_icmpne",
        "if_icmplt", "if_icmpge", "if_icmpgt", "if_icmple", "if_acmpeq", "if_acmpne", "goto", "jsr",
        "ret", "tableswitch", "lookupswitch", "ireturn", "lreturn", "freturn", "dreturn", "areturn",
        "return", "getstatic", "putstatic", "getfield", "putfield", "invokevirtual", "invokespecial",
        "invokestatic", "invokeinterface", "invokedynamic", "new", "newarray", "anewarray", "arraylength",
        "athrow", "checkcast", "instanceof", "monitorenter", "monitorexit", "wide", "multianewarray",
        "ifnull", "ifnonnull", "goto_w", "jsr_w",
    ]
}

private func checkLocal(slot: Int, opcode: Int, maxLocals: Int,
    offset: Int): Result<Void, Diagnostic> {
    var width = 1
    if opcode == 22 || opcode == 24 || opcode == 55 || opcode == 57 ||
        (opcode >= 30 && opcode <= 33) || (opcode >= 38 && opcode <= 41) ||
        (opcode >= 63 && opcode <= 66) || (opcode >= 71 && opcode <= 74) { width = 2 }
    if slot >= maxLocals || width > maxLocals - slot {
        return .Err(diagnostic(code: "jvm.invalid-local-index", offset: offset,
            context: "bytecode", message: "local operand exceeds max_locals"))
    }
    return .Ok(())
}

private func referenceDescriptor(pool: borrowing [Constant], index: Int): [Int] {
    return pool[pool[pool[index].second].second].text
}

private func checkConstant(pool: borrowing [Constant], index: Int, opcode: Int,
    offset: Int): Result<Void, Diagnostic> {
    requireTag(pool: pool, index: index, tag: 0, offset: offset, context: "bytecode constant")?
    let tag = pool[index].tag
    var valid = false
    if opcode == 18 || opcode == 19 || opcode == 20 {
        var wideValue = tag == 5 || tag == 6
        if tag == 17 {
            let type = referenceDescriptor(pool: pool, index: index)
            wideValue = unitsEqualAscii(units: type, text: "J") ||
                unitsEqualAscii(units: type, text: "D")
        }
        if opcode == 20 {
            valid = wideValue
        } else {
            valid = !wideValue && (tag == 3 || tag == 4 || tag == 7 || tag == 8 ||
                tag == 15 || tag == 16 || tag == 17)
        }
    } else if opcode >= 178 && opcode <= 181 {
        valid = tag == 9
    } else if opcode == 182 {
        valid = tag == 10
    } else if opcode == 183 || opcode == 184 {
        valid = tag == 10 || tag == 11
    } else if opcode == 185 {
        valid = tag == 11
    } else if opcode == 186 {
        valid = tag == 18
    } else {
        valid = tag == 7
    }
    if !valid {
        return .Err(diagnostic(code: "jvm.invalid-constant-tag", offset: offset,
            context: "bytecode", message: "constant type does not match opcode"))
    }
    if opcode == 187 {
        classConstant(pool: pool, index: index, arrayAllowed: false, offset: offset, context: "new")?
    }
    if opcode == 182 || opcode == 184 || opcode == 185 {
        if named(pool: pool, index: pool[pool[index].second].first, name: "<init>") {
            return .Err(diagnostic(code: "jvm.invalid-method", offset: offset,
                context: "invoke", message: "constructors require invokespecial"))
        }
    }
    return .Ok(())
}

private func decodeOne(input: borrowing String, cursor: inout Cursor, code: borrowing Code,
    pool: borrowing [Constant], names: borrowing [String], returnType: Int): Result<Instruction, Diagnostic> {
    let start = cursor.position
    let pc = start - code.bytes.offset
    let raw = u(input: input, cursor: &cursor, width: 1, context: "opcode")?
    if raw >= names.count || raw == 168 || raw == 169 || raw == 201 {
        return .Err(diagnostic(code: "jvm.invalid-opcode", offset: start,
            context: "bytecode", message: "reserved or version-forbidden opcode"))
    }
    var opcode = raw
    var wide = false
    var operands: [Operand] = []
    if raw == 196 {
        wide = true
        opcode = u(input: input, cursor: &cursor, width: 1, context: "wide.opcode")?
        if (opcode < 21 || opcode > 25) && (opcode < 54 || opcode > 58) && opcode != 132 {
            return .Err(diagnostic(code: "jvm.invalid-wide", offset: start,
                context: "wide", message: "invalid or version-forbidden modified opcode"))
        }
        let local = u(input: input, cursor: &cursor, width: 2, context: "wide.index")?
        checkLocal(slot: local, opcode: opcode, maxLocals: code.maxLocals, offset: start)?
        &operands.append(element: .Local(local))
        if opcode == 132 {
            let increment = s(input: input, cursor: &cursor, width: 2, context: "wide.iinc")?
            &operands.append(element: .Immediate(increment))
        }
    } else if raw == 16 || raw == 17 {
        var width = 1
        if raw == 17 { width = 2 }
        let value = s(input: input, cursor: &cursor, width: width, context: "push operand")?
        &operands.append(element: .Immediate(value))
    } else if (raw >= 21 && raw <= 25) || (raw >= 54 && raw <= 58) || raw == 132 {
        let local = u(input: input, cursor: &cursor, width: 1, context: "local index")?
        checkLocal(slot: local, opcode: raw, maxLocals: code.maxLocals, offset: start)?
        &operands.append(element: .Local(local))
        if raw == 132 {
            let increment = s(input: input, cursor: &cursor, width: 1, context: "iinc")?
            &operands.append(element: .Immediate(increment))
        }
    } else if (raw >= 26 && raw <= 45) || (raw >= 59 && raw <= 78) {
        var local = (raw - 26) % 4
        if raw >= 59 { local = (raw - 59) % 4 }
        checkLocal(slot: local, opcode: raw, maxLocals: code.maxLocals, offset: start)?
        &operands.append(element: .Local(local))
    } else if (raw >= 153 && raw <= 167) || raw == 198 || raw == 199 || raw == 200 {
        var width = 2
        if raw == 200 { width = 4 }
        let delta = s(input: input, cursor: &cursor, width: width, context: "branch offset")?
        &operands.append(element: .Target(pc + delta))
    } else if raw == 170 || raw == 171 {
        // Switch alignment is relative to method code, not the classfile.
        while (cursor.position - code.bytes.offset) % 4 != 0 {
            u(input: input, cursor: &cursor, width: 1, context: "switch padding")?
        }
        let fallback = s(input: input, cursor: &cursor, width: 4, context: "switch.default")?
        &operands.append(element: .DefaultTarget(pc + fallback))
        if raw == 170 {
            let low = s(input: input, cursor: &cursor, width: 4, context: "tableswitch.low")?
            let high = s(input: input, cursor: &cursor, width: 4, context: "tableswitch.high")?
            if high < low || high - low + 1 > (cursor.end - cursor.position) / 4 {
                return .Err(diagnostic(code: "jvm.invalid-switch", offset: start,
                    context: "tableswitch", message: "invalid or truncated table bounds"))
            }
            var key = low
            while key <= high {
                let delta = s(input: input, cursor: &cursor, width: 4, context: "tableswitch.target")?
                &operands.append(element: .SwitchTarget(key, pc + delta))
                key = key + 1
            }
        } else {
            let count = s(input: input, cursor: &cursor, width: 4, context: "lookupswitch.npairs")?
            if count < 0 || count > (cursor.end - cursor.position) / 8 {
                return .Err(diagnostic(code: "jvm.invalid-switch", offset: start,
                    context: "lookupswitch", message: "invalid or truncated pair count"))
            }
            var index = 0
            var previous = 0
            while index < count {
                let key = s(input: input, cursor: &cursor, width: 4, context: "lookupswitch.key")?
                if index > 0 && key <= previous {
                    return .Err(diagnostic(code: "jvm.invalid-switch", offset: start,
                        context: "lookupswitch", message: "keys must be strictly increasing"))
                }
                let delta = s(input: input, cursor: &cursor, width: 4, context: "lookupswitch.target")?
                &operands.append(element: .SwitchTarget(key, pc + delta))
                previous = key
                index = index + 1
            }
        }
    } else if raw == 18 || raw == 19 || raw == 20 || (raw >= 178 && raw <= 187) ||
        raw == 189 || raw == 192 || raw == 193 || raw == 197 {
        var width = 2
        if raw == 18 { width = 1 }
        let constant = u(input: input, cursor: &cursor, width: width, context: "constant index")?
        checkConstant(pool: pool, index: constant, opcode: raw, offset: start)?
        &operands.append(element: .Constant(constant))
        if raw == 185 {
            let count = u(input: input, cursor: &cursor, width: 1, context: "invokeinterface.count")?
            let zero = u(input: input, cursor: &cursor, width: 1, context: "invokeinterface.zero")?
            let info = descriptor(units: referenceDescriptor(pool: pool, index: constant),
                method: true, offset: start)?
            if zero != 0 || count == 0 || count != info.slots + 1 {
                return .Err(diagnostic(code: "jvm.invalid-invoke", offset: start,
                    context: "invokeinterface", message: "invalid count or reserved byte"))
            }
            &operands.append(element: .Count(count))
        } else if raw == 186 {
            let zero = u(input: input, cursor: &cursor, width: 2, context: "invokedynamic.zero")?
            if zero != 0 {
                return .Err(diagnostic(code: "jvm.invalid-invoke", offset: start,
                    context: "invokedynamic", message: "reserved bytes must be zero"))
            }
        } else if raw == 197 {
            let dimensions = u(input: input, cursor: &cursor, width: 1, context: "multianewarray.dimensions")?
            let info = descriptor(units: pool[pool[constant].first].text, method: false, offset: start)?
            if dimensions == 0 || dimensions > info.dimensions {
                return .Err(diagnostic(code: "jvm.invalid-array", offset: start,
                    context: "multianewarray", message: "dimensions exceed array descriptor rank"))
            }
            &operands.append(element: .Dimensions(dimensions))
        } else if raw == 189 {
            let text = pool[pool[constant].first].text
            if text.count > 0 && text[0] == 91 {
                let info = descriptor(units: text, method: false, offset: start)?
                if info.dimensions == 255 {
                    return .Err(diagnostic(code: "jvm.invalid-array", offset: start,
                        context: "anewarray", message: "result would exceed 255 array dimensions"))
                }
            }
        }
    } else if raw == 188 {
        let type = u(input: input, cursor: &cursor, width: 1, context: "newarray.atype")?
        if type < 4 || type > 11 {
            return .Err(diagnostic(code: "jvm.invalid-array", offset: start,
                context: "newarray", message: "atype must be in 4..11"))
        }
        &operands.append(element: .ArrayType(type))
    } else if raw >= 172 && raw <= 177 {
        let valid = (raw == 172 && (returnType == 66 || returnType == 67 || returnType == 73 ||
            returnType == 83 || returnType == 90)) || (raw == 173 && returnType == 74) ||
            (raw == 174 && returnType == 70) || (raw == 175 && returnType == 68) ||
            (raw == 176 && (returnType == 76 || returnType == 91)) || (raw == 177 && returnType == 86)
        if !valid {
            return .Err(diagnostic(code: "jvm.invalid-return", offset: start,
                context: "return", message: "opcode does not match method return descriptor"))
        }
    }
    return .Ok(Instruction(methodOffset: pc, fileOffset: start, size: cursor.position - start,
        rawOpcode: raw, opcode: opcode, mnemonic: names[opcode], wide: wide, operands: operands))
}

public func instructionIndex(instructions: borrowing [Instruction], offset: Int): Int? {
    var low = 0
    var high = instructions.count
    while low < high {
        let middle = low + (high - low) / 2
        if instructions[middle].methodOffset < offset {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < instructions.count && instructions[low].methodOffset == offset { return .Some(low) }
    return .None
}

private func isStart(instructions: borrowing [Instruction], offset: Int): Bool {
    return match instructionIndex(instructions: instructions, offset: offset) {
        .Some(_) => true,
        .None => false,
    }
}

private func checkBoundaries(instructions: borrowing [Instruction],
    code: borrowing Code): Result<Void, Diagnostic> {
    var index = 0
    while index < instructions.count {
        var operand = 0
        while operand < instructions[index].operands.count {
            let valid = match instructions[index].operands[operand] {
                .Target(target) => isStart(instructions: instructions, offset: target),
                .DefaultTarget(target) => isStart(instructions: instructions, offset: target),
                .SwitchTarget(_, target) => isStart(instructions: instructions, offset: target),
                _ => true,
            }
            if !valid {
                return .Err(diagnostic(code: "jvm.invalid-branch-target", offset: instructions[index].fileOffset,
                    context: "bytecode", message: "target is not an instruction start inside this method"))
            }
            operand = operand + 1
        }
        index = index + 1
    }
    index = 0
    while index < code.exceptions.count {
        let item = code.exceptions[index]
        if !isStart(instructions: instructions, offset: item.start) ||
            !isStart(instructions: instructions, offset: item.handler) ||
            (item.end != code.bytes.length && !isStart(instructions: instructions, offset: item.end)) {
            return .Err(diagnostic(code: "jvm.invalid-exception-range", offset: item.fileOffset,
                context: "Code.exception_table", message: "exception boundary is not an instruction start"))
        }
        index = index + 1
    }
    index = 0
    while index < code.lines.count {
        if !isStart(instructions: instructions, offset: code.lines[index].offset) {
            return .Err(diagnostic(code: "jvm.invalid-debug-range", offset: code.lines[index].fileOffset,
                context: "LineNumberTable", message: "line does not start at an instruction"))
        }
        index = index + 1
    }
    index = 0
    while index < code.locals.count {
        let item = code.locals[index]
        if !isStart(instructions: instructions, offset: item.start) ||
            (item.start + item.length != code.bytes.length &&
                !isStart(instructions: instructions, offset: item.start + item.length)) {
            return .Err(diagnostic(code: "jvm.invalid-debug-range", offset: item.fileOffset,
                context: "local variables", message: "local boundaries are not instruction starts"))
        }
        index = index + 1
    }
    let last = instructions[instructions.count - 1].opcode
    if last != 167 && last != 170 && last != 171 && last != 191 && last != 200 &&
        (last < 172 || last > 177) {
        return .Err(diagnostic(code: "jvm.fallthrough-end", offset: code.bytes.offset + code.bytes.length,
            context: "bytecode", message: "last instruction can fall through the end of method code"))
    }
    return .Ok(())
}

public func decodeMethod(input: borrowing String, file: borrowing ClassFile,
    methodIndex: Int): Result<[Instruction], Diagnostic> {
    if file.byteCount != input.count || methodIndex < 0 || methodIndex >= file.methods.count {
        return .Err(diagnostic(code: "jvm.invalid-method-index", offset: 0,
            context: "method", message: "method index or backing input is invalid"))
    }
    let method = file.methods[methodIndex]
    requireTag(pool: file.pool, index: method.descriptorIndex, tag: 1,
        offset: method.fileOffset, context: "method descriptor")?
    let info = descriptor(units: file.pool[method.descriptorIndex].text, method: true, offset: method.fileOffset)?
    return match method.code {
        .None => .Ok([]),
        .Some(code) => {
            if code.bytes.length < 1 || code.bytes.length > 65535 ||
                code.maxLocals < 0 || code.maxLocals > 65535 {
                return .Err(diagnostic(code: "jvm.invalid-code-length", offset: code.bytes.offset,
                    context: "Code", message: "invalid code bounds"))
            }
            var cursor = bounded(input: input, region: code.bytes, context: "bytecode")?
            let names = opcodeNames()
            var instructions: [Instruction] = []
            while cursor.position < cursor.end {
                &instructions.append(element: decodeOne(input: input, cursor: &cursor,
                    code: code, pool: file.pool, names: names, returnType: info.returnType)?)
            }
            checkBoundaries(instructions: instructions, code: code)?
            return .Ok(instructions)
        },
    }
}
