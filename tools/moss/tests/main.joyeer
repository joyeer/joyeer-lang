import moss.cli

private func isHelp(args: borrowing [String]): Bool {
    return match parse(args: args) {
        .Ok(command) => match command {
            .Help => true,
            .Version => false,
            .Analyze(_) => false,
            .Serve => false,
        },
        .Err(_) => false,
    }
}

private func isVersion(args: borrowing [String]): Bool {
    return match parse(args: args) {
        .Ok(command) => match command {
            .Help => false,
            .Version => true,
            .Analyze(_) => false,
            .Serve => false,
        },
        .Err(_) => false,
    }
}

private func isRejected(args: borrowing [String]): Bool {
    return match parse(args: args) {
        .Ok(_) => false,
        .Err(error) => error.message.count != 0 && error.code == "cli.usage",
    }
}

private func isAnalyze(args: borrowing [String]): Bool {
    return match parse(args: args) {
        .Ok(command) => match command {
            .Analyze(_) => true,
            _ => false,
        },
        .Err(_) => false,
    }
}

private func classEntryOf(args: borrowing [String]): String {
    return match parse(args: args) {
        .Ok(command) => match command {
            .Analyze(options) => options.entry,
            _ => "",
        },
        .Err(_) => "",
    }
}

private func isServe(args: borrowing [String]): Bool {
    return match parse(args: args) {
        .Ok(command) => match command {
            .Serve => true,
            _ => false,
        },
        .Err(_) => false,
    }
}

private func failed(name: borrowing String): Int {
    print(value: "FAIL: " + name)
    return 1
}

private func joined(values: borrowing [String]): String {
    var text = ""
    var index = 0
    while index < values.count {
        text = text + "[" + values[index] + "]"
        index = index + 1
    }
    return text
}

private func tokensOf(line: borrowing String): String {
    return match tokenize(line: line) {
        .Ok(values) => joined(values: values),
        .Err(error) => "error:" + error.code,
    }
}

private func contains(text: borrowing String, needle: borrowing String): Bool {
    if needle.count > text.count { return false }
    var start = 0
    while start + needle.count <= text.count {
        var matched = true
        var index = 0
        while index < needle.count {
            if text[start + index] != needle[index] {
                matched = false
                index = needle.count
            } else {
                index = index + 1
            }
        }
        if matched { return true }
        start = start + 1
    }
    return false
}

private func oneShot(line: borrowing String): String {
    let args = match tokenize(line: line) {
        .Ok(values) => values,
        .Err(_) => { return "<tokenize error>" },
    }
    let command = match parse(args: args) {
        .Ok(value) => value,
        .Err(_) => { return "<parse error>" },
    }
    return match command {
        .Analyze(options) => match analyze(options: options) {
            .Ok(text) => text,
            .Err(error) => "<error " + error.code + ">",
        },
        _ => "<not analyze>",
    }
}

// Serve protocol checks. Paths are relative to the repository root, where
// the fern test runner executes.
private func serveChecks(): Int {
    let classes = "tools/moss/tests/fixtures/jvm/"
    let example8 = classes + "Example8.class"
    let example17 = classes + "Example17.class"

    if !isServe(args: ["serve"]) { return failed(name: "serve command") }
    if !isRejected(args: ["serve", "extra"]) { return failed(name: "serve takes no arguments") }
    if tokensOf(line: "disasm  Foo.class   --method main") != "[disasm][Foo.class][--method][main]" {
        return failed(name: "tokenizer splits on runs of spaces")
    }
    if tokensOf(line: "\tmethods\ta.class ") != "[methods][a.class]" { return failed(name: "tokenizer treats tabs as spaces") }
    if tokensOf(line: "inspect \"a b.jar\" --entry \"x\\\"y\\\\z\"") != "[inspect][a b.jar][--entry][x\"y\\z]" {
        return failed(name: "tokenizer quotes and escapes")
    }
    if tokensOf(line: "a \"\" b") != "[a][][b]" { return failed(name: "empty quoted token") }
    if tokensOf(line: "a\"b c\"d") != "[ab cd]" { return failed(name: "quotes join adjacent text") }
    if tokensOf(line: "   ") != "" { return failed(name: "blank line has no tokens") }
    if tokensOf(line: "a \"b") != "error:serve.unterminated-quote" { return failed(name: "unterminated quote") }
    if tokensOf(line: "a \"b\\") != "error:serve.unterminated-quote" { return failed(name: "dangling escape") }

    let one = frame(reply: Reply(ok: true, text: "x", quit: false))
    if one != "moss: ok 1\nx" { return failed(name: "frame one line") }
    let three = frame(reply: Reply(ok: true, text: "a\nb\nc", quit: false))
    if three != "moss: ok 3\na\nb\nc" { return failed(name: "frame counts lines") }
    if frame(reply: Reply(ok: true, text: "", quit: false)) != "moss: ok 0" { return failed(name: "frame empty body") }
    if frame(reply: Reply(ok: false, text: "bad", quit: false)) != "moss: error 1\nbad" { return failed(name: "frame error") }

    var session = newSession()
    let first = respond(session: &session, line: "methods " + example8)
    if !first.ok || first.quit { return failed(name: "first query succeeds") }
    if first.text != oneShot(line: "methods " + example8) { return failed(name: "serve equals one-shot output") }
    if session.reads != 1 || session.parses != 1 { return failed(name: "first query reads and parses once") }

    let second = respond(session: &session, line: "inspect " + example8)
    if !second.ok || second.text != oneShot(line: "inspect " + example8) { return failed(name: "second query equals one-shot") }
    let third = respond(session: &session, line: "disasm " + example8 + " --method-index 0")
    if !third.ok || third.text != oneShot(line: "disasm " + example8 + " --method-index 0") {
        return failed(name: "indexed disasm equals one-shot")
    }
    let cfg = respond(session: &session, line: "cfg " + example8 + " --method-index 0")
    if !cfg.ok { return failed(name: "cfg through a session") }
    if session.reads != 1 || session.parses != 1 { return failed(name: "same class is not read or parsed again") }

    let other = respond(session: &session, line: "methods " + example17)
    if !other.ok || session.reads != 2 || session.parses != 2 { return failed(name: "new path reads and parses") }
    let back = respond(session: &session, line: "methods " + example8)
    if !back.ok || session.reads != 3 || session.parses != 3 { return failed(name: "cache holds one input at a time") }

    let preview = respond(session: &session, line: "methods " + example8 + " --allow-preview")
    if !preview.ok || session.reads != 3 || session.parses != 4 { return failed(name: "preview change reparses without rereading") }

    let cleared = respond(session: &session, line: "reset")
    if !cleared.ok || cleared.quit { return failed(name: "reset") }
    let after = respond(session: &session, line: "methods " + example8)
    if !after.ok || session.reads != 4 || session.parses != 5 { return failed(name: "reset forces a fresh read") }

    let missing = respond(session: &session, line: "methods tools/moss/tests/fixtures/jvm/Nope.class")
    if missing.ok || !contains(text: missing.text, needle: "input.") { return failed(name: "missing input is an error reply") }
    let afterMissing = respond(session: &session, line: "methods " + example8)
    if !afterMissing.ok { return failed(name: "session survives a failed query") }

    let unknown = respond(session: &session, line: "bogus")
    if unknown.ok || !contains(text: unknown.text, needle: "cli.usage") { return failed(name: "unknown command is an error reply") }
    let unterminated = respond(session: &session, line: "methods \"x")
    if unterminated.ok || !contains(text: unterminated.text, needle: "serve.unterminated-quote") {
        return failed(name: "unterminated quote is an error reply")
    }
    let output = respond(session: &session, line: "methods " + example8 + " --output x")
    if output.ok || !contains(text: output.text, needle: "serve.output-unsupported") {
        return failed(name: "--output is rejected in a session")
    }
    let nested = respond(session: &session, line: "serve")
    if nested.ok || !contains(text: nested.text, needle: "serve.nested") { return failed(name: "nested serve is rejected") }
    let version = respond(session: &session, line: "--version")
    if !version.ok || version.text != versionText() { return failed(name: "version through a session") }
    let help = respond(session: &session, line: "--help")
    if !help.ok || help.text != helpText() { return failed(name: "help through a session") }

    let bye = respond(session: &session, line: "quit")
    if !bye.ok || !bye.quit { return failed(name: "quit ends the session") }
    let exit = respond(session: &session, line: "exit")
    if !exit.ok || !exit.quit { return failed(name: "exit ends the session") }
    if maximumRequestBytes() != 8192 { return failed(name: "request line limit") }
    return 0
}

func main(args: borrowing [String]): Int {
    if args.count != 0 { return failed(name: "test runner expects no arguments") }
    if !isHelp(args: []) { return failed(name: "empty arguments show help") }
    if !isHelp(args: ["--help"]) { return failed(name: "explicit help") }
    if !isVersion(args: ["--version"]) { return failed(name: "explicit version") }
    if !isRejected(args: ["disasm"]) { return failed(name: "missing analysis input") }
    if !isRejected(args: ["--unknown"]) { return failed(name: "unknown option") }
    if !isRejected(args: [""]) { return failed(name: "empty argument") }
    if !isRejected(args: ["--help", "extra"]) { return failed(name: "help used alone") }
    if !isRejected(args: ["--version", "extra"]) { return failed(name: "version used alone") }
    if versionText() != "moss 0.6.0 (JVM disassembler in javap -c -p layout, JAR/ZIP input, CFG, serve session)" {
        return failed(name: "version identifies current capabilities")
    }
    if !isRejected(args: ["entries"]) { return failed(name: "entries requires an archive path") }
    if !isRejected(args: ["entries", "a.jar", "--entry", "x.class"]) { return failed(name: "entries rejects --entry") }
    if !isRejected(args: ["entries", "a.jar", "--method", "m"]) { return failed(name: "entries rejects method selectors") }
    if !isRejected(args: ["inspect", "a.jar", "--entry", "a", "--entry", "b"]) { return failed(name: "duplicate --entry") }
    if !isRejected(args: ["inspect", "a.jar", "--entry"]) { return failed(name: "--entry needs a value") }
    if !isRejected(args: ["entries", "a.jar", "--class", "a.B"]) { return failed(name: "entries rejects --class") }
    if !isRejected(args: ["inspect", "a.jar", "--entry", "a.class", "--class", "a.B"]) { return failed(name: "entry and class conflict") }
    if !isRejected(args: ["inspect", "a.class", "--prefix", "a/"]) { return failed(name: "--prefix is entries only") }
    if !isRejected(args: ["entries", "a.jar", "--prefix", "a/", "--prefix", "b/"]) { return failed(name: "duplicate --prefix") }
    if !isRejected(args: ["disasm", "a.class", "--descriptor", "()V"]) { return failed(name: "descriptor needs a method") }
    if !isAnalyze(args: ["disasm", "a.class"]) { return failed(name: "disasm without selector prints the class") }
    if !isAnalyze(args: ["disasm", "a.jar", "--class", "com.acme.Foo", "--output", "x"]) { return failed(name: "--class accepted") }
    if !isAnalyze(args: ["entries", "a.jar", "--prefix", "com/", "--limit", "5"]) { return failed(name: "entries --prefix accepted") }
    if classEntryOf(args: ["inspect", "a.jar", "--class", "com.acme.Foo"]) != "com/acme/Foo.class" { return failed(name: "dotted class name") }
    if classEntryOf(args: ["inspect", "a.jar", "--class", "com/acme/Foo$Inner.class"]) != "com/acme/Foo$Inner.class" { return failed(name: "slash class name with suffix") }
    if classEntryOf(args: ["inspect", "a.jar", "--class", "Foo"]) != "Foo.class" { return failed(name: "default-package class") }
    if !isRejected(args: ["cfg", "a.class"]) { return failed(name: "cfg requires a method selector") }
    if !isRejected(args: ["cfg", "a.class", "--method", "m", "--method-index", "1"]) { return failed(name: "cfg selector conflict") }
    if !isAnalyze(args: ["cfg", "a.class", "--method", "m", "--descriptor", "()V"]) { return failed(name: "cfg by name") }
    if !isAnalyze(args: ["cfg", "a.jar", "--class", "a.B", "--method-index", "2", "--output", "x"]) { return failed(name: "cfg in a jar") }
    if !isRejected(args: ["inspect", "a.class", "--method", "m"]) { return failed(name: "inspect rejects selectors") }
    if !isRejected(args: ["disasm", "a.class", "--format", "json"]) { return failed(name: "--format is gone") }
    if !isRejected(args: ["disasm", "a.class", "--unchecked-stdout"]) { return failed(name: "--unchecked-stdout is gone") }
    if helpText().count == 0 { return failed(name: "help is nonempty") }
    if serveChecks() != 0 { return 1 }
    print(value: "moss-tests: 33 checks and the serve session checks passed")
    return 0
}
