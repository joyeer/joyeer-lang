import Foundation
import System

// A static web server for a directory of Markdown files, written against the
// proposed TCP API (spec 18.6, decision 0012). It serves one connection at a
// time: read one request, send one response, close. See ../README.md for what
// that means in practice and for how to run it.

struct Settings {
    let root: String
    let address: String
    let port: Int
}

private func report(message: String) {
    match writeStderr(contents: message + "\n") {
        .Ok(_) => { },
        .Err(_) => { },
    }
}

private func describe(error: NetworkError): String {
    return match error {
        .InvalidInput(code) => "invalid address, port or size (platform code " + decimalString(value: code) + ")",
        .AddressInUse(code) => "address already in use (platform code " + decimalString(value: code) + ")",
        .AddressNotAvailable(code) => "address not available on this machine (platform code " + decimalString(value: code) + ")",
        .PermissionDenied(code) => "permission denied (platform code " + decimalString(value: code) + ")",
        .ConnectionRefused(code) => "connection refused (platform code " + decimalString(value: code) + ")",
        .ConnectionReset(code) => "connection reset (platform code " + decimalString(value: code) + ")",
        .TimedOut(code) => "timed out (platform code " + decimalString(value: code) + ")",
        .Other(code) => "network failure (platform code " + decimalString(value: code) + ")",
    }
}

private func parsePort(text: String): Optional<Int> {
    if text.count == 0 || text.count > 5 { return .None }
    var number = 0
    var index = 0
    while index < text.count {
        let digit = byteToInt(value: text[index]) - 48
        if digit < 0 || digit > 9 { return .None }
        number = number * 10 + digit
        index = index + 1
    }
    if number > 65535 { return .None }
    return .Some(number)
}

private func usage(): String {
    return "usage: markdown-server [site-directory] [--address a.b.c.d] [--port n]\n" +
        "  site-directory  folder of .md files (default: site)\n" +
        "  --address       IPv4 address to listen on (default: 127.0.0.1; 0.0.0.0 serves the network)\n" +
        "  --port          TCP port, 0 picks a free one (default: 8080)"
}

private func parseArguments(args: [String]): Result<Settings, String> {
    var root = "site"
    var address = "127.0.0.1"
    var port = 8080
    var sawRoot = false
    var index = 0
    while index < args.count {
        let option = args[index]
        if option == "--address" || option == "--port" {
            if index + 1 >= args.count { return .Err(option + " needs a value") }
            if option == "--address" {
                address = args[index + 1]
            } else {
                match parsePort(text: args[index + 1]) {
                    .Some(value) => { port = value },
                    .None => { return .Err("--port must be a number from 0 to 65535") },
                }
            }
            index = index + 2
        } else if startsWith(text: option, prefix: "--") {
            return .Err("unknown option " + option)
        } else {
            if sawRoot { return .Err("only one site directory may be given") }
            sawRoot = true
            root = option
            index = index + 1
        }
    }
    return .Ok(Settings(root: root, address: address, port: port))
}

private func readPage(path: String): Result<String, FileSystemError> {
    // One byte over the limit tells "exactly the limit" from "too large".
    return readFilePrefix(path: path, maximumBytes: 1048577)
}

// The full response bytes for one request head.
private func respond(root: String, head: String): String {
    let parsed = parseRequest(head: head)
    let request = match parsed {
        .Some(value) => value,
        .None => Request(method: "", target: ""),
    }
    if request.method.count == 0 {
        return httpResponse(status: 400, reason: "Bad Request", contentType: "text/html; charset=utf-8",
            body: errorPage(status: 400, message: "Bad Request"), sendBody: true, extraHeaders: "")
    }
    if request.method != "GET" && request.method != "HEAD" {
        return httpResponse(status: 405, reason: "Method Not Allowed", contentType: "text/html; charset=utf-8",
            body: errorPage(status: 405, message: "Method Not Allowed"), sendBody: true,
            extraHeaders: "Allow: GET, HEAD\r\n")
    }
    let sendBody = request.method == "GET"

    let found = resolvePage(root: root, target: request.target)
    let path = match found {
        .Some(value) => value,
        .None => "",
    }
    if path.count == 0 {
        return httpResponse(status: 404, reason: "Not Found", contentType: "text/html; charset=utf-8",
            body: errorPage(status: 404, message: "Not Found"), sendBody: sendBody, extraHeaders: "")
    }

    let loaded = readPage(path: path)
    var source = ""
    var failed = false
    match loaded {
        .Ok(text) => { source = text },
        .Err(_) => { failed = true },
    }
    if failed || source.count > 1048576 {
        return httpResponse(status: 500, reason: "Internal Server Error", contentType: "text/html; charset=utf-8",
            body: errorPage(status: 500, message: "Internal Server Error"), sendBody: sendBody, extraHeaders: "")
    }
    var title = firstHeading(source: source)
    if title.count == 0 { title = "Untitled" }
    let body = htmlPage(title: title, body: renderMarkdown(source: source))
    return httpResponse(status: 200, reason: "OK", contentType: "text/html; charset=utf-8",
        body: body, sendBody: sendBody, extraHeaders: "")
}

// Serves one connection and closes it.
private func serveConnection(connection: TcpConnection, root: String) {
    var response = ""
    let head = readRequestHead(connection: connection)
    match head {
        .Ok(text) => { response = respond(root: root, head: text) },
        .Err(error) => {
            match error {
                .Closed => { },
                .TooLarge => {
                    response = httpResponse(status: 431, reason: "Request Header Fields Too Large",
                        contentType: "text/html; charset=utf-8",
                        body: errorPage(status: 431, message: "Request Header Fields Too Large"),
                        sendBody: true, extraHeaders: "")
                },
                .Network(_) => { },
            }
        },
    }
    if response.count != 0 {
        match tcpSend(connection: connection, contents: response) {
            .Ok(_) => { },
            .Err(failure) => { report(message: "send failed: " + describe(error: failure)) },
        }
    }
}

// Accepts, serves and closes one connection. Postfix `?` gives `connection` as an
// owning local, which `tcpCloseConnection` needs to consume; a pattern binding
// from `match` is not one.
private func handleOne(listener: TcpListener, root: String): Result<Void, NetworkError> {
    let connection = tcpAccept(listener: listener)?
    serveConnection(connection: connection, root: root)
    return tcpCloseConnection(connection: consume connection)
}

// Handles connections until accepting itself keeps failing. Returns an exit status.
private func serve(listener: TcpListener, root: String): Int {
    var consecutiveFailures = 0
    while consecutiveFailures < 16 {
        match handleOne(listener: listener, root: root) {
            .Ok(_) => { consecutiveFailures = 0 },
            .Err(failure) => {
                consecutiveFailures = consecutiveFailures + 1
                report(message: "connection failed: " + describe(error: failure))
            },
        }
    }
    return 1
}

// Listens, serves until serving gives up, and closes the listener.
private func run(settings: Settings): Result<Int, NetworkError> {
    let listener = tcpListen(address: settings.address, port: settings.port, backlog: 64)?
    var shown = settings.port
    match tcpLocalPort(listener: listener) {
        .Ok(actual) => { shown = actual },
        .Err(_) => { },
    }
    print(value: "Serving " + settings.root + " at http://" + settings.address + ":" + decimalString(value: shown) + "/")
    let status = serve(listener: listener, root: settings.root)
    match tcpCloseListener(listener: consume listener) {
        .Ok(_) => { },
        .Err(_) => { },
    }
    return .Ok(status)
}

func main(args: [String]): Int {
    var settings = Settings(root: "site", address: "127.0.0.1", port: 8080)
    var invalid = false
    match parseArguments(args: args) {
        .Ok(parsed) => { settings = parsed },
        .Err(message) => {
            report(message: message)
            report(message: usage())
            invalid = true
        },
    }
    if invalid { return 2 }

    let rootIsDirectory = match fileKind(path: settings.root) {
        .Ok(kind) => match kind {
            .Directory => true,
            _ => false,
        },
        .Err(_) => false,
    }
    if !rootIsDirectory {
        report(message: "site directory not found: " + settings.root)
        return 2
    }

    var status = 1
    match run(settings: settings) {
        .Ok(code) => { status = code },
        .Err(error) => {
            report(message: "cannot listen on " + settings.address + ": " + describe(error: error))
        },
    }
    return status
}
