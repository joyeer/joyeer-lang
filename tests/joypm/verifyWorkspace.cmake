jp_write_bytes("${project}/b/main.joyeer" "${app}")
jp_write_bytes("${project}/tests/main.joyeer" "${app}")
jp_write_module("${project}/core" acme.core source "" "'main.joyeer'" "")
jp_write_module("${project}/a" acme.a bin app "'main.joyeer'" "'acme.core'")
jp_write_module("${project}/b" acme.b bin app "'main.joyeer'" "'acme.core'")
jp_write_module("${project}/tests" acme.tests test app "'main.joyeer'" "'acme.core'")
jp_write_workspace("${project}" "'b', 'tests', 'core', 'a'")
jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml")
jp_no_outputs("${project}")
jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --manifest-path "${project}/core/joyeer.toml")
jp_call(1 "${outside}" check --compiler "${COMPILER_SPY}" --manifest-path "${project}/a/joyeer.toml")
jp_contains("${jp_err}" "unknown dependency 'acme.core'")
jp_contains("${jp_err}" "in the loaded project")
jp_contains("${jp_err}" "${project}/a/joyeer.toml:")
jp_call(2 "${outside}" run --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml")
jp_call(2 "${outside}" build --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml" --module acme.core)
jp_call(2 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml" --module missing)
jp_no_outputs("${project}")
jp_write_bytes("${project}/a/main.joyeer" "import acme.b\nfunc main() {}\n")
jp_call(1 "${outside}" check --compiler "${JOYEER_EXECUTABLE}"
    --workspace "${project}/workspace.toml" --module acme.a)
jp_contains("${jp_out}${jp_err}" "acme.b")
jp_no_outputs("${project}")
jp_write_bytes("${project}/a/main.joyeer" "${app}")
foreach(profile IN ITEMS debug release)
    set(options)
    if(profile STREQUAL "release")
        list(APPEND options --release)
    endif()
    jp_call(0 "${outside}" build --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml" ${options})
    foreach(module IN ITEMS acme.a acme.b)
        if(NOT EXISTS "${project}/target/${profile}/${module}/build-1/app${EXECUTABLE_SUFFIX}")
            jp_fail("Equal output names from different modules collided")
        endif()
    endforeach()
    jp_call(0 "${outside}" run --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml" --module acme.a ${options})
    if(NOT jp_out STREQUAL "42\n")
        jp_fail("Workspace dependency did not execute")
    endif()
    jp_call(0 "${outside}" test --compiler "${JOYEER_EXECUTABLE}" --workspace "${project}/workspace.toml" ${options})
    jp_contains("${jp_out}" "1 test: 1 passed, 0 build-fail, 0 run-fail")
endforeach()

function(reject_workspace name text needle)
    set(directory "${work}/reject ${name}")
    file(MAKE_DIRECTORY "${directory}")
    jp_write_bytes("${directory}/workspace.toml" "${text}")
    jp_call(1 "${outside}" check --compiler "${COMPILER_SPY}" --workspace "${directory}/workspace.toml")
    jp_manifest_diagnostic("${directory}/workspace.toml" "${text}")
    jp_contains("${jp_err}" "${needle}")
    jp_no_outputs("${directory}")
endfunction()
set(prefix "schema-version = 1\n[workspace]\n")
reject_workspace(empty "${prefix}members = []\n" "must not be empty")
reject_workspace(duplicate "${prefix}members = ['a', './a']\n" "repeated array entry")
reject_workspace(parent "${prefix}members = ['../a']\n" "without parent traversal")
reject_workspace(absolute "${prefix}members = ['/a']\n" "relative directory")
reject_workspace(drive "${prefix}members = ['C:a']\n" "relative directory")
reject_workspace(unknown "${prefix}modules = []\n" "unknown workspace key")
reject_workspace(nested "${prefix}members = ['a']\n[workspace]\nmembers = ['b']\n" "nested workspaces")
reject_workspace(missing-schema "[workspace]\nmembers = ['a']\n" "schema-version")

