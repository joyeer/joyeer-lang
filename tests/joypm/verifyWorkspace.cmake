set(graph_errors "${work}/graph error ownership")
set(graph_error_cwd "${work}/graph error caller")
file(MAKE_DIRECTORY "${graph_error_cwd}")
jp_write_module("${graph_errors}/a-good" owner.good bin good "'main.joyeer'" "")
jp_write_workspace("${graph_errors}" "'z-bad', 'a-good'")
set(graph_error_text "# Preserve this member's original CRLF coordinates.\r\nschema-version = 1\r\n[module]\r\n")
string(APPEND graph_error_text "name = 'owner.bad'\r\nkind = 'source'\r\nsources = ['main.joyeer']\r\n")
string(APPEND graph_error_text "dependencies = ['owner.missing']\r\n")

function(assert_graph_error text needle)
    jp_write_bytes("${graph_errors}/z-bad/joyeer.toml" "${text}")
    jp_call(1 "${graph_error_cwd}" build --compiler "${COMPILER_SPY}"
        --workspace "${graph_errors}/workspace.toml" --module owner.good)
    jp_contains("${jp_err}" "${needle}")
    string(REPLACE "\\" "/" jp_err "${jp_err}")
    string(FIND "${text}" "[module]" expected_pos)
    jp_manifest_diagnostic("${graph_errors}/z-bad/joyeer.toml" "${text}" "${expected_pos}")
    if(EXISTS "${graph_error_cwd}/compiler-record.txt")
        jp_fail("An invalid graph reached the compiler")
    endif()
    jp_no_outputs("${graph_errors}")
endfunction()

assert_graph_error("${graph_error_text}" "unknown dependency 'owner.missing' in the loaded project")
string(REPLACE "owner.bad" "owner.good" duplicate_text "${graph_error_text}")
assert_graph_error("${duplicate_text}" "duplicate logical module name: owner.good")
string(REPLACE "owner.missing" "owner.bad" cycle_text "${graph_error_text}")
assert_graph_error("${cycle_text}" "module dependency cycle: owner.bad -> owner.bad")

# Check resolved edges and per-module path ownership across the full 256-member
# chain without exceeding compiler argv limits or inventing source files.
set(large "${work}/maximum dependency graph")
file(MAKE_DIRECTORY "${large}")
set(members "")
foreach(index RANGE 1 256)
    set(dependencies "")
    if(index LESS 256)
        math(EXPR next "${index} + 1")
        set(dependencies "'chain.m${next}'")
    endif()
    jp_write_module("${large}/m${index}" "chain.m${index}" source "" "'main.joyeer'" "${dependencies}")
    if(NOT members STREQUAL "")
        string(APPEND members ", ")
    endif()
    string(APPEND members "'m${index}'")
endforeach()
jp_write_workspace("${large}" "${members}")
execute_process(COMMAND "${LOGIC_EXECUTABLE}" "${large}/workspace.toml" project 256
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status STREQUAL "0" OR NOT output STREQUAL "project ok: modules=256\n" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Maximum workspace dependency graph failed (${status}):\n${output}\n${error}")
endif()
jp_no_outputs("${large}")
message(STATUS "joypm module/workspace selection, dependencies, collisions and diagnostics passed")
