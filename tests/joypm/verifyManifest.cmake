cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")
set(jp_timeout 8)
file(READ "${FIXTURE_DIR}/single/project.toml" base)

function(reject_replacement name old replacement)
    string(FIND "${base}" "${old}" at)
    if(at LESS 0)
        message(FATAL_ERROR "Manifest mutation is missing '${old}'")
    endif()
    string(REPLACE "${old}" "${replacement}" changed "${base}")
    jp_reject_manifest("${name}" "${changed}")
endfunction()

jp_reject_manifest(empty "" 0)
reject_replacement(unsupported-schema "schema-version = 1" "schema-version = 2")
reject_replacement(schema-type "schema-version = 1" "schema-version = '1'")
reject_replacement(schema-missing "schema-version = 1" "")
reject_replacement(schema-duplicate "schema-version = 1" "schema-version = 1\nschema-version = 1")
reject_replacement(root-unknown "schema-version = 1" "schema-version = 1\nunknown = 'field'")
reject_replacement(module-unknown "[module]" "[module]\nunknown = []")
reject_replacement(old-module-array "[module]" "[[modules]]")
reject_replacement(old-package "[module]" "[package]")
reject_replacement(unknown-table "[module]" "[unexpected]")
reject_replacement(module-empty-sources "sources = [\"main.joyeer\"]" "sources = []")
reject_replacement(module-source-type "sources = [\"main.joyeer\"]" "sources = 'main.joyeer'")
reject_replacement(module-source-element-type "sources = [\"main.joyeer\"]" "sources = [1]")
reject_replacement(module-source-duplicate "sources = [\"main.joyeer\"]" "sources = ['main.joyeer', 'main.joyeer']")
reject_replacement(module-key-duplicate "dependencies = []" "dependencies = []\ndependencies = []")
reject_replacement(module-name-invalid "name = \"sample.app\"" "name = 'sample..app'")
reject_replacement(module-name-missing "name = \"sample.app\"" "")
reject_replacement(module-kind-missing "kind = \"bin\"" "")
reject_replacement(module-kind-invalid "kind = \"bin\"" "kind = 'library'")
reject_replacement(module-kind-type "kind = \"bin\"" "kind = []")
reject_replacement(module-output-missing "output = \"sample\"" "")
reject_replacement(module-output-invalid "output = \"sample\"" "output = 'bad name'")
reject_replacement(source-with-output "kind = \"bin\"" "kind = 'source'")
reject_replacement(module-unknown-dependency "dependencies = []" "dependencies = ['missing.module']")
reject_replacement(module-cycle "dependencies = []" "dependencies = ['sample.app']")
reject_replacement(module-dependency-type "dependencies = []" "dependencies = 'sample.core'")
reject_replacement(module-repeated-dependency "dependencies = []" "dependencies = ['sample.core', 'sample.core']")
reject_replacement(module-parent-source "sources = [\"main.joyeer\"]" "sources = ['../main.joyeer']")
reject_replacement(module-drive-relative "sources = [\"main.joyeer\"]" "sources = ['C:main.joyeer']")
jp_reject_manifest(second-module "${base}\n[module]\nname = 'another'\n")
jp_reject_manifest(old-targets "${base}\n[[targets]]\nname = 'another'\n")
if(WIN32)
    reject_replacement(reserved-output "output = \"sample\"" "output = 'CON'")
    reject_replacement(reserved-artifact-directory "name = \"sample.app\"" "name = 'CON.app'")
endif()
reject_replacement(unsupported-inline-table "[module]" "module = { name = 'sample' }")
reject_replacement(unsupported-float "schema-version = 1" "schema-version = 1.0")
reject_replacement(unsupported-date "kind = \"bin\"" "kind = 2026-10-01")
reject_replacement(unsupported-quoted-key "schema-version = 1" "\"schema-version\" = 1")
reject_replacement(unsupported-dotted-key "schema-version = 1" "schema.version = 1")
reject_replacement(unsupported-multiline "output = \"sample\"" "output = \"\"\"sample\"\"\"")
reject_replacement(truncated-array "sources = [\"main.joyeer\"]" "sources = [\"main.joyeer\"")
reject_replacement(truncated-string "output = \"sample\"" "output = \"sample")
jp_reject_manifest(trailing-garbage "${base}\n@")
reject_replacement(trailing-value "schema-version = 1" "schema-version = 1 false")
reject_replacement(invalid-escape "output = \"sample\"" [=[output = "sample\q"]=])
reject_replacement(surrogate-escape "sources = [\"main.joyeer\"]" [=[sources = ["\uD800.joyeer"]]=])
reject_replacement(out-of-range-escape "sources = [\"main.joyeer\"]" [=[sources = ["\U00110000.joyeer"]]=])
reject_replacement(truncated-unicode-escape "sources = [\"main.joyeer\"]" [=[sources = ["\u12"]]=])
reject_replacement(nonhex-unicode-escape "sources = [\"main.joyeer\"]" [=[sources = ["\uZZZZ"]]=])
string(ASCII 255 invalid_byte)
jp_reject_manifest(invalid-utf8 "${base}\n# ${invalid_byte}\n" 0)
string(ASCII 192 175 overlong)
reject_replacement(overlong-utf8 "main.joyeer" "${overlong}.joyeer")
string(ASCII 237 160 128 surrogate)
jp_reject_manifest(utf8-surrogate "${base}\n# ${surrogate}\n")
string(REPEAT "[" 64 nested)
reject_replacement(bounded-nesting "sources = [\"main.joyeer\"]" "sources = ${nested}")
string(REPEAT "x" 1048577 long_input)
jp_reject_manifest(bounded-long-malformed "${long_input}" 65536)

set(location_input "# 雪🦀\r\nschema-version = 1\r\nunknown = 'field'\r\n")
string(FIND "${location_input}" "unknown" error_pos)
jp_reject_manifest(location-crlf-utf8 "${location_input}" "${error_pos}")
set(location_input [=[schema-version = 1
[module]
name = "\u006C.\U00000061"
kind = 'source' @
]=])
string(FIND "${location_input}" "@" error_pos)
jp_reject_manifest(location-after-escapes "${location_input}" "${error_pos}")
string(REPLACE "sources = [\"main.joyeer\"]" "sources = [\"雪🦀.joyeer\"] @" location_input "${base}")
string(FIND "${location_input}" "@" error_pos)
jp_reject_manifest(location-after-utf8 "${location_input}" "${error_pos}")
string(REPLACE "sources = [\"main.joyeer\"]" "sources = [\"main.joyeer\"" location_input "${base}")
string(FIND "${location_input}" "dependencies" error_pos)
jp_reject_manifest(location-truncated-array "${location_input}" "${error_pos}")

function(accept_manifest name contents)
    set(package "${work}/${name}")
    set(cwd "${work}/caller ${name}")
    file(MAKE_DIRECTORY "${package}" "${cwd}")
    jp_write_bytes("${package}/project.toml" "${contents}")
    jp_call(1 "${cwd}" check --compiler "${COMPILER_SPY}" --manifest-path "${package}/project.toml")
    jp_no_runtime_error()
    if(NOT jp_out STREQUAL "" OR NOT EXISTS "${cwd}/compiler-record.txt")
        jp_fail("Accepted manifest ${name} did not reach the controlled compiler")
    endif()
    jp_contains("${jp_err}" "37")
    jp_no_outputs("${package}")
endfunction()

accept_manifest(base "${base}")
string(REPLACE "\n" "\r\n" crlf "${base}")
accept_manifest(crlf "${crlf}")
foreach(schema IN ITEMS +1 0x1 0o1 0b1 0x0_1)
    string(REPLACE "schema-version = 1" "schema-version = ${schema}" changed "${base}")
    accept_manifest("schema-${schema}" "${changed}")
endforeach()
set(literal "schema-version = 1\n[module]\nname = 'sample.app'\nkind = 'bin'\noutput = 'sample'\n")
string(APPEND literal "sources = [\n# entries\n'main.joyeer',\n]\ndependencies = []\n")
accept_manifest(literal-and-array-comments "${literal}")
string(REPLACE "main.joyeer" [=[main\u002Ejoyeer]=] escaped "${base}")
accept_manifest(unicode-escape "${escaped}")
string(REPLACE "kind = \"bin\"\noutput = \"sample\"" "kind = 'source'" source "${base}")
accept_manifest(source-module "${source}")
message(STATUS "joypm single-module strict manifests, legacy migration and exact diagnostics passed")
