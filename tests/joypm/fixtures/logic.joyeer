private func validProject(project: borrowing Project): Bool {
    var index = 0
    while index < project.modules.count {
        if project.modules[index].directory != pathDirectory(path: project.modules[index].path) {
            return false
        }
        if project.modules[index].dependencyIndexes.count != project.modules[index].spec.dependencies.count {
            return false
        }
        var edge = 0
        while edge < project.modules[index].dependencyIndexes.count {
            let destination = project.modules[index].dependencyIndexes[edge]
            if destination < 0 || destination >= project.modules.count { return false }
            if project.modules[destination].spec.name != project.modules[index].spec.dependencies[edge] {
                return false
            }
            edge = edge + 1
        }
        index = index + 1
    }
    return true
}

private func manifestBoundary(args: [String]): Int {
    if args.count < 2 { return 21 }
    if args[1] == "project" {
        let options = match parseCli(args: ["check", "--compiler", "unused",
            "--workspace", args[0]]) {
            .Ok(value) => value,
            .Err(_) => { return 29 },
        }
        return match loadProject(options: options) {
            .Ok(project) => {
                if args.count != 3 || decimal(value: project.modules.count) != args[2] { return 30 }
                if !validProject(project: project) { return 32 }
                print(value: "project ok: modules=" + decimal(value: project.modules.count))
                return 0
            },
            .Err(_) => 31,
        }
    }
    let source = match readFileUtf8(path: args[0]) {
        .Ok(contents) => contents,
        .Err(_) => { return 22 },
    }
    if args[1] == "workspace" {
        return match parseWorkspace(contents: source) {
            .Ok(members) => {
                if args.count != 3 || decimal(value: members.count) != args[2] { return 23 }
                print(value: "workspace ok: members=" + decimal(value: members.count))
                return 0
            },
            .Err(_) => 24,
        }
    }
    return match parseManifest(contents: source) {
        .Ok(parsed) => {
            if args.count != 3 || args[1] != "accept" || parsed.name != args[2] { return 25 }
            print(value: "manifest ok: sources=" + decimal(value: parsed.sources.count) +
                " name=" + decimal(value: parsed.name.count))
            return 0
        },
        .Err(error) => {
            if args.count != 4 || args[1] != "reject" { return 26 }
            if error.message != args[2] { return 27 }
            if decimal(value: error.pos) != args[3] { return 28 }
            print(value: "manifest rejected at byte " + decimal(value: error.pos))
            return 0
        },
    }
}

func main(args: [String]): Int {
    if args.count != 0 { return manifestBoundary(args: args) }
    let help = match parseCli(args: ["--help"]) { .Ok(_) => true, .Err(_) => false }
    if !help { return 11 }
    let duplicate = match parseCli(args: ["build", "--compiler", "a", "--compiler", "b"]) {
        .Ok(_) => false, .Err(_) => true,
    }
    if !duplicate { return 12 }
    let unknown = match parseCli(args: ["not-a-command"]) { .Ok(_) => false, .Err(_) => true }
    if !unknown { return 13 }
    let defaultManifest = match parseCli(args: ["check", "--compiler", "unused"]) {
        .Ok(options) => options.manifestPath == "project.toml",
        .Err(_) => false,
    }
    if !defaultManifest { return 17 }
    let explicitManifest = match parseCli(args: ["check", "--compiler", "unused",
        "--manifest-path", "custom.toml"]) {
        .Ok(options) => options.manifestPath == "custom.toml",
        .Err(_) => false,
    }
    if !explicitManifest { return 18 }
    let source = "schema-version = 1\n[module]\nname = 'logic.app'\nkind = 'bin'\n" +
        "output = 'logic'\nsources = ['main.joyeer']\ndependencies = []\n"
    let valid = match parseManifest(contents: source) { .Ok(_) => true, .Err(_) => false }
    if !valid { return 14 }
    let trailing = match parseManifest(contents: source + "@") { .Ok(_) => false, .Err(_) => true }
    if !trailing { return 15 }
    let workspace = match parseWorkspace(contents: "schema-version = 1\n[workspace]\nmembers = ['.', 'core']\n") {
        .Ok(members) => members.count == 2, .Err(_) => false,
    }
    if !workspace { return 16 }
    print(value: "joypm logic ok")
    return 0
}
