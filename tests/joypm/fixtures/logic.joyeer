// Compiled in joypm.app with the bootstrap sources except their entry file.
// Boundary manifests are generated by CMake, not by a compiler subprocess.
// Accepted cases must finish graph validation, not merely scan a large array.
private func manifestBoundary(args: [String]): Int {
    if args.count < 2 { return 21 }
    let source = match readFileUtf8(path: args[0]) {
        .Ok(contents) => contents,
        .Err(_) => { return 22 },
    }
    return match parseManifest(contents: source) {
        .Ok(parsed) => {
            if args.count != 3 || args[1] != "accept" { return 23 }
            if parsed.version != args[2] { return 24 }
            if parsed.modules.count == 0 { return 25 }
            print(value: "manifest ok: modules=" + decimal(value: parsed.modules.count) +
                " targets=" + decimal(value: parsed.targets.count) +
                " sources=" + decimal(value: parsed.modules[0].sources.count) +
                " version=" + decimal(value: parsed.version.count))
            return 0
        },
        .Err(error) => {
            if args.count != 4 || args[1] != "reject" { return 26 }
            if error.message != args[2] { return 27 }
            if decimal(value: error.pos) != args[3] { return 28 }
            print(value: "manifest rejected at byte " + decimal(value: error.pos))
            return 0
        },
    }
}

func main(args: [String]): Int {
    if args.count != 0 { return manifestBoundary(args: args) }
    let help = match parseCli(args: ["--help"]) {
        .Ok(_) => true,
        .Err(_) => false,
    }
    if !help { return 11 }
    let duplicate = match parseCli(args: ["build", "--compiler", "a",
        "--compiler", "b"]) {
        .Ok(_) => false,
        .Err(_) => true,
    }
    if !duplicate { return 12 }
    let unknown = match parseCli(args: ["not-a-command"]) {
        .Ok(_) => false,
        .Err(_) => true,
    }
    if !unknown { return 13 }
    let source = "schema-version = 1\n[package]\nname = \"logic\"\n" +
        "version = \"0.1.0\"\n[[modules]]\nname = \"logic.app\"\n" +
        "sources = [\"main.joyeer\"]\ndependencies = []\n[[targets]]\n" +
        "name = \"logic\"\nkind = \"bin\"\nmodule = \"logic.app\"\n"
    let valid = match parseManifest(contents: source) {
        .Ok(_) => true,
        .Err(_) => false,
    }
    if !valid { return 14 }
    let trailing = match parseManifest(contents: source + "@") {
        .Ok(_) => false,
        .Err(_) => true,
    }
    if !trailing { return 15 }
    print(value: "joypm logic ok")
    return 0
}