cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")

set(no_tests "${work}/no test modules")
jp_copy_project(single "${no_tests}")
jp_call(0 "${outside}" test --compiler "${JOYEER_EXECUTABLE}" --manifest-path "${no_tests}/joyeer.toml")
jp_contains("${jp_out}" "0 tests")
jp_no_outputs("${no_tests}")
jp_call(2 "${outside}" test --compiler "${JOYEER_EXECUTABLE}" --manifest-path "${no_tests}/joyeer.toml" --module missing)

function(write_test_project directory)
    file(MAKE_DIRECTORY "${directory}")
    foreach(pair IN ITEMS "z_after:after:z-after" "c_build:invalid:c-build" "b_fail:fail:b-fail" "a_pass:pass:a-pass")
        string(REPLACE ":" ";" fields "${pair}")
        list(GET fields 0 name)
        list(GET fields 1 fixture)
        list(GET fields 2 output)
        file(MAKE_DIRECTORY "${directory}/${fixture}")
        configure_file("${FIXTURE_DIR}/${fixture}.joyeer" "${directory}/${fixture}/main.joyeer" COPYONLY)
        jp_write_module("${directory}/${fixture}" "suite.${name}" test "${output}" "'main.joyeer'" "")
    endforeach()
    jp_write_workspace("${directory}" "'after', 'invalid', 'fail', 'pass'")
endfunction()

set(package "${work}/test suite")
write_test_project("${package}")
jp_call(1 "${outside}" test --compiler "${JOYEER_EXECUTABLE}" --workspace "${package}/workspace.toml")
jp_contains("${jp_out}" "pass fixture\n")
jp_contains("${jp_out}" "fail fixture\n")
jp_contains("${jp_out}" "after failure fixture\n")
string(FIND "${jp_out}" "pass fixture\n" pass_at)
string(FIND "${jp_out}" "fail fixture\n" fail_at)
string(FIND "${jp_out}" "after failure fixture\n" after_at)
if(NOT pass_at LESS fail_at OR NOT fail_at LESS after_at)
    jp_fail("Tests did not execute in logical module order or stopped after ordinary failure")
endif()
jp_contains("${jp_err}" "23")
foreach(name IN ITEMS a-pass b-fail z-after)
    jp_artifacts("${package}" debug "${name}" 1)
endforeach()
jp_artifacts("${package}" debug c-build 0)
set(summary "4 tests: 2 passed, 1 build-fail, 1 run-fail")
jp_contains("${jp_out}" "${summary}")
jp_call(1 "${outside}" test --compiler "${JOYEER_EXECUTABLE}" --workspace "${package}/workspace.toml")
jp_contains("${jp_out}" "${summary}")
foreach(name IN ITEMS a-pass b-fail z-after)
    jp_artifacts("${package}" debug "${name}" 2)
endforeach()
jp_call(0 "${outside}" test --compiler "${JOYEER_EXECUTABLE}"
    --workspace "${package}/workspace.toml" --module suite.a_pass --release)
jp_contains("${jp_out}" "1 test: 1 passed, 0 build-fail, 0 run-fail")
jp_absent("${jp_out}" "fail fixture")
jp_artifacts("${package}" release a-pass 1)
jp_artifacts("${package}" release b-fail 0)
set(check_all "${work}/check all modules")
write_test_project("${check_all}")
jp_call(1 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --workspace "${check_all}/workspace.toml")
jp_no_outputs("${check_all}")
set(forward "${work}/forwarded test")
jp_copy_project(single "${forward}")
file(READ "${forward}/joyeer.toml" manifest)
string(REPLACE "kind = \"bin\"" "kind = \"test\"" manifest "${manifest}")
jp_write_bytes("${forward}/joyeer.toml" "${manifest}")
jp_forward(test "${forward}" ascii)
jp_contains("${jp_out}" "1 test: 1 passed, 0 build-fail, 0 run-fail")
message(STATUS "joypm explicit test modules, ordering, selection and failure continuation passed")
