cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")
set(package "${work}/explicit module project")
jp_copy_project(multi "${package}")

function(assert_plan mode profile)
    set(cwd "${work}/${mode} ${profile}")
    file(MAKE_DIRECTORY "${cwd}")
    set(options)
    if(profile STREQUAL "release")
        list(APPEND options --release)
        set(flags "<-O2>\n<-g0>\n")
    else()
        set(flags "<-O0>\n<-gfull>\n")
    endif()
    jp_call(1 "${cwd}" "${mode}" --compiler "${COMPILER_SPY}"
        --workspace "${package}/workspace.toml" --module sample.app --verbose ${options})
    file(READ "${cwd}/compiler-record.txt" record)
    string(REPLACE "\\" "/" record "${record}")
    set(expected "<--module-name>\n<sample.app>\n<--module-source>\n<sample.core=${package}/core/core.joyeer>\n${flags}")
    if(mode STREQUAL "build")
        file(GLOB generations LIST_DIRECTORIES true "${package}/target/${profile}/sample.app/build-*")
        list(LENGTH generations count)
        if(NOT count EQUAL 1)
            jp_fail("Expected one newly claimed ${profile} generation")
        endif()
        list(GET generations 0 generation)
        string(APPEND expected "<-o>\n<${generation}/multi${EXECUTABLE_SUFFIX}>\n")
    else()
        jp_no_outputs("${package}")
    endif()
    string(APPEND expected "<-->\n<${package}/./implementation files/helper.joyeer>\n<${package}/./main.joyeer>\n")
    # Preserve caller coordinates: the root member's explicit '.' remains.
    if(NOT record STREQUAL expected)
        jp_fail("Exact compiler argv mismatch:\nexpected:\n${expected}\nactual:\n${record}")
    endif()
    jp_contains("${jp_err}" "37")
    jp_contains("${jp_err}" "--module-name")
    set(last_record "${record}" PARENT_SCOPE)
endfunction()

assert_plan(check debug)
set(original_record "${last_record}")
jp_write_module("${package}" sample.app bin multi "'implementation files/helper.joyeer', 'main.joyeer'" "'sample.core'")
jp_write_workspace("${package}" "'core', '.'")
set(reorder_cwd "${work}/reordered caller")
file(MAKE_DIRECTORY "${reorder_cwd}")
jp_call(1 "${reorder_cwd}" check --compiler "${COMPILER_SPY}"
    --workspace "${package}/workspace.toml" --module sample.app)
file(READ "${reorder_cwd}/compiler-record.txt" record)
string(REPLACE "\\" "/" record "${record}")
if(NOT record STREQUAL original_record)
    jp_fail("Equivalent member/source orders changed compiler argv")
endif()
assert_plan(check release)
assert_plan(build debug)
assert_plan(build release)
jp_artifacts("${package}" debug multi 0)
jp_artifacts("${package}" release multi 0)

set(identity "${work}/module identities differ from directory order")
jp_write_module("${identity}/first" order.z_root bin ordered "'main.joyeer'" "'order.a_leaf'")
jp_write_module("${identity}/last" order.a_leaf source "" "'main.joyeer'" "")
jp_write_workspace("${identity}" "'last', 'first'")
set(cwd "${work}/module identity caller")
file(MAKE_DIRECTORY "${cwd}")
jp_call(1 "${cwd}" check --compiler "${COMPILER_SPY}"
    --workspace "${identity}/workspace.toml" --module order.z_root)
file(READ "${cwd}/compiler-record.txt" record)
string(REPLACE "\\" "/" record "${record}")
set(expected "<--module-name>\n<order.z_root>\n<--module-source>\n<order.a_leaf=${identity}/last/main.joyeer>\n")
string(APPEND expected "<-O0>\n<-gfull>\n<-->\n<${identity}/first/main.joyeer>\n")
if(NOT record STREQUAL expected)
    jp_fail("Module sorting separated definitions from their owning paths:\nexpected:\n${expected}\nactual:\n${record}")
endif()
jp_no_outputs("${identity}")

set(diamond "${work}/diamond project")
jp_write_module("${diamond}/root" graph.root bin diamond "'z-root.joyeer', 'a-root.joyeer'" "'graph.right', 'graph.left'")
jp_write_module("${diamond}/right" graph.right source "" "'right.joyeer'" "'graph.leaf'")
jp_write_module("${diamond}/left" graph.left source "" "'left.joyeer'" "'graph.leaf'")
jp_write_module("${diamond}/leaf" graph.leaf source "" "'z-leaf.joyeer', 'a-leaf.joyeer'" "")
jp_write_module("${diamond}/unused" graph.unselected source "" "'unused.joyeer'" "")
jp_write_workspace("${diamond}" "'root', 'unused', 'right', 'leaf', 'left'")
set(cwd "${work}/diamond caller")
file(MAKE_DIRECTORY "${cwd}")
jp_call(1 "${cwd}" check --compiler "${COMPILER_SPY}"
    --workspace "${diamond}/workspace.toml" --module graph.root)
file(READ "${cwd}/compiler-record.txt" record)
string(REPLACE "\\" "/" record "${record}")
set(expected "<--module-name>\n<graph.root>\n")
foreach(pair IN ITEMS "graph.leaf=leaf/a-leaf.joyeer" "graph.leaf=leaf/z-leaf.joyeer"
        "graph.left=left/left.joyeer" "graph.right=right/right.joyeer")
    string(REPLACE "=" ";" fields "${pair}")
    list(GET fields 0 module_name)
    list(GET fields 1 source_name)
    string(APPEND expected "<--module-source>\n<${module_name}=${diamond}/${source_name}>\n")
endforeach()
string(APPEND expected "<-O0>\n<-gfull>\n<-->\n<${diamond}/root/a-root.joyeer>\n<${diamond}/root/z-root.joyeer>\n")
if(NOT record STREQUAL expected)
    jp_fail("Diamond exact argv mismatch:\nexpected:\n${expected}\nactual:\n${record}")
endif()
jp_no_outputs("${diamond}")
jp_write_module("${diamond}/unused" graph.unselected source "" "'unused.joyeer'" "'graph.unselected'")
set(cwd "${work}/unselected cycle caller")
file(MAKE_DIRECTORY "${cwd}")
jp_call(1 "${cwd}" build --compiler "${COMPILER_SPY}"
    --workspace "${diamond}/workspace.toml" --module graph.root)
jp_contains("${jp_err}" "module dependency cycle: graph.unselected -> graph.unselected")
jp_contains_path("${jp_err}" "${diamond}/unused/project.toml:")
if(EXISTS "${cwd}/compiler-record.txt")
    jp_fail("An unselected cycle reached the compiler")
endif()
jp_no_outputs("${diamond}")
message(STATUS "joypm exact per-member named-module/source/profile plans passed")
