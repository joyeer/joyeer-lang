import System
import Foundation

// Differential tests for runProcess: each scenario runs through the compiler's
// built-in operation and through the Joyeer implementation in System, and the
// rendered results must be identical. Unqualified names are the built-ins;
// `System.` names are the Joyeer code.

func describeRun(outcome: Result<ProcessStatus, ProcessError>): String {
    return match outcome {
        .Ok(status) => "ok:" + processStatusMessage(status: status),
        .Err(error) => "err:" + processMessage(error: error),
    }
}

func same(label: String, executable: String, arguments: [String], directory: String): Int {
    let expected = describeRun(outcome: runProcess(
        executable: executable, arguments: arguments, workingDirectory: directory))
    let actual = describeRun(outcome: System.runProcess(
        executable: executable, arguments: arguments, workingDirectory: directory))
    if expected == actual { return 0 }
    print(value: "MISMATCH " + label)
    print(value: "  built-in: " + expected)
    print(value: "  Joyeer:   " + actual)
    return 1
}

// The same scenario must also produce the stated result, so a platform where
// both implementations fail identically cannot pass.
func produces(label: String, executable: String, arguments: [String], directory: String, expected: String): Int {
    let actual = describeRun(outcome: System.runProcess(
        executable: executable, arguments: arguments, workingDirectory: directory))
    if actual == expected { return same(label: label, executable: executable, arguments: arguments, directory: directory) }
    print(value: "UNEXPECTED " + label)
    print(value: "  expected: " + expected)
    print(value: "  Joyeer:   " + actual)
    return 1
}

@platform(windows)
func shell(): String { return "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" }

@platform(posix)
func shell(): String { return "/bin/sh" }

@platform(windows)
func exitArguments(code: Int): [String] { return ["-NoProfile", "-NonInteractive", "-Command", "exit " + decimalString(value: code)] }

@platform(posix)
func exitArguments(code: Int): [String] { return ["-c", "exit " + decimalString(value: code)] }

func expectQuoted(label: String, argument: String, expected: String): Int {
    let actual = windowsQuote(argument: argument)
    if actual == expected { return 0 }
    print(value: "QUOTE " + label + ": " + actual + " != " + expected)
    return 1
}

func testQuoting(): Int {
    var failures = 0
    failures = failures + expectQuoted(label: "plain", argument: "abc", expected: "\"abc\"")
    failures = failures + expectQuoted(label: "empty", argument: "", expected: "\"\"")
    failures = failures + expectQuoted(label: "space", argument: "with spaces", expected: "\"with spaces\"")
    failures = failures + expectQuoted(label: "quote", argument: "a\"b", expected: "\"a\\\"b\"")
    failures = failures + expectQuoted(label: "trailing slash", argument: "dir\\", expected: "\"dir\\\\\"")
    failures = failures + expectQuoted(label: "slash before quote", argument: "a\\\"b", expected: "\"a\\\\\\\"b\"")
    failures = failures + expectQuoted(label: "inner slash", argument: "a\\b", expected: "\"a\\b\"")
    failures = failures + expectQuoted(label: "metacharacters", argument: "$&*%x", expected: "\"$&*%x\"")
    failures = failures + expectQuoted(label: "unicode", argument: "é", expected: "\"é\"")
    return failures
}

public func testProcess(): Int {
    var failures = testQuoting()
    let here = "."
    let none: [String] = []
    failures = failures + produces(label: "exit zero", executable: shell(),
        arguments: exitArguments(code: 0), directory: here, expected: "ok:exited with status 0")
    failures = failures + produces(label: "exit seven", executable: shell(),
        arguments: exitArguments(code: 7), directory: here, expected: "ok:exited with status 7")
    failures = failures + same(label: "exit large", executable: shell(),
        arguments: exitArguments(code: 3000), directory: here)
    failures = failures + same(label: "missing executable", executable: shell() + ".missing",
        arguments: none, directory: here)
    failures = failures + same(label: "executable is directory", executable: ".",
        arguments: none, directory: here)
    failures = failures + same(label: "missing directory", executable: shell(),
        arguments: exitArguments(code: 0), directory: "no-such-directory-for-process-test")
    failures = failures + same(label: "directory is a file", executable: shell(),
        arguments: exitArguments(code: 0), directory: shell())
    failures = failures + same(label: "empty executable", executable: "", arguments: none, directory: here)
    failures = failures + same(label: "empty directory", executable: shell(), arguments: none, directory: "")
    failures = failures + same(label: "nul executable", executable: "a\0b", arguments: none, directory: here)
    failures = failures + same(label: "nul argument", executable: shell(), arguments: ["a\0b"], directory: here)
    failures = failures + same(label: "nul directory", executable: shell(), arguments: none, directory: "a\0b")
    return failures + testProcessPlatform()
}

// Windows does not run batch files without a command interpreter (§18.3).
@platform(windows)
func testProcessPlatform(): Int {
    let directory = claimDirectory(prefix: "process-test-")
    if directory == "" { return 1 }
    let script = directory + "\\run.cmd"
    var failures = 0
    let created = describeUnit(outcome: writeFileNew(path: script, contents: "@exit 0\r\n"))
    if created != "ok" {
        print(value: "SETUP batch file: " + created)
        failures = failures + 1
    }
    failures = failures + same(label: "batch file", executable: script, arguments: [], directory: ".")
    failures = failures + same(label: "empty argument", executable: shell(),
        arguments: ["-NoProfile", "-NonInteractive", "-Command", "exit 0", ""], directory: ".")
    ignoreUnit(outcome: removeFile(path: script))
    ignoreUnit(outcome: removeDirectory(path: directory))
    return failures
}

// A signal is reported as a signal, and a file without the execute bit is a
// permission failure.
@platform(posix)
func testProcessPlatform(): Int {
    let directory = claimDirectory(prefix: "process-test-")
    if directory == "" { return 1 }
    let plain = directory + "/plain"
    var failures = 0
    if describeUnit(outcome: writeFileNew(path: plain, contents: "x")) != "ok" { failures = failures + 1 }
    failures = failures + produces(label: "signal", executable: shell(),
        arguments: ["-c", "kill -9 $$"], directory: ".", expected: "ok:terminated by signal 9")
    failures = failures + same(label: "not executable", executable: plain, arguments: [], directory: ".")
    failures = failures + same(label: "empty argument", executable: shell(),
        arguments: ["-c", "exit 0", ""], directory: ".")
    ignoreUnit(outcome: removeFile(path: plain))
    ignoreUnit(outcome: removeDirectory(path: directory))
    return failures
}
