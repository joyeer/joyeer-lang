import System

func check(name: String, ok: Bool): Int {
    if ok { return 0 }
    print(value: "FAIL: " + name)
    return 1
}

func main(args: [String]): Int {
    var failures = 0

    failures = failures + check(name: "separator slash", ok: (b'/').isPathSeparator(windows: false))
    failures = failures + check(name: "backslash posix", ok: !b'\\'.isPathSeparator(windows: false))
    failures = failures + check(name: "backslash windows", ok: b'\\'.isPathSeparator(windows: true))

    failures = failures + check(name: "dir basic", ok: "a/b/c".pathDirectory(windows: false) == "a/b")
    failures = failures + check(name: "dir bare", ok: "file".pathDirectory(windows: false) == ".")
    failures = failures + check(name: "dir root child", ok: "/file".pathDirectory(windows: false) == "/")
    failures = failures + check(name: "dir windows", ok: "C:\\a\\b".pathDirectory(windows: true) == "C:\\a")
    failures = failures + check(name: "dir drive root", ok: "C:\\file".pathDirectory(windows: true) == "C:\\")
    failures = failures + check(name: "dir drive relative", ok: "C:file".pathDirectory(windows: true) == "C:")
    failures = failures + check(name: "dir posix drive text", ok: "C:file".pathDirectory(windows: false) == ".")

    failures = failures + check(name: "trim trailing", ok: "a/b//".trimDirectoryPath(windows: false) == "a/b")
    failures = failures + check(name: "trim root", ok: "///".trimDirectoryPath(windows: false) == "/")
    failures = failures + check(name: "trim drive root", ok: "C:\\\\".trimDirectoryPath(windows: true) == "C:\\")

    failures = failures + check(name: "fs message",
        ok: .NotFound(2).message() == "not found (platform code 2)")
    failures = failures + check(name: "process message",
        ok: .LaunchFailed(-7).message() == "process launch failed (platform code -7)")
    failures = failures + check(name: "exited status",
        ok: .Exited(23).message() == "exited with status 23")
    failures = failures + check(name: "signaled status",
        ok: .Signaled(9).message() == "terminated by signal 9")

    if failures == 0 { print(value: "System tests passed") }
    return failures
}
