import Compression

func check(condition: Bool, message: String): Result<Void, String> {
    if !condition { return .Err(message) }
    return .Ok(())
}

func testZip(method: Compression.ZipMethod): Result<Void, String> {
    let binary: [UInt8] = [0, 255, 128, 13, 10, 65]
    let entries: [Compression.ZipEntry] = [
        Compression.ZipEntry(name: "nested/data.bin", contents: binary),
        Compression.ZipEntry(name: "empty.txt", contents: []),
    ]
    let archive = match Compression.createZip(entries: entries, method: method, maximumBytes: 4096) {
        .Ok(value) => value,
        .Err(_) => { return .Err("create ZIP failed") },
    }
    let names = match Compression.listZip(archive: archive, maximumEntries: 2, maximumNameBytes: 24) {
        .Ok(value) => value,
        .Err(_) => { return .Err("list ZIP failed") },
    }
    check(condition: names.count == 2, message: "wrong entry count")?
    check(condition: names[0] == "nested/data.bin" && names[1] == "empty.txt", message: "wrong entry names")?
    let output = match Compression.extractZipEntry(archive: archive, index: 0, maximumBytes: 6) {
        .Ok(value) => value,
        .Err(_) => { return .Err("extract ZIP failed") },
    }
    check(condition: output.count == binary.count, message: "wrong binary size")?
    var index = 0
    while index < binary.count {
        check(condition: output[index] == binary[index], message: "binary contents changed")?
        index = index + 1
    }
    let empty = match Compression.extractZipEntry(archive: archive, index: 1, maximumBytes: 0) {
        .Ok(value) => value,
        .Err(_) => { return .Err("extract empty entry failed") },
    }
    check(condition: empty.count == 0, message: "empty entry changed")?
    let limited = match Compression.extractZipEntry(archive: archive, index: 0, maximumBytes: 5) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    check(condition: limited, message: "extraction limit ignored")?
    let listLimited = match Compression.listZip(archive: archive, maximumEntries: 1, maximumNameBytes: 100) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    check(condition: listLimited, message: "entry count limit ignored")?
    let nameLimited = match Compression.listZip(archive: archive, maximumEntries: 2, maximumNameBytes: 23) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    check(condition: nameLimited, message: "name byte limit ignored")?
    let missing = match Compression.extractZipEntry(archive: archive, index: 2, maximumBytes: 100) {
        .Err(.EntryNotFound) => true,
        _ => false,
    }
    check(condition: missing, message: "missing entry accepted")?
    let exact = match Compression.createZip(entries: entries, method: method, maximumBytes: archive.count) {
        .Ok(value) => value.count == archive.count,
        .Err(_) => false,
    }
    check(condition: exact, message: "exact archive limit rejected")?
    let tooSmall = match Compression.createZip(entries: entries, method: method, maximumBytes: archive.count - 1) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    return check(condition: tooSmall, message: "archive output limit ignored")
}

func testErrors(): Result<Void, String> {
    let invalid = match Compression.listZip(archive: [0, 1, 2], maximumEntries: 10, maximumNameBytes: 100) {
        .Err(.InvalidArchive) => true,
        _ => false,
    }
    check(condition: invalid, message: "invalid ZIP accepted")?
    let entry = Compression.ZipEntry(name: "file", contents: [65])
    let duplicate = match Compression.createZip(entries: [entry, entry], method: .Deflate, maximumBytes: 1000) {
        .Err(.DuplicateEntry) => true,
        _ => false,
    }
    check(condition: duplicate, message: "duplicate entry accepted")?
    let traversal = Compression.ZipEntry(name: "../file", contents: [65])
    let rejected = match Compression.createZip(entries: [traversal], method: .Stored, maximumBytes: 1000) {
        .Err(.InvalidArgument) => true,
        _ => false,
    }
    check(condition: rejected, message: "parent traversal name accepted")?
    let empty = match Compression.createZip(entries: [], method: .Stored, maximumBytes: 22) {
        .Ok(value) => value,
        .Err(_) => { return .Err("empty archive failed") },
    }
    let names = match Compression.listZip(archive: empty, maximumEntries: 0, maximumNameBytes: 0) {
        .Ok(value) => value,
        .Err(_) => { return .Err("empty archive listing failed") },
    }
    return check(condition: names.count == 0, message: "empty archive has entries")
}

func testEmptyEntryHeaders(): Result<Void, String> {
    let archive = match Compression.createZip(
        entries: [Compression.ZipEntry(name: "empty", contents: [])],
        method: .Stored, maximumBytes: 1000) {
        .Ok(value) => value,
        .Err(_) => { return .Err("empty entry archive failed") },
    }
    var central = 30
    while central + 4 < archive.count {
        if archive[central] == 80 && archive[central + 1] == 75 &&
            archive[central + 2] == 1 && archive[central + 3] == 2 { break }
        central = central + 1
    }
    check(condition: central + 46 < archive.count, message: "missing central directory")?
    var encodedName = archive
    &encodedName[central + 46] = 130
    let invalidUtf8 = match Compression.listZip(archive: encodedName, maximumEntries: 1, maximumNameBytes: 5) {
        .Err(.InvalidArchive) => true,
        _ => false,
    }
    check(condition: invalidUtf8, message: "invalid UTF-8 name accepted")?
    &encodedName[central + 9] = 0
    let legacyEncoding = match Compression.listZip(archive: encodedName, maximumEntries: 1, maximumNameBytes: 5) {
        .Err(.UnsupportedArchive) => true,
        _ => false,
    }
    check(condition: legacyEncoding, message: "legacy name encoding misclassified")?
    var corrupt = archive
    &corrupt[14] = 1
    &corrupt[central + 16] = 1
    let crcRejected = match Compression.extractZipEntry(archive: corrupt, index: 0, maximumBytes: 0) {
        .Err(.InvalidArchive) => true,
        _ => false,
    }
    check(condition: crcRejected, message: "empty entry CRC ignored")?
    var badHeader = archive
    &badHeader[0] = 0
    let headerRejected = match Compression.extractZipEntry(archive: badHeader, index: 0, maximumBytes: 0) {
        .Err(.InvalidArchive) => true,
        _ => false,
    }
    check(condition: headerRejected, message: "empty entry header ignored")?
    var localZip64 = archive
    var index = 18
    while index < 26 {
        &localZip64[index] = 255
        index = index + 1
    }
    let zip64Rejected = match Compression.extractZipEntry(archive: localZip64, index: 0, maximumBytes: 0) {
        .Err(.UnsupportedArchive) => true,
        _ => false,
    }
    return check(condition: zip64Rejected, message: "local ZIP64 size sentinel accepted")
}

func sameBytes(left: [UInt8], right: [UInt8]): Bool {
    if left.count != right.count { return false }
    var index = 0
    while index < left.count {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

func entriesOf(archive: [UInt8]): Result<[Compression.ZipEntryInfo], String> {
    return match Compression.zipEntries(archive: archive, maximumEntries: 1000, maximumNameBytes: 100000) {
        .Ok(value) => .Ok(value),
        .Err(_) => .Err("entry listing failed"),
    }
}

func testEntryMetadata(method: Compression.ZipMethod): Result<Void, String> {
    var repeated: [UInt8] = []
    var count = 0
    while count < 2000 {
        &repeated.append(element: 65)
        count += 1
    }
    let checkValue: [UInt8] = [49, 50, 51, 52, 53, 54, 55, 56, 57]
    let archive = match Compression.createZip(entries: [
            Compression.ZipEntry(name: "check.txt", contents: checkValue),
            Compression.ZipEntry(name: "empty", contents: []),
            Compression.ZipEntry(name: "dir/repeated.txt", contents: repeated),
        ], method: method, maximumBytes: 100000) {
        .Ok(value) => value,
        .Err(_) => { return .Err("create ZIP failed") },
    }
    let entries = entriesOf(archive: archive)?
    check(condition: entries.count == 3, message: "wrong metadata count")?
    check(condition: entries[0].name == "check.txt" && entries[2].name == "dir/repeated.txt",
        message: "wrong metadata names")?
    check(condition: !entries[0].isDirectory && entries[0].isSupported, message: "wrong entry flags")?
    check(condition: entries[0].size == 9, message: "wrong size")?
    check(condition: entries[0].crc32 == 0xCBF43926, message: "wrong CRC-32")?
    check(condition: entries[1].size == 0 && entries[1].crc32 == 0, message: "wrong empty metadata")?
    check(condition: entries[2].size == 2000, message: "wrong large size")?
    let sizing = match method {
        .Stored => check(condition: entries[2].compressedSize == 2000, message: "stored size changed"),
        .Deflate => check(condition: entries[2].compressedSize < 200, message: "deflate did not shrink"),
    }
    sizing?

    check(condition: sameBytes(left: readEntry(archive: archive, entry: entries[0])?, right: checkValue),
        message: "wrong first entry contents")?
    let emptyContents = readEntry(archive: archive, entry: entries[1])?
    check(condition: emptyContents.count == 0, message: "wrong empty contents")?
    check(condition: sameBytes(left: readEntry(archive: archive, entry: entries[2])?, right: repeated),
        message: "wrong repeated contents")?
    let limited = match Compression.readZipEntry(archive: archive, entry: entries[2], maximumBytes: 1999) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    check(condition: limited, message: "read limit ignored")?
    let exact = match Compression.readZipEntry(archive: archive, entry: entries[2], maximumBytes: 2000) {
        .Ok(value) => value.count == 2000,
        .Err(_) => false,
    }
    check(condition: exact, message: "exact read limit rejected")?
    let negative = match Compression.readZipEntry(archive: archive, entry: entries[0], maximumBytes: -1) {
        .Err(.InvalidArgument) => true,
        _ => false,
    }
    check(condition: negative, message: "negative read limit accepted")?
    let entryLimited = match Compression.zipEntries(archive: archive, maximumEntries: 2, maximumNameBytes: 1000) {
        .Err(.LimitExceeded) => true,
        _ => false,
    }
    check(condition: entryLimited, message: "metadata count limit ignored")?

    // An entry applied to a different archive is rejected, not misread.
    let other = match Compression.createZip(entries: [
            Compression.ZipEntry(name: "check.txt", contents: [57, 56, 55, 54, 53, 52, 51, 50, 49]),
        ], method: method, maximumBytes: 1000) {
        .Ok(value) => value,
        .Err(_) => { return .Err("create other ZIP failed") },
    }
    let mismatched = match Compression.readZipEntry(archive: other, entry: entries[0], maximumBytes: 100) {
        .Err(_) => true,
        .Ok(_) => false,
    }
    check(condition: mismatched, message: "entry accepted for a different archive")?
    let outside = match Compression.readZipEntry(archive: other, entry: entries[2], maximumBytes: 5000) {
        .Err(_) => true,
        .Ok(_) => false,
    }
    return check(condition: outside, message: "out-of-range entry accepted")
}

func readEntry(archive: [UInt8], entry: Compression.ZipEntryInfo): Result<[UInt8], String> {
    return match Compression.readZipEntry(archive: archive, entry: entry, maximumBytes: 100000) {
        .Ok(value) => .Ok(value),
        .Err(_) => .Err("read entry failed"),
    }
}

func testDirectoryEntry(): Result<Void, String> {
    var archive = match Compression.createZip(
        entries: [Compression.ZipEntry(name: "folderX", contents: [])],
        method: .Stored, maximumBytes: 1000) {
        .Ok(value) => value,
        .Err(_) => { return .Err("create directory ZIP failed") },
    }
    // Turn the last name byte into '/', in both the local and central headers.
    var central = 30
    while central + 4 < archive.count {
        if archive[central] == 80 && archive[central + 1] == 75 &&
            archive[central + 2] == 1 && archive[central + 3] == 2 { break }
        central += 1
    }
    &archive[30 + 6] = 47
    &archive[central + 46 + 6] = 47
    let entries = entriesOf(archive: archive)?
    check(condition: entries.count == 1 && entries[0].name == "folder/", message: "directory name wrong")?
    check(condition: entries[0].isDirectory, message: "directory not detected")?
    let refused = match Compression.readZipEntry(archive: archive, entry: entries[0], maximumBytes: 10) {
        .Err(.UnsupportedArchive) => true,
        _ => false,
    }
    return check(condition: refused, message: "directory entry was readable")
}

func testManyEntries(): Result<Void, String> {
    var items: [Compression.ZipEntry] = []
    var number = 0
    while number < 300 {
        let low = number % 256
        let high = number / 256
        &items.append(element: Compression.ZipEntry(
            name: "entry-" + decimal(value: number), contents: [low as UInt8, high as UInt8]))
        number += 1
    }
    let archive = match Compression.createZip(entries: items, method: .Deflate, maximumBytes: 1000000) {
        .Ok(value) => value,
        .Err(_) => { return .Err("create many-entry ZIP failed") },
    }
    let entries = entriesOf(archive: archive)?
    check(condition: entries.count == 300, message: "wrong many-entry count")?
    number = 0
    while number < entries.count {
        let contents = readEntry(archive: archive, entry: entries[number])?
        check(condition: contents.count == 2 && contents[0] == (number % 256) as UInt8 &&
            contents[1] == (number / 256) as UInt8, message: "wrong many-entry contents")?
        number += 1
    }
    return .Ok(())
}

func decimal(value: Int): String {
    if value == 0 { return "0" }
    var remaining = value
    var text = ""
    let digits = "0123456789"
    while remaining > 0 {
        text = byteToString(value: digits[remaining % 10]) + text
        remaining /= 10
    }
    return text
}

func runTests(): Result<Void, String> {
    testZip(method: .Stored)?
    testZip(method: .Deflate)?
    testEntryMetadata(method: .Stored)?
    testEntryMetadata(method: .Deflate)?
    testDirectoryEntry()?
    testManyEntries()?
    testErrors()?
    testEmptyEntryHeaders()?
    var repeated: [UInt8] = []
    var index = 0
    while index < 8192 {
        &repeated.append(element: 65)
        index = index + 1
    }
    let compressed = match Compression.createZip(
        entries: [Compression.ZipEntry(name: "repeated.txt", contents: repeated)],
        method: .Deflate, maximumBytes: 8192) {
        .Ok(value) => value,
        .Err(_) => { return .Err("DEFLATE compression failed") },
    }
    check(condition: compressed.count < 1024, message: "DEFLATE did not compress repetitive data")?
    return .Ok(())
}

func main(args: [String]): Int {
    if args.count != 0 { return 2 }
    return match runTests() {
        .Ok(_) => {
            print(value: "Compression ZIP tests passed")
            0
        },
        .Err(message) => {
            print(value: message)
            1
        },
    }
}
