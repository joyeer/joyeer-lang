import Foundation

func check(name: String, ok: Bool): Int {
    if ok { return 0 }
    print(value: "FAIL: " + name)
    return 1
}

func zeroBytes(count: Int): [UInt8] {
    var bytes: [UInt8] = []
    var index = 0
    while index < count {
        &bytes.append(element: 0)
        index = index + 1
    }
    return bytes
}

func main(args: [String]): Int {
    var failures = 0

    failures = failures + check(name: "decimal zero", ok: 0.decimalString() == "0")
    failures = failures + check(name: "decimal positive", ok: 1234.decimalString() == "1234")
    failures = failures + check(name: "decimal negative", ok: (-56).decimalString() == "-56")
    failures = failures + check(name: "decimal max",
        ok: 9223372036854775807.decimalString() == "9223372036854775807")
    failures = failures + check(name: "decimal min",
        ok: (-9223372036854775807 - 1).decimalString() == "-9223372036854775808")

    failures = failures + check(name: "substring middle", ok: "abcdef".substring(start: 1, end: 4) == "bcd")
    failures = failures + check(name: "substring clamp", ok: "abc".substring(start: -5, end: 99) == "abc")
    failures = failures + check(name: "substring empty", ok: "abc".substring(start: 2, end: 2) == "")
    failures = failures + check(name: "substring inverted", ok: "abc".substring(start: 3, end: 1) == "")

    failures = failures + check(name: "utf8 ascii", ok: "hello".isValidUtf8())
    failures = failures + check(name: "utf8 empty", ok: "".isValidUtf8())
    failures = failures + check(name: "utf8 multibyte", ok: "é中😀".isValidUtf8())
    failures = failures + check(name: "utf8 lone continuation",
        ok: !byteToString(value: 128).isValidUtf8())
    failures = failures + check(name: "utf8 truncated",
        ok: !(byteToString(value: 226) + byteToString(value: 130)).isValidUtf8())
    failures = failures + check(name: "utf8 overlong",
        ok: !(byteToString(value: 192) + byteToString(value: 128)).isValidUtf8())
    failures = failures + check(name: "utf8 surrogate",
        ok: !(byteToString(value: 237) + byteToString(value: 160) + byteToString(value: 128)).isValidUtf8())

    // CRC-32 vectors are zlib's crc32().
    failures = failures + check(name: "crc32 empty", ok: "".utf8().crc32() == 0)
    failures = failures + check(name: "crc32 a", ok: "a".utf8().crc32() == 0xE8B7BE43)
    failures = failures + check(name: "crc32 abc", ok: "abc".utf8().crc32() == 0x352441C2)
    failures = failures + check(name: "crc32 check value",
        ok: "123456789".utf8().crc32() == 0xCBF43926)
    failures = failures + check(name: "crc32 sentence",
        ok: "The quick brown fox jumps over the lazy dog".utf8().crc32() == 0x414FA339)
    failures = failures + check(name: "crc32 high bytes",
        ok: [0xFF, 0xFF, 0xFF, 0xFF].crc32() == 0xFFFFFFFF)
    failures = failures + check(name: "crc32 zeros", ok: zeroBytes(count: 32).crc32() == 0x190A55AD)

    var everyByte: [UInt8] = []
    var value = 0
    while value < 256 {
        &everyByte.append(element: value as UInt8)
        value = value + 1
    }
    failures = failures + check(name: "crc32 every byte", ok: everyByte.crc32() == 0x29058C73)

    var repeated: [UInt8] = []
    var count = 0
    while count < 1000 {
        &repeated.append(element: b'a')
        count = count + 1
    }
    failures = failures + check(name: "crc32 long input", ok: repeated.crc32() == 0x9A38DA03)

    let partial = "1234".utf8().crc32Update(checksum: 0)
    failures = failures + check(name: "crc32 incremental",
        ok: "56789".utf8().crc32Update(checksum: partial) == 0xCBF43926)
    failures = failures + check(name: "crc32 empty chunk keeps checksum",
        ok: "".utf8().crc32Update(checksum: partial) == partial)

    if failures == 0 { print(value: "Foundation tests passed") }
    return failures
}
