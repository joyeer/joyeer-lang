cmake_minimum_required(VERSION 3.20)

foreach(required IN ITEMS JOYEER_EXECUTABLE INPUT_FILE INPUT_LIBRARY ALTERNATE_LIBRARY OUTPUT_FILE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

get_filename_component(directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}/reserved")
if(WIN32)
    set(prefix "")
    set(suffix ".lib")
    set(platform_name kernel32)
elseif(APPLE)
    set(prefix "lib")
    set(suffix ".a")
    set(platform_name System)
else()
    set(prefix "lib")
    set(suffix ".a")
    set(platform_name c)
endif()

configure_file("${INPUT_LIBRARY}" "${directory}/reserved/${prefix}to_library${suffix}" COPYONLY)
file(MAKE_DIRECTORY "${directory}/alternate")
configure_file("${ALTERNATE_LIBRARY}" "${directory}/alternate/${prefix}to_library${suffix}" COPYONLY)
foreach(level IN ITEMS 0 2)
    foreach(first IN ITEMS reserved alternate)
        if(first STREQUAL "reserved")
            set(second alternate)
            set(EXPECTED_OUTPUT "42\n")
        else()
            set(second reserved)
            set(EXPECTED_OUTPUT "91\n")
        endif()
        set(COMPILER_ARGS --module-name test.named_library --runtime-module test.named_library
            --link-path "${directory}/${first}" --link-path "${directory}/${second}" --link-lib to_library -O${level} -g0)
        include("${CMAKE_CURRENT_LIST_DIR}/../../scripts/cmake/verifyNativeExecutable.cmake")
    endforeach()
endforeach()

file(MAKE_DIRECTORY "${directory}/collision")
set(protected "${directory}/collision/${prefix}${platform_name}${suffix}")
configure_file("${INPUT_LIBRARY}" "${protected}" COPYONLY)
file(SHA256 "${protected}" original)
execute_process(
    COMMAND "${JOYEER_EXECUTABLE}" ${COMPILER_ARGS} --link-path "${directory}/collision"
        -o "${protected}" -- "${INPUT_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status STREQUAL "0")
    message(FATAL_ERROR "Native provider collision was not rejected")
endif()
string(FIND "${output}${error}" "error[linker.file-error]: native output path collides" diagnostic_at)
if(diagnostic_at LESS 0)
    message(FATAL_ERROR "Linking failed for a different reason (${status}):\n${output}${error}")
endif()
file(SHA256 "${protected}" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "Rejected linking changed the protected native library")
endif()
