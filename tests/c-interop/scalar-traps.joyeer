func main(args: [String]): Int {
    if args[0] == "addition" {
        let value: Int8 = 127
        print(value: value + 1)
    } else if args[0] == "division" {
        let value: Int16 = -32768
        print(value: value / -1)
    } else if args[0] == "remainder" {
        let value: Int32 = -2147483648
        print(value: value % -1)
    } else if args[0] == "unsigned" {
        let value: UInt64 = 18446744073709551615
        print(value: value / 0)
    }
    return 0
}
