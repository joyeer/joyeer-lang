execute_process(
    COMMAND "${LLVM_NM}" --extern-only --defined-only --format=posix "${OBJECT_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE defined ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect C interop definitions: ${errors}")
endif()
string(REPLACE "\r" "" defined "${defined}")
string(REGEX MATCHALL "[^\n]+" definitions "${defined}")
list(LENGTH definitions count)
if(NOT count EQUAL 5)
    message(FATAL_ERROR "Expected exactly five public C exports, found: ${defined}")
endif()
foreach(line IN LISTS definitions)
    if(NOT line MATCHES "^_?joyeer_fixture_(identity|zero|store|load|arguments) ")
        message(FATAL_ERROR "Unexpected public symbol in runtime object: ${line}")
    endif()
endforeach()

execute_process(
    COMMAND "${LLVM_NM}" --extern-only --undefined-only --format=posix "${OBJECT_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE undefined ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect C interop references: ${errors}")
endif()
string(REPLACE "\r" "" undefined "${undefined}")
string(REGEX MATCHALL "[^\n]+" references "${undefined}")
list(LENGTH references count)
if(NOT count EQUAL 5)
    message(FATAL_ERROR "Expected exactly five C imports, found: ${undefined}")
endif()
foreach(line IN LISTS references)
    if(NOT line MATCHES "^_?c_fixture_(identity|zero|store|load|arguments) ")
        message(FATAL_ERROR "Unexpected dependency in leaf runtime object: ${line}")
    endif()
endforeach()
