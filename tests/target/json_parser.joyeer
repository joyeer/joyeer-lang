// json_parser.joyeer
//
// Target: a complete JSON parser written in Joyeer v0.1
// Design: struct + extension blocks + func T.method() prefix
//
// ============================================================
// LANGUAGE FEATURES REQUIRED:
//
//   Existing:
//     - let / var
//     - Int, Bool, String types
//     - if / else if / else
//     - while loop
//     - return
//     - print(message:)
//     - [T]() array creation, arr[index], arr.size()
//     - [K:V]() dict creation, dict[key] = value
//     - String + String concatenation
//     - ==, !=, &&, <, >, <=, >= operators
//
//   New:
//     [1] struct (value type with named fields)
//     [2] struct literal: Parser { input: x, pos: 0 }
//     [3] extension block: extension T { func ... }
//     [4] type-prefix func: func T.method() { ... }
//     [5] self (implicit first parameter in extension/type-prefix)
//     [6] enum declaration + associated values
//     [7] match statement + destructuring
//     [8] Char type + char literals ('x')
//     [9] Char comparison (==, !=, >=, <=)
//     [10] Char arithmetic (ch - '0' => Int)
//     [11] || operator
//     [12] String escape sequences: \n \t \\ \"
//     [13] func Int.toString(): String
//     [14] func Char.toString(): String
//     [15] func String.len(): Int
//     [16] func String.charAt(index:): Char
//     [17] func Array.append(value:)
// ============================================================

// ===== [6] JSON Value — enum with associated values =====

enum JsonValue {
    Null,
    Bool(Bool),
    Number(Int),
    Str(String),
    Array([JsonValue]),
    Object([String:JsonValue]),
}

// ===== [1] Parser — struct, data only =====

struct Parser {
    var input: String
    var pos: Int
}

// ===== [3] extension — low-level helpers grouped together =====

extension Parser {

    func peek(): Char {
        return self.input.charAt(index: self.pos)
    }

    func advance(): Char {
        let ch = self.input.charAt(index: self.pos)
        self.pos = self.pos + 1
        return ch
    }

    func hasMore(): Bool {
        return self.pos < self.input.len()
    }

    func skipWhitespace() {
        while self.hasMore() {
            let ch = self.peek()
            if ch != ' ' && ch != '\n' && ch != '\t' && ch != '\r' {
                return
            }
            self.pos = self.pos + 1
        }
    }

    func expect(ch: Char) {
        let actual = self.advance()
        if actual != ch {
            print(message: "error: unexpected character")
        }
    }
}

// ===== [3] extension — recursive descent parser =====

extension Parser {

    func parse(): JsonValue {
        self.skipWhitespace()
        let value = self.parseValue()
        self.skipWhitespace()
        return value
    }

    func parseValue(): JsonValue {
        self.skipWhitespace()
        let ch = self.peek()

        if ch == '"' {
            return self.parseString()
        } else if ch == '{' {
            return self.parseObject()
        } else if ch == '[' {
            return self.parseArray()
        } else if ch == 't' || ch == 'f' {
            return self.parseBool()
        } else if ch == 'n' {
            return self.parseNull()
        } else if ch == '-' || (ch >= '0' && ch <= '9') {
            return self.parseNumber()
        } else {
            print(message: "error: unexpected character in value")
            return JsonValue.Null
        }
    }

    func parseNull(): JsonValue {
        self.expect(ch: 'n')
        self.expect(ch: 'u')
        self.expect(ch: 'l')
        self.expect(ch: 'l')
        return JsonValue.Null
    }

    func parseBool(): JsonValue {
        if self.peek() == 't' {
            self.expect(ch: 't')
            self.expect(ch: 'r')
            self.expect(ch: 'u')
            self.expect(ch: 'e')
            return JsonValue.Bool(true)
        } else {
            self.expect(ch: 'f')
            self.expect(ch: 'a')
            self.expect(ch: 'l')
            self.expect(ch: 's')
            self.expect(ch: 'e')
            return JsonValue.Bool(false)
        }
    }

    func parseNumber(): JsonValue {
        var num = 0
        var negative = false

        if self.peek() == '-' {
            negative = true
            self.advance()
        }

        while self.hasMore() && self.peek() >= '0' && self.peek() <= '9' {
            let digit = self.advance() - '0'
            num = num * 10 + digit
        }

        if negative {
            num = 0 - num
        }

        return JsonValue.Number(num)
    }

    func parseStringRaw(): String {
        self.expect(ch: '"')
        var result = ""

        while self.hasMore() && self.peek() != '"' {
            let ch = self.advance()

            if ch == '\\' {
                let escaped = self.advance()
                if escaped == 'n' {
                    result = result + "\n"
                } else if escaped == 't' {
                    result = result + "\t"
                } else if escaped == '"' {
                    result = result + "\""
                } else if escaped == '\\' {
                    result = result + "\\"
                }
            } else {
                result = result + ch.toString()
            }
        }

        self.expect(ch: '"')
        return result
    }

    func parseString(): JsonValue {
        return JsonValue.Str(self.parseStringRaw())
    }

    func parseArray(): JsonValue {
        self.expect(ch: '[')
        var elements = [JsonValue]()

        self.skipWhitespace()
        if self.peek() != ']' {
            elements.append(value: self.parseValue())

            self.skipWhitespace()
            while self.peek() == ',' {
                self.advance()
                elements.append(value: self.parseValue())
                self.skipWhitespace()
            }
        }

        self.expect(ch: ']')
        return JsonValue.Array(elements)
    }

    func parseObject(): JsonValue {
        self.expect(ch: '{')
        var entries = [String:JsonValue]()

        self.skipWhitespace()
        if self.peek() != '}' {
            self.skipWhitespace()
            let key = self.parseStringRaw()
            self.skipWhitespace()
            self.expect(ch: ':')
            let value = self.parseValue()
            entries[key] = value

            self.skipWhitespace()
            while self.peek() == ',' {
                self.advance()
                self.skipWhitespace()
                let k = self.parseStringRaw()
                self.skipWhitespace()
                self.expect(ch: ':')
                let v = self.parseValue()
                entries[k] = v
                self.skipWhitespace()
            }
        }

        self.expect(ch: '}')
        return JsonValue.Object(entries)
    }
}

// ===== [4] type-prefix func — standalone utility methods =====

func Parser.toString(): String {
    return "Parser(pos: " + self.pos.toString() + ")"
}

// ===== [7] match — display JsonValue =====

func JsonValue.toString(): String {
    match self {
        JsonValue.Null => {
            return "null"
        }
        JsonValue.Bool(b) => {
            if b {
                return "true"
            } else {
                return "false"
            }
        }
        JsonValue.Number(n) => {
            return n.toString()
        }
        JsonValue.Str(s) => {
            return "\"" + s + "\""
        }
        JsonValue.Array(arr) => {
            var result = "["
            var i = 0
            while i < arr.size() {
                if i > 0 {
                    result = result + ", "
                }
                result = result + arr[i].toString()
                i = i + 1
            }
            result = result + "]"
            return result
        }
        JsonValue.Object(map) => {
            return "{object}"
        }
    }
}

// ===== main =====

var input = "{\"name\": \"joyeer\", \"version\": 1, \"active\": true, \"items\": [1, 2, 3]}"
var p = Parser { input: input, pos: 0 }
var result = p.parse()
print(message: result.toString())
// json_parser.joyeer
//
// Target: a complete JSON parser written in Joyeer v0.1
// This file defines what the language MUST support.
//
// Design: struct + free functions (no class)
//   - struct is value type, stack-allocated
//   - methods are just functions taking &/&mut struct as first param
//
// ============================================================
// NEW FEATURES REQUIRED (not in current grammar):
//
//   [1] enum declaration + associated values
//   [2] match statement + destructuring
//   [3] Char type + char literals ('x')
//   [4] Char comparison (==, !=, >=, <=)
//   [5] Char arithmetic (ch - '0' => Int)
//   [6] String methods: len(), charAt(index:)
//   [7] Array method: append(value:)
//   [8] Int method: toString()
//   [9] Char method: toString()
//   [10] || operator
//   [11] String escape sequences: \n \t \\ \"
//   [12] struct (value type with named fields)
//   [13] &mut (mutable reference) for pass-by-reference
//   [14] struct literal construction: Parser { input: x, pos: 0 }
// ============================================================

// ===== [1] JSON Value — enum with associated values =====

enum JsonValue {
    Null,
    Bool(Bool),
    Number(Int),
    Str(String),
    Array([JsonValue]),
    Object([String:JsonValue]),
}

// ===== [12] Parser struct — data only, no methods =====

struct Parser {
    var input: String
    var pos: Int
}

// ===== [14] constructor — returns struct literal =====

func newParser(input: String): Parser {
    return Parser { input: input, pos: 0 }
}

// ===== low-level helpers =====
// All functions take &Parser or &mut Parser

func peek(p: &Parser): Char {
    return p.input.charAt(index: p.pos)
}

func advance(p: &mut Parser): Char {
    let ch = p.input.charAt(index: p.pos)
    p.pos = p.pos + 1
    return ch
}

func hasMore(p: &Parser): Bool {
    return p.pos < p.input.len()
}

func skipWhitespace(p: &mut Parser) {
    while hasMore(p: p) {
        let ch = peek(p: p)
        if ch != ' ' && ch != '\n' && ch != '\t' && ch != '\r' {
            return
        }
        p.pos = p.pos + 1
    }
}

func expect(p: &mut Parser, ch: Char) {
    let actual = advance(p: p)
    if actual != ch {
        print(message: "error: unexpected character")
    }
}

// ===== entry point =====

func parse(p: &mut Parser): JsonValue {
    skipWhitespace(p: p)
    let value = parseValue(p: p)
    skipWhitespace(p: p)
    return value
}

// ===== recursive descent =====

func parseValue(p: &mut Parser): JsonValue {
    skipWhitespace(p: p)
    let ch = peek(p: p)

    if ch == '"' {
        return parseString(p: p)
    } else if ch == '{' {
        return parseObject(p: p)
    } else if ch == '[' {
        return parseArray(p: p)
    } else if ch == 't' || ch == 'f' {
        return parseBool(p: p)
    } else if ch == 'n' {
        return parseNull(p: p)
    } else if ch == '-' || (ch >= '0' && ch <= '9') {
        return parseNumber(p: p)
    } else {
        print(message: "error: unexpected character in value")
        return JsonValue.Null
    }
}

// --- null ---

func parseNull(p: &mut Parser): JsonValue {
    expect(p: p, ch: 'n')
    expect(p: p, ch: 'u')
    expect(p: p, ch: 'l')
    expect(p: p, ch: 'l')
    return JsonValue.Null
}

// --- bool ---

func parseBool(p: &mut Parser): JsonValue {
    if peek(p: p) == 't' {
        expect(p: p, ch: 't')
        expect(p: p, ch: 'r')
        expect(p: p, ch: 'u')
        expect(p: p, ch: 'e')
        return JsonValue.Bool(true)
    } else {
        expect(p: p, ch: 'f')
        expect(p: p, ch: 'a')
        expect(p: p, ch: 'l')
        expect(p: p, ch: 's')
        expect(p: p, ch: 'e')
        return JsonValue.Bool(false)
    }
}

// --- number (integers only for v0.1) ---

func parseNumber(p: &mut Parser): JsonValue {
    var num = 0
    var negative = false

    if peek(p: p) == '-' {
        negative = true
        advance(p: p)
    }

    while hasMore(p: p) && peek(p: p) >= '0' && peek(p: p) <= '9' {
        let digit = advance(p: p) - '0'
        num = num * 10 + digit
    }

    if negative {
        num = 0 - num
    }

    return JsonValue.Number(num)
}

// --- string ---

func parseStringRaw(p: &mut Parser): String {
    expect(p: p, ch: '"')
    var result = ""

    while hasMore(p: p) && peek(p: p) != '"' {
        let ch = advance(p: p)

        if ch == '\\' {
            let escaped = advance(p: p)
            if escaped == 'n' {
                result = result + "\n"
            } else if escaped == 't' {
                result = result + "\t"
            } else if escaped == '"' {
                result = result + "\""
            } else if escaped == '\\' {
                result = result + "\\"
            }
        } else {
            result = result + ch.toString()
        }
    }

    expect(p: p, ch: '"')
    return result
}

func parseString(p: &mut Parser): JsonValue {
    return JsonValue.Str(parseStringRaw(p: p))
}

// --- array ---

func parseArray(p: &mut Parser): JsonValue {
    expect(p: p, ch: '[')
    var elements = [JsonValue]()

    skipWhitespace(p: p)
    if peek(p: p) != ']' {
        elements.append(value: parseValue(p: p))

        skipWhitespace(p: p)
        while peek(p: p) == ',' {
            advance(p: p)
            elements.append(value: parseValue(p: p))
            skipWhitespace(p: p)
        }
    }

    expect(p: p, ch: ']')
    return JsonValue.Array(elements)
}

// --- object ---

func parseObject(p: &mut Parser): JsonValue {
    expect(p: p, ch: '{')
    var entries = [String:JsonValue]()

    skipWhitespace(p: p)
    if peek(p: p) != '}' {
        skipWhitespace(p: p)
        let key = parseStringRaw(p: p)
        skipWhitespace(p: p)
        expect(p: p, ch: ':')
        let value = parseValue(p: p)
        entries[key] = value

        skipWhitespace(p: p)
        while peek(p: p) == ',' {
            advance(p: p)
            skipWhitespace(p: p)
            let k = parseStringRaw(p: p)
            skipWhitespace(p: p)
            expect(p: p, ch: ':')
            let v = parseValue(p: p)
            entries[k] = v
            skipWhitespace(p: p)
        }
    }

    expect(p: p, ch: '}')
    return JsonValue.Object(entries)
}

// ===== [2] match statement — display JsonValue =====

func jsonToString(value: JsonValue): String {
    match value {
        JsonValue.Null => {
            return "null"
        }
        JsonValue.Bool(b) => {
            if b {
                return "true"
            } else {
                return "false"
            }
        }
        JsonValue.Number(n) => {
            return n.toString()
        }
        JsonValue.Str(s) => {
            return "\"" + s + "\""
        }
        JsonValue.Array(arr) => {
            var result = "["
            var i = 0
            while i < arr.size() {
                if i > 0 {
                    result = result + ", "
                }
                result = result + jsonToString(value: arr[i])
                i = i + 1
            }
            result = result + "]"
            return result
        }
        JsonValue.Object(map) => {
            return "{object}"
        }
    }
}

// ===== main =====

var input = "{\"name\": \"joyeer\", \"version\": 1, \"active\": true, \"items\": [1, 2, 3]}"
var p = newParser(input: input)
var result = parse(p: &mut p)
print(message: jsonToString(value: result))
// json_parser.joyeer
//
// Target: a complete JSON parser written in Joyeer v0.1
// This file defines what the language MUST support.
//
// ============================================================
// NEW FEATURES REQUIRED (not in current grammar):
//
//   [1] enum declaration + associated values
//   [2] match statement + destructuring
//   [3] Char type + char literals ('x')
//   [4] Char comparison (==, !=, >=, <=)
//   [5] Char arithmetic (ch - '0' => Int)
//   [6] String methods: len(), charAt(index:)
//   [7] Array method: append(value:)
//   [8] Int method: toString()
//   [9] Char method: toString()
//   [10] || operator
//   [11] String escape sequences: \n \t \\ \"
// ============================================================

// ===== [1] JSON Value — enum with associated values =====

enum JsonValue {
    Null,
    Bool(Bool),
    Number(Int),
    Str(String),
    Array([JsonValue]),
    Object([String:JsonValue]),
}

// ===== JSON Parser =====

class JsonParser {
    var input: String
    var pos: Int

    // existing: init with named parameters
    init(input: String) {
        self.input = input
        self.pos = 0
    }

    // ----- low-level helpers -----

    // [3][6] charAt returns Char
    func peek(): Char {
        return self.input.charAt(index: self.pos)
    }

    func advance(): Char {
        let ch = self.input.charAt(index: self.pos)
        self.pos = self.pos + 1
        return ch
    }

    func hasMore(): Bool {
        return self.pos < self.input.len()
    }

    // [4] Char comparison with !=
    func skipWhitespace() {
        while self.hasMore() {
            let ch = self.peek()
            if ch != ' ' && ch != '\n' && ch != '\t' && ch != '\r' {
                return
            }
            self.pos = self.pos + 1
        }
    }

    func expect(ch: Char) {
        let actual = self.advance()
        if actual != ch {
            print(message: "error: unexpected character")
        }
    }

    // ----- entry point -----

    func parse(): JsonValue {
        self.skipWhitespace()
        let value = self.parseValue()
        self.skipWhitespace()
        return value
    }

    // ----- recursive descent -----

    // [4][10] Char ==, ||, >=, <=
    func parseValue(): JsonValue {
        self.skipWhitespace()
        let ch = self.peek()

        if ch == '"' {
            return self.parseString()
        } else if ch == '{' {
            return self.parseObject()
        } else if ch == '[' {
            return self.parseArray()
        } else if ch == 't' || ch == 'f' {
            return self.parseBool()
        } else if ch == 'n' {
            return self.parseNull()
        } else if ch == '-' || (ch >= '0' && ch <= '9') {
            return self.parseNumber()
        } else {
            print(message: "error: unexpected character in value")
            return JsonValue.Null
        }
    }

    // --- null ---

    func parseNull(): JsonValue {
        self.expect(ch: 'n')
        self.expect(ch: 'u')
        self.expect(ch: 'l')
        self.expect(ch: 'l')
        return JsonValue.Null
    }

    // --- bool ---

    func parseBool(): JsonValue {
        if self.peek() == 't' {
            self.expect(ch: 't')
            self.expect(ch: 'r')
            self.expect(ch: 'u')
            self.expect(ch: 'e')
            return JsonValue.Bool(true)
        } else {
            self.expect(ch: 'f')
            self.expect(ch: 'a')
            self.expect(ch: 'l')
            self.expect(ch: 's')
            self.expect(ch: 'e')
            return JsonValue.Bool(false)
        }
    }

    // --- number (integers only for v0.1) ---
    // [5] Char arithmetic: ch - '0' => Int

    func parseNumber(): JsonValue {
        var num = 0
        var negative = false

        if self.peek() == '-' {
            negative = true
            self.advance()
        }

        while self.hasMore() && self.peek() >= '0' && self.peek() <= '9' {
            let digit = self.advance() - '0'
            num = num * 10 + digit
        }

        if negative {
            num = 0 - num
        }

        return JsonValue.Number(num)
    }

    // --- string ---
    // [9] ch.toString(), [11] escape sequences

    func parseStringRaw(): String {
        self.expect(ch: '"')
        var result = ""

        while self.hasMore() && self.peek() != '"' {
            let ch = self.advance()

            if ch == '\\' {
                let escaped = self.advance()
                if escaped == 'n' {
                    result = result + "\n"
                } else if escaped == 't' {
                    result = result + "\t"
                } else if escaped == '"' {
                    result = result + "\""
                } else if escaped == '\\' {
                    result = result + "\\"
                }
            } else {
                result = result + ch.toString()
            }
        }

        self.expect(ch: '"')
        return result
    }

    func parseString(): JsonValue {
        return JsonValue.Str(self.parseStringRaw())
    }

    // --- array ---
    // [7] arr.append(value:)

    func parseArray(): JsonValue {
        self.expect(ch: '[')
        var elements = [JsonValue]()

        self.skipWhitespace()
        if self.peek() != ']' {
            elements.append(value: self.parseValue())

            self.skipWhitespace()
            while self.peek() == ',' {
                self.advance()
                elements.append(value: self.parseValue())
                self.skipWhitespace()
            }
        }

        self.expect(ch: ']')
        return JsonValue.Array(elements)
    }

    // --- object ---
    // existing: dict[key] = value

    func parseObject(): JsonValue {
        self.expect(ch: '{')
        var entries = [String:JsonValue]()

        self.skipWhitespace()
        if self.peek() != '}' {
            self.skipWhitespace()
            let key = self.parseStringRaw()
            self.skipWhitespace()
            self.expect(ch: ':')
            let value = self.parseValue()
            entries[key] = value

            self.skipWhitespace()
            while self.peek() == ',' {
                self.advance()
                self.skipWhitespace()
                let k = self.parseStringRaw()
                self.skipWhitespace()
                self.expect(ch: ':')
                let v = self.parseValue()
                entries[k] = v
                self.skipWhitespace()
            }
        }

        self.expect(ch: '}')
        return JsonValue.Object(entries)
    }
}

// ===== [2] match statement — display JsonValue =====
// [8] n.toString()

func jsonToString(value: JsonValue): String {
    match value {
        JsonValue.Null => {
            return "null"
        }
        JsonValue.Bool(b) => {
            if b {
                return "true"
            } else {
                return "false"
            }
        }
        JsonValue.Number(n) => {
            return n.toString()
        }
        JsonValue.Str(s) => {
            return "\"" + s + "\""
        }
        JsonValue.Array(arr) => {
            var result = "["
            var i = 0
            while i < arr.size() {
                if i > 0 {
                    result = result + ", "
                }
                result = result + jsonToString(value: arr[i])
                i = i + 1
            }
            result = result + "]"
            return result
        }
        JsonValue.Object(map) => {
            return "{object}"
        }
    }
}

// ===== main =====

var input = "{\"name\": \"joyeer\", \"version\": 1, \"active\": true, \"items\": [1, 2, 3]}"
var parser = JsonParser(input: input)
var result = parser.parse()
print(message: jsonToString(value: result))
