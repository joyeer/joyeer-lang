cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")

set(project "${work}/discovery project")
jp_write_module("${project}" discover.app bin discovery "'main.joyeer'" "")
file(WRITE "${project}/main.joyeer" "func main() {}\n")
set(manifest "${project}/project.toml")

unset(ENV{JOYEER_COMPILER})
set(original_path "$ENV{PATH}")
if(WIN32)
    set(separator ";")
else()
    set(separator ":")
endif()
file(MAKE_DIRECTORY "${work}/path bin")
set(spy "${work}/path bin/joyeer${EXECUTABLE_SUFFIX}")
file(COPY "${COMPILER_SPY}" DESTINATION "${work}/path bin")
get_filename_component(spy_name "${COMPILER_SPY}" NAME)
file(RENAME "${work}/path bin/${spy_name}" "${spy}")
set(ENV{PATH} "${work}/path bin${separator}${original_path}")
jp_call(0 "${outside}" check --manifest-path "${manifest}")
if(EXISTS "${outside}/compiler-record.txt")
    jp_fail("PATH took precedence over the compiler beside fern")
endif()
if(NOT WIN32)
    file(CREATE_LINK "${FERN_EXECUTABLE}" "${outside}/fern-link" SYMBOLIC)
    set(bootstrap "${FERN_EXECUTABLE}")
    set(FERN_EXECUTABLE "${outside}/fern-link")
    jp_call(0 "${outside}" check --manifest-path "${manifest}")
    set(FERN_EXECUTABLE "${bootstrap}")
endif()

set(discovery "${work}/isolated fern")
file(MAKE_DIRECTORY "${discovery}")
set(isolated "${discovery}/fern${EXECUTABLE_SUFFIX}")
file(COPY "${FERN_EXECUTABLE}" DESTINATION "${discovery}")
if(NOT EXISTS "${isolated}")
    message(FATAL_ERROR "The acceptance test needs a copy of fern")
endif()
set(FERN_EXECUTABLE "${isolated}")

set(ENV{JOYEER_COMPILER} "${work}/missing compiler${EXECUTABLE_SUFFIX}")
jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --manifest-path "${manifest}")
jp_call(1 "${outside}" check --manifest-path "${manifest}")
jp_contains("${jp_err}" "missing compiler")
file(RELATIVE_PATH relative_compiler "${outside}" "${JOYEER_EXECUTABLE}")
set(ENV{JOYEER_COMPILER} "${relative_compiler}")
jp_call(0 "${outside}" check --manifest-path "${manifest}")
jp_call(1 "${outside}" check --compiler "${work}/missing explicit${EXECUTABLE_SUFFIX}" --manifest-path "${manifest}")
jp_contains("${jp_err}" "missing explicit")
unset(ENV{JOYEER_COMPILER})

# A missing tool must not be resolved from the working directory.
file(COPY "${JOYEER_EXECUTABLE}" DESTINATION "${outside}")
set(ENV{PATH} "${separator}.${separator}")
jp_call(1 "${outside}" check --manifest-path "${manifest}")
jp_contains("${jp_err}" "cannot find joyeer")
jp_call(0 "${outside}" test --manifest-path "${manifest}")
if(NOT jp_out STREQUAL "0 tests\n")
    jp_fail("An empty test selection unexpectedly needed a compiler")
endif()
jp_call(2 "${outside}" check --manifest-path "${manifest}" --module not.selected)
jp_contains("${jp_err}" "unknown module")

# A copied compiler spy is enough to observe PATH resolution without loading
# compiler SDKs or relying on the test runner's PATH contents.
set(blocked "${work}/noncompiler bin")
set(linked "${work}/linked bin")
file(MAKE_DIRECTORY "${blocked}" "${linked}")
if(WIN32)
    file(MAKE_DIRECTORY "${blocked}/joyeer${EXECUTABLE_SUFFIX}")
else()
    file(WRITE "${blocked}/joyeer" "not executable\n")
    file(CHMOD "${blocked}/joyeer" PERMISSIONS OWNER_READ OWNER_WRITE)
    file(CREATE_LINK "${spy}" "${linked}/joyeer" SYMBOLIC)
endif()
set(ENV{PATH} "${blocked}${separator}${linked}${separator}${work}/path bin")
jp_call(1 "${outside}" check --manifest-path "${manifest}" --verbose)
string(REPLACE "\\\\" "/" compiler_log "${jp_err}")
jp_contains_path("${compiler_log}" "<${spy}>")
jp_contains("${jp_err}" "compiler exited with status 37")
if(NOT EXISTS "${outside}/compiler-record.txt")
    jp_fail("The compiler found through PATH did not run")
endif()
jp_no_outputs("${project}")
set(ENV{PATH} "${original_path}")

if(WIN32)
    set(quoted_bin "${work}/path bin;with semicolon")
    file(MAKE_DIRECTORY "${quoted_bin}")
    file(COPY "${spy}" DESTINATION "${quoted_bin}")
    set(ENV{PATH} "\"${quoted_bin}\"")
    set(cwd "${work}/quoted caller")
    file(MAKE_DIRECTORY "${cwd}")
    jp_call(1 "${cwd}" check --manifest-path "${manifest}")
    jp_contains("${jp_err}" "compiler exited with status 37")
    if(NOT EXISTS "${cwd}/compiler-record.txt")
        jp_fail("The compiler in the quoted PATH directory did not run")
    endif()
else()
    set(alias "${linked}/compiler-alias")
    file(RELATIVE_PATH alias_target "${linked}" "${JOYEER_EXECUTABLE}")
    file(CREATE_LINK "${alias_target}" "${alias}" SYMBOLIC)
    set(ENV{JOYEER_COMPILER} "${alias}")
    jp_write_module("${project}" discover.app bin discovery "'main.joyeer'" "'System'")
    jp_write_bytes("${project}/main.joyeer" "import System\nfunc main() {}\n")
    jp_call(0 "${outside}" check --manifest-path "${manifest}")
endif()
