cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")

function(install_component prefix component)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIRECTORY}"
        --config "${TEST_CONFIGURATION}" --component "${component}" --prefix "${prefix}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Product installation failed (${result}):\n${output}\n${error}")
    endif()
endfunction()

function(assert_inventory prefix)
    file(GLOB actual RELATIVE "${prefix}" "${prefix}/*")
    set(expected ${ARGN})
    list(SORT actual)
    list(SORT expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Incorrect product inventory at ${prefix}:\nexpected ${expected}\nactual ${actual}")
    endif()
endfunction()

function(assert_source_package module)
    set(directory "${JOYEER_SOURCE_DIR}/lib/${module}")
    file(GLOB sources RELATIVE "${directory}" "${directory}/*.joyeer")
    assert_inventory("${stage}/lib/${module}" project.toml ${sources})
endfunction()

set(runtime_only "${work}/runtime component")
install_component("${runtime_only}" JoyeerRuntime)
assert_inventory("${runtime_only}" ${RUNTIME_ROOT_FILE_NAMES} lib licenses)
assert_inventory("${runtime_only}/lib" "${RUNTIME_ARCHIVE_NAME}")
set(stdlib_only "${work}/standard library component")
install_component("${stdlib_only}" StandardLibrary)
set(stdlib_files Foundation System index.toml)
if(JOYEER_BUILD_COMPRESSION)
    list(APPEND stdlib_files Compression)
endif()
assert_inventory("${stdlib_only}/lib" ${stdlib_files})
set(product_only "${work}/tool component")
install_component("${product_only}" PRODUCT)
set(tool_files "fern${EXECUTABLE_SUFFIX}")
if(WIN32 AND TEST_CONFIGURATION STREQUAL "Debug")
    list(APPEND tool_files fern.pdb)
endif()
assert_inventory("${product_only}" ${tool_files})

set(stage "${work}/combined package")
install_component("${stage}" JoyeerRuntime)
install_component("${stage}" PRODUCT)
install_component("${stage}" StandardLibrary)
if(JOYEER_BUILD_MOSS AND JOYEER_BUILD_COMPRESSION)
    set(moss_only "${work}/moss component")
    install_component("${moss_only}" Moss)
    assert_inventory("${moss_only}" "moss${EXECUTABLE_SUFFIX}")
    install_component("${stage}" Moss)
    list(APPEND tool_files "moss${EXECUTABLE_SUFFIX}")
endif()
assert_inventory("${stage}" ${RUNTIME_ROOT_FILE_NAMES} ${tool_files} lib licenses)
assert_inventory("${stage}/lib" "${RUNTIME_ARCHIVE_NAME}" ${stdlib_files})
assert_source_package(Foundation)
assert_source_package(System)
if(JOYEER_BUILD_COMPRESSION)
    assert_inventory("${stage}/lib/Compression" project.toml compression.joyeer licenses native)
    assert_inventory("${stage}/lib/Compression/licenses" Joyeer-LICENSE miniz-LICENSE)
    if(WIN32)
        assert_inventory("${stage}/lib/Compression/native" JoyeerCompression.lib)
    else()
        assert_inventory("${stage}/lib/Compression/native" libJoyeerCompression.a)
    endif()
endif()
file(SHA256 "${LICENSE_SOURCE}" original)
file(SHA256 "${stage}/licenses/LICENSE" installed)
if(NOT installed STREQUAL original)
    message(FATAL_ERROR "Installed Joyeer license changed")
endif()
assert_inventory("${stage}/licenses" LICENSE)
set(runtime_files ${RUNTIME_ROOT_FILE_NAMES} "lib/${RUNTIME_ARCHIVE_NAME}")
foreach(name IN LISTS runtime_files tool_files)
    file(SIZE "${stage}/${name}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "Empty installed product artifact: ${name}")
    endif()
endforeach()

# U+96EA and U+1F980, encoded as UTF-8 for a relocated supplementary-plane path.
string(ASCII 233 155 170 240 159 166 128 unicode)
set(relocated "${work}/relocated package ${unicode}")
file(RENAME "${stage}" "${relocated}")
set(FERN_EXECUTABLE "${relocated}/fern${EXECUTABLE_SUFFIX}")
set(JOYEER_EXECUTABLE "${relocated}/${COMPILER_FILE_NAME}")
unset(ENV{JOYEER_COMPILER})
jp_call(0 "${outside}" --version)
if(NOT jp_out STREQUAL "fern 0.1.0\n" OR NOT jp_err STREQUAL "")
    jp_fail("Relocated installed fern changed its version/stream contract")
endif()
if(JOYEER_BUILD_MOSS AND JOYEER_BUILD_COMPRESSION)
    execute_process(COMMAND "${relocated}/moss${EXECUTABLE_SUFFIX}" --help
        WORKING_DIRECTORY "${outside}"
        RESULT_VARIABLE moss_status OUTPUT_VARIABLE moss_output ERROR_VARIABLE moss_error TIMEOUT 15)
    if(NOT moss_status STREQUAL "0" OR NOT moss_output MATCHES "moss (inspect|disasm)" OR
            NOT moss_error STREQUAL "")
        message(FATAL_ERROR "Relocated moss did not run: ${moss_status}\n${moss_output}${moss_error}")
    endif()
endif()
set(package "${work}/installed workflow")
jp_call(0 "${outside}" init "${package}" --name installed)
file(READ "${package}/project.toml" manifest)
string(REPLACE "dependencies = []" "dependencies = ['System']" manifest "${manifest}")
jp_write_bytes("${package}/project.toml" "${manifest}")
file(READ "${package}/src/main.joyeer" source)
jp_write_bytes("${package}/src/main.joyeer" "import System\n${source}")
jp_add_test_member("${package}" installed.tests installed-tests "${package}/src/main.joyeer")
jp_call(0 "${outside}" check --workspace "${package}/workspace.toml")
jp_no_outputs("${package}")
foreach(profile IN ITEMS debug release)
    set(options)
    if(profile STREQUAL "release")
        list(APPEND options --release)
    endif()
    jp_call(0 "${outside}" build --workspace "${package}/workspace.toml" ${options})
    jp_artifacts("${package}" "${profile}" installed 1)
    jp_call(0 "${outside}" run --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${package}/workspace.toml" ${options})
    if(NOT jp_out STREQUAL "Hello, Joyeer!\n")
        jp_fail("Installed compiler/backend/runtime/tool workflow did not execute")
    endif()
    jp_call(0 "${outside}" test --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${package}/workspace.toml" ${options})
    jp_contains("${jp_out}" "1 test: 1 passed, 0 build-fail, 0 run-fail")
    jp_artifacts("${package}" "${profile}" installed-tests 1)
    jp_no_runtime_error()
endforeach()
message(STATUS "fern local install components, exact inventory/license and relocated workflows passed")
