cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")

function(module directory name kind dependencies)
    if(kind STREQUAL "source")
        set(output "")
    else()
        set(output local-probe)
    endif()
    jp_write_module("${directory}" "${name}" "${kind}" "${output}" "'main.joyeer'" "")
    file(READ "${directory}/project.toml" contents)
    jp_write_bytes("${directory}/project.toml" "${contents}path-dependencies = [${dependencies}]\n")
endfunction()

function(expect_rejected directory phrase)
    jp_call(1 "${outside}" check --compiler "${COMPILER_SPY}" --manifest-path "${directory}/project.toml")
    jp_contains("${jp_err}" "${phrase}")
    if(EXISTS "${outside}/compiler-record.txt")
        jp_fail("Invalid local dependency graph reached the compiler")
    endif()
    jp_no_outputs("${directory}")
endfunction()

set(app "${work}/app")
set(shared "${work}/shared lib")
set(leaf "${work}/leaf")
set(identity "${work}/identity fixture")
file(MAKE_DIRECTORY "${identity}")
# NUL-bearing input is created by the native fixture writer.
execute_process(COMMAND "${HOST_FIXTURE}" binary "${identity}/first"
    RESULT_VARIABLE first_created)
execute_process(COMMAND "${HOST_FIXTURE}" binary "${identity}/other"
    RESULT_VARIABLE other_created)
if(NOT first_created STREQUAL "0" OR NOT other_created STREQUAL "0")
    message(FATAL_ERROR "Cannot write binary identity fixtures")
endif()
set(specials)
if(WIN32)
    set(special "${identity}/first:test-alternate-stream")
    execute_process(COMMAND "${HOST_FIXTURE}" binary "${special}" RESULT_VARIABLE made)
    if(NOT made STREQUAL "0")
        message(STATUS "Alternate streams unavailable; checking the NUL device instead")
        set(special NUL)
    endif()
else()
    set(special "${identity}/fifo")
    execute_process(COMMAND "${HOST_FIXTURE}" fifo "${special}" RESULT_VARIABLE made)
    if(NOT made STREQUAL "0")
        message(FATAL_ERROR "Cannot create FIFO for file identity test")
    endif()
endif()
list(APPEND specials "${special}")
file(CREATE_LINK "${identity}/first" "${identity}/file-link" SYMBOLIC RESULT file_link_status)
if(file_link_status STREQUAL "0")
    list(APPEND specials "${identity}/file-link")
endif()
foreach(level IN ITEMS 0 2)
    set(identity_program "${identity}/identity-O${level}${EXECUTABLE_SUFFIX}")
    execute_process(COMMAND "${JOYEER_EXECUTABLE}" -O${level} -g0 -o "${identity_program}"
        -- "${FIXTURE_DIR}/../../e2e/stdlib/system_identity.joyeer"
        RESULT_VARIABLE compiled OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT compiled STREQUAL "0")
        message(FATAL_ERROR "Cannot compile identity fixture: ${compiled}\n${output}${error}")
    endif()
    foreach(path IN LISTS specials)
        execute_process(COMMAND "${identity_program}" "${identity}/first" "${identity}/other" "${identity}" "${path}"
            RESULT_VARIABLE ran OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
        string(REPLACE "\r\n" "\n" output "${output}")
        if(NOT ran STREQUAL "0" OR NOT output STREQUAL "file identity passed\n" OR NOT error STREQUAL "")
            message(FATAL_ERROR "File identity fixture failed: ${ran}\n${output}${error}")
        endif()
    endforeach()
endforeach()

module("${app}" local.app bin "'../shared lib', '.././shared lib'")
module("${shared}" local.shared source "'../leaf'")
module("${leaf}" local.leaf source "")
file(WRITE "${app}/main.joyeer" "import local.shared\nfunc main() { print(value: local.shared.answer()) }\n")
file(WRITE "${shared}/main.joyeer" "import local.leaf\npublic func answer(): Int { return local.leaf.value() + 1 }\n")
file(WRITE "${leaf}/main.joyeer" "public func value(): Int { return 41 }\n")
jp_call(0 "${outside}" build --release --compiler "${JOYEER_EXECUTABLE}"
    --manifest-path "${app}/project.toml" --bin-dir "${work}/bin")
execute_process(COMMAND "${work}/bin/local-probe${EXECUTABLE_SUFFIX}"
    RESULT_VARIABLE ran OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT ran STREQUAL "0" OR NOT output STREQUAL "42\n" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Local dependency closure did not run: ${ran}\n${output}${error}")
endif()

jp_call(2 "${outside}" check --compiler "${COMPILER_SPY}" --manifest-path "${app}/project.toml"
    --module local.shared)
jp_contains("${jp_err}" "unknown module 'local.shared'")
if(EXISTS "${outside}/compiler-record.txt")
    jp_fail("Path-only module was accepted as an explicit root")
endif()

file(CREATE_LINK "${shared}" "${work}/directory-alias" SYMBOLIC RESULT symlink_status)
if(symlink_status STREQUAL "0")
    module("${app}" local.app bin "'../shared lib', '../directory-alias'")
    jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}" --manifest-path "${app}/project.toml")
    module("${leaf}" local.leaf source "'../directory-alias'")
else()
    message(STATUS "Directory symlinks unavailable; checking the cycle via a lexical alias: ${symlink_status}")
    module("${leaf}" local.leaf source "'.././shared lib'")
endif()
expect_rejected("${app}" "module dependency cycle: local.shared -> local.leaf -> local.shared")
module("${leaf}" local.leaf source "")

set(alias "${work}/hard-link")
file(MAKE_DIRECTORY "${alias}")
file(CREATE_LINK "${shared}/project.toml" "${alias}/project.toml" RESULT hard_status)
if(NOT hard_status STREQUAL "0")
    message(FATAL_ERROR "Cannot create hard-linked manifest fixture: ${hard_status}")
endif()
module("${work}/hard-app" local.app bin "'../shared lib', '../hard-link'")
expect_rejected("${work}/hard-app" "same manifest has different source directories")

module("${work}/different" local.shared source "")
module("${work}/conflict" local.app bin "'../shared lib', '../different'")
expect_rejected("${work}/conflict" "duplicate logical module name: local.shared")

module("${work}/executable-dep" local.executable bin "")
module("${work}/wrong-kind" local.app bin "'../executable-dep'")
expect_rejected("${work}/wrong-kind" "path dependency must name a source module")

module("${work}/absolute" local.app bin "'/not/relative'")
expect_rejected("${work}/absolute" "path dependency must be a relative directory")

if(WIN32)
    set(stream "${app}/project.toml:fern-test-stream")
    jp_call(1 "${outside}" check --compiler "${COMPILER_SPY}" --manifest-path "${stream}")
    if(EXISTS "${outside}/compiler-record.txt")
        jp_fail("Manifest alternate data stream reached the compiler")
    endif()
endif()

set(limit "${work}/limit")
set(deps "")
foreach(index RANGE 1 256)
    if(deps)
        string(APPEND deps ", ")
    endif()
    string(APPEND deps "'m${index}'")
    module("${limit}/m${index}" "local.m${index}" source "")
endforeach()
module("${limit}" local.limit source "${deps}")
expect_rejected("${limit}" "project exceeds 256 modules")
