cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")
if(NOT EXISTS "${SELF_BUILD_PROJECT}/project.toml")
    message(FATAL_ERROR "Configure the fern self-build project before running acceptance")
endif()
set(package "${work}/self build project")
file(MAKE_DIRECTORY "${package}")
file(COPY "${SELF_BUILD_PROJECT}/" DESTINATION "${package}" PATTERN "target" EXCLUDE)
jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}"
    --manifest-path "${package}/project.toml")
jp_no_outputs("${package}")
set(bootstrap "${FERN_EXECUTABLE}")

foreach(profile IN ITEMS debug release)
    set(options)
    if(profile STREQUAL "release")
        list(APPEND options --release)
    endif()
    set(FERN_EXECUTABLE "${bootstrap}")
    jp_call(0 "${outside}" build --compiler "${JOYEER_EXECUTABLE}"
        --manifest-path "${package}/project.toml" ${options})
    jp_artifacts("${package}" "${profile}" fern 1)
    list(GET jp_artifact_list 0 self_built)
    if(WIN32 AND profile STREQUAL "debug")
        get_filename_component(directory "${self_built}" DIRECTORY)
        if(NOT EXISTS "${directory}/fern.pdb")
            jp_fail("Debug self-build did not produce its PDB")
        endif()
    endif()
    set(FERN_EXECUTABLE "${self_built}")
    jp_call(0 "${outside}" --version)
    if(NOT jp_out STREQUAL "fern 0.1.0\n" OR NOT jp_err STREQUAL "")
        jp_fail("Self-built fern changed its version/stream contract")
    endif()
    jp_call(0 "${outside}" --help)
    jp_contains("${jp_out}" "local Joyeer module and workspace manager")
    set(smoke "${work}/self built ${profile} project")
    jp_call(0 "${outside}" init "${smoke}" --name self.built --output self-built)
    jp_add_test_member("${smoke}" self.tests self-tests "${smoke}/src/main.joyeer")
    jp_call(0 "${outside}" check --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${smoke}/workspace.toml" ${options})
    jp_no_outputs("${smoke}")
    jp_call(0 "${outside}" build --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${smoke}/workspace.toml" ${options})
    jp_artifacts("${smoke}" "${profile}" self-built 1)
    jp_call(0 "${outside}" run --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${smoke}/workspace.toml" ${options})
    if(NOT jp_out STREQUAL "Hello, Joyeer!\n")
        jp_fail("Self-built fern could not execute a freshly scaffolded project")
    endif()
    jp_call(0 "${outside}" test --compiler "${JOYEER_EXECUTABLE}"
        --workspace "${smoke}/workspace.toml" ${options})
    jp_contains("${jp_out}" "1 test: 1 passed, 0 build-fail, 0 run-fail")
    jp_artifacts("${smoke}" "${profile}" self-tests 1)
    jp_no_runtime_error()
endforeach()

# The Release-built tool must itself plan and execute another self-build.
jp_call(0 "${outside}" build --compiler "${JOYEER_EXECUTABLE}"
    --manifest-path "${package}/project.toml" --release --module fern.app)
jp_artifacts("${package}" release fern 2)
set(FERN_EXECUTABLE "${package}/target/release/fern.app/build-2/fern${EXECUTABLE_SUFFIX}")
jp_call(0 "${outside}" --version)
if(NOT jp_out STREQUAL "fern 0.1.0\n" OR NOT jp_err STREQUAL "")
    jp_fail("Second-stage self-built tool did not execute")
endif()
message(STATUS "fern Debug/Release self-build, second-stage build and declared-test workflows passed")
