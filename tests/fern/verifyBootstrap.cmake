cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/helpers.cmake")
set(artifact "${FERN_EXECUTABLE}")
set(artifact_file "${artifact}")
if(WIN32 AND TEST_CONFIGURATION STREQUAL "Debug")
    get_filename_component(directory "${FERN_EXECUTABLE}" DIRECTORY)
    set(artifact "${directory}/fern.pdb")
    set(artifact_file "${artifact}")
elseif(APPLE AND TEST_CONFIGURATION STREQUAL "Debug" AND DSYMUTIL_EXECUTABLE)
    set(artifact "${FERN_EXECUTABLE}.dSYM")
    set(artifact_file "${artifact}/Contents/Resources/DWARF/fern")
endif()
if(NOT EXISTS "${artifact_file}" OR IS_DIRECTORY "${artifact_file}")
    message(FATAL_ERROR "Missing bootstrap output before regeneration: ${artifact}")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef backup_id)
set(backup "${artifact}.bootstrap-${backup_id}")
file(RENAME "${artifact}" "${backup}")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIRECTORY}"
    --config "${TEST_CONFIGURATION}" --target fern
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
if(NOT result STREQUAL "0" OR NOT EXISTS "${artifact_file}" OR IS_DIRECTORY "${artifact_file}")
    file(REMOVE_RECURSE "${artifact}")
    file(RENAME "${backup}" "${artifact}")
    message(FATAL_ERROR "Missing bootstrap output did not regenerate (${result}):\n${output}\n${error}")
endif()
file(SIZE "${artifact_file}" size)
if(size EQUAL 0)
    file(REMOVE_RECURSE "${artifact}")
    file(RENAME "${backup}" "${artifact}")
    message(FATAL_ERROR "Bootstrap regenerated an empty output: ${artifact}")
endif()
jp_call(0 "${outside}" --version)
if(NOT jp_out STREQUAL "fern 0.1.0\n" OR NOT jp_err STREQUAL "")
    jp_fail("Regenerated bootstrap tool did not execute")
endif()
file(REMOVE_RECURSE "${backup}")
message(STATUS "fern missing ${TEST_CONFIGURATION} bootstrap output regenerated and executed")
