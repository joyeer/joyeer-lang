import System
import Foundation

// Tests for the TCP operations (spec §18.6) as `System` provides them. Every
// connection is to a listener of this program on 127.0.0.1: the kernel
// completes the handshake into the listen backlog, so one thread can listen,
// connect and accept in turn.

private func caseName(error: NetworkError): String {
    return match error {
        .InvalidInput(_) => "InvalidInput",
        .AddressInUse(_) => "AddressInUse",
        .AddressNotAvailable(_) => "AddressNotAvailable",
        .PermissionDenied(_) => "PermissionDenied",
        .ConnectionRefused(_) => "ConnectionRefused",
        .ConnectionReset(_) => "ConnectionReset",
        .TimedOut(_) => "TimedOut",
        .Other(_) => "Other",
    }
}

private func listenCase(address: String, port: Int, backlog: Int): String {
    let outcome = tcpListen(address: address, port: port, backlog: backlog)
    return match outcome {
        .Ok(_) => "ok",
        .Err(error) => caseName(error: error),
    }
}

private func connectCase(address: String, port: Int): String {
    let outcome = tcpConnect(address: address, port: port)
    return match outcome {
        .Ok(_) => "ok",
        .Err(error) => caseName(error: error),
    }
}

private func receiveCase(connection: TcpConnection, maximumBytes: Int, timeoutMillis: Int): String {
    let outcome = tcpReceive(connection: connection, maximumBytes: maximumBytes, timeoutMillis: timeoutMillis)
    return match outcome {
        .Ok(_) => "ok",
        .Err(error) => caseName(error: error),
    }
}

private func checkCase(name: String, actual: String, expected: String): Int {
    if actual == expected { return 0 }
    print(value: "FAIL: " + name + ": expected " + expected + ", got " + actual)
    return 1
}

private func testAddressForms(): Int {
    var failures = 0
    let bad = ["", "1.2.3", "1.2.3.4.5", "256.0.0.1", "01.2.3.4", "1.2.3.-1", "a.b.c.d", "localhost", "::1",
        " 1.2.3.4", "1.2.3.4 ", "1..3.4", "1.2.3.", ".1.2.3", "1.2.3.1234", "127.0.0.1\n"]
    var index = 0
    while index < bad.count {
        failures = failures + checkCase(name: "listen address '" + bad[index] + "'",
            actual: listenCase(address: bad[index], port: 0, backlog: 1), expected: "InvalidInput")
        failures = failures + checkCase(name: "connect address '" + bad[index] + "'",
            actual: connectCase(address: bad[index], port: 80), expected: "InvalidInput")
        index = index + 1
    }
    failures = failures + checkCase(name: "listen port -1",
        actual: listenCase(address: "127.0.0.1", port: -1, backlog: 1), expected: "InvalidInput")
    failures = failures + checkCase(name: "listen port 65536",
        actual: listenCase(address: "127.0.0.1", port: 65536, backlog: 1), expected: "InvalidInput")
    failures = failures + checkCase(name: "listen backlog 0",
        actual: listenCase(address: "127.0.0.1", port: 0, backlog: 0), expected: "InvalidInput")
    failures = failures + checkCase(name: "connect port 0",
        actual: connectCase(address: "127.0.0.1", port: 0), expected: "InvalidInput")
    failures = failures + checkCase(name: "connect port 65536",
        actual: connectCase(address: "127.0.0.1", port: 65536), expected: "InvalidInput")
    return failures
}

// A string of exactly `count` bytes whose content depends on the position.
private func pattern(count: Int): String {
    var block = "0123456789abcdefghijklmnopqrstuvwxyz"
    while block.count < count { block = block + block }
    return substring(text: block, start: 0, end: count)
}

private func loopback(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 4)?
    let port = tcpLocalPort(listener: listener)?
    failures = failures + check(name: "ephemeral port assigned", ok: port > 0 && port < 65536)

    let client = tcpConnect(address: "127.0.0.1", port: port)?
    let server = tcpAccept(listener: listener, timeoutMillis: 5000)?

    failures = failures + checkCase(name: "receive bound 0",
        actual: receiveCase(connection: server, maximumBytes: 0, timeoutMillis: 5000), expected: "InvalidInput")
    failures = failures + checkCase(name: "receive bound over 1 MiB",
        actual: receiveCase(connection: server, maximumBytes: 1048577, timeoutMillis: 5000), expected: "InvalidInput")

    // Both directions, a short read, and an empty send.
    tcpSend(connection: client, contents: "hello\r\n")?
    tcpSend(connection: client, contents: "")?
    let request = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "server receives request", ok: request == "hello\r\n")
    tcpSend(connection: server, contents: "world")?
    let reply = tcpReceive(connection: client, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "client receives reply", ok: reply == "world")

    // A bound smaller than the data returns a prefix; the rest arrives next.
    tcpSend(connection: client, contents: "abcdef")?
    var assembled = ""
    var reads = 0
    while assembled.count < 6 && reads < 10 {
        assembled = assembled + tcpReceive(connection: server, maximumBytes: 2, timeoutMillis: 5000)?
        reads = reads + 1
    }
    failures = failures + check(name: "bounded reads reassemble", ok: assembled == "abcdef")

    // More than one receive's worth, delivered in pieces.
    let payload = pattern(count: 32768)
    tcpSend(connection: client, contents: payload)?
    var received = ""
    var passes = 0
    while received.count < payload.count && passes < 100 {
        let piece = tcpReceive(connection: server, maximumBytes: 4096, timeoutMillis: 5000)?
        failures = failures + check(name: "piece within bound", ok: piece.count >= 1 && piece.count <= 4096)
        received = received + piece
        passes = passes + 1
    }
    failures = failures + check(name: "32 KiB arrives intact", ok: received == payload)

    // Closing the client ends the stream for the server, repeatedly.
    tcpCloseConnection(connection: consume client)?
    let end = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "end of stream is empty", ok: end == "")
    let again = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "end of stream repeats", ok: again == "")

    tcpCloseConnection(connection: consume server)?
    tcpCloseListener(listener: consume listener)?
    return .Ok(failures)
}

private func reportLoopback(label: String, outcome: Result<Int, NetworkError>): Int {
    return match outcome {
        .Ok(failures) => failures,
        .Err(error) => reportFailure(label: label, error: error),
    }
}

private func reportFailure(label: String, error: NetworkError): Int {
    print(value: "FAIL: " + label + " raised " + caseName(error: error))
    return 1
}

private func testAddressInUse(): Result<Int, NetworkError> {
    var failures = 0
    let first = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let port = tcpLocalPort(listener: first)?
    failures = failures + checkCase(name: "second listen on a used port",
        actual: listenCase(address: "127.0.0.1", port: port, backlog: 1), expected: "AddressInUse")
    tcpCloseListener(listener: consume first)?
    return .Ok(failures)
}

private func testRefused(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let port = tcpLocalPort(listener: listener)?
    tcpCloseListener(listener: consume listener)?
    failures = failures + checkCase(name: "connect to a closed port",
        actual: connectCase(address: "127.0.0.1", port: port), expected: "ConnectionRefused")
    return .Ok(failures)
}

// Sending to a peer that has gone must fail with an error, not stop the process.
private func testSendToClosedPeer(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let port = tcpLocalPort(listener: listener)?
    let client = tcpConnect(address: "127.0.0.1", port: port)?
    let server = tcpAccept(listener: listener, timeoutMillis: 5000)?
    tcpCloseConnection(connection: consume client)?

    let block = pattern(count: 1024)
    var outcome = "none"
    var attempts = 0
    while outcome == "none" && attempts < 200 {
        let sent = tcpSend(connection: server, contents: block)
        outcome = match sent {
            .Ok(_) => "none",
            .Err(error) => caseName(error: error),
        }
        attempts = attempts + 1
    }
    failures = failures + checkCase(name: "send after the peer closed", actual: outcome, expected: "ConnectionReset")

    tcpCloseConnection(connection: consume server)?
    tcpCloseListener(listener: consume listener)?
    return .Ok(failures)
}

private func acceptCase(listener: TcpListener, timeoutMillis: Int): String {
    let outcome = tcpAccept(listener: listener, timeoutMillis: timeoutMillis)
    return match outcome {
        .Ok(_) => "ok",
        .Err(error) => caseName(error: error),
    }
}

// Receive and accept timeouts (decision 0014). Nothing here measures elapsed time, because
// System has no clock; it checks which result each call gives.
private func testTimeouts(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 4)?
    let port = tcpLocalPort(listener: listener)?

    // Nothing is pending: accept expires, with a wait and without one.
    failures = failures + checkCase(name: "accept times out",
        actual: acceptCase(listener: listener, timeoutMillis: 50), expected: "TimedOut")
    failures = failures + checkCase(name: "accept with zero timeout polls",
        actual: acceptCase(listener: listener, timeoutMillis: 0), expected: "TimedOut")
    failures = failures + checkCase(name: "accept timeout below -1",
        actual: acceptCase(listener: listener, timeoutMillis: -2), expected: "InvalidInput")
    failures = failures + checkCase(name: "accept timeout above the limit",
        actual: acceptCase(listener: listener, timeoutMillis: 2147483648), expected: "InvalidInput")

    // A pending connection is ready, so a timed accept returns it.
    let client = tcpConnect(address: "127.0.0.1", port: port)?
    let server = tcpAccept(listener: listener, timeoutMillis: 5000)?

    // No data yet: receive expires, and the connection is still usable afterwards.
    failures = failures + checkCase(name: "receive times out",
        actual: receiveCase(connection: server, maximumBytes: 64, timeoutMillis: 50), expected: "TimedOut")
    failures = failures + checkCase(name: "receive with zero timeout polls",
        actual: receiveCase(connection: server, maximumBytes: 64, timeoutMillis: 0), expected: "TimedOut")
    failures = failures + checkCase(name: "receive timeout below -1",
        actual: receiveCase(connection: server, maximumBytes: 64, timeoutMillis: -2), expected: "InvalidInput")
    failures = failures + checkCase(name: "receive timeout above the limit",
        actual: receiveCase(connection: server, maximumBytes: 64, timeoutMillis: 2147483648),
        expected: "InvalidInput")
    tcpSend(connection: client, contents: "late")?
    let data = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "data after a timeout is not lost", ok: data == "late")

    // End of stream is a result, not a timeout.
    tcpCloseConnection(connection: consume client)?
    let end = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + check(name: "closed peer reads as end of stream", ok: end == "")

    tcpCloseConnection(connection: consume server)?
    tcpCloseListener(listener: consume listener)?
    return .Ok(failures)
}

// Handles close when they are destroyed (decision 0015): a listener or connection that goes
// out of scope releases its socket without an explicit close.
private func listenAndDrop(): Result<Int, NetworkError> {
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    return tcpLocalPort(listener: listener)
}

private func connectAndDrop(port: Int): Result<Void, NetworkError> {
    let client = tcpConnect(address: "127.0.0.1", port: port)?
    return tcpSend(connection: client, contents: "")
}

private func testDroppedHandlesClose(): Result<Int, NetworkError> {
    var failures = 0

    // The dropped listener released its port, so the same port can be listened on again.
    let port = listenAndDrop()?
    failures = failures + checkCase(name: "listen on the port of a dropped listener",
        actual: listenCase(address: "127.0.0.1", port: port, backlog: 1), expected: "ok")

    // A dropped client closes its end, so the server reads the end of the stream.
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let live = tcpLocalPort(listener: listener)?
    connectAndDrop(port: live)?
    let server = tcpAccept(listener: listener, timeoutMillis: 5000)?
    let end = tcpReceive(connection: server, maximumBytes: 64, timeoutMillis: 5000)?
    failures = failures + checkCase(name: "dropped client ends the stream", actual: end, expected: "")
    tcpCloseConnection(connection: consume server)?
    tcpCloseListener(listener: consume listener)?
    return .Ok(failures)
}

private func testPoll(): Result<Int, NetworkError> {
    var failures = 0
    let first = tcpListen(address: "127.0.0.1", port: 0, backlog: 4)?
    let port = tcpLocalPort(listener: first)?
    let a = tcpConnect(address: "127.0.0.1", port: port)?
    let firstConnection = tcpAccept(listener: first, timeoutMillis: 5000)?
    let b = tcpConnect(address: "127.0.0.1", port: port)?
    let secondConnection = tcpAccept(listener: first, timeoutMillis: 5000)?
    let connections = [consume firstConnection, consume secondConnection]
    let listeners = [consume first]

    let idle = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: 0)?
    failures = failures + check(name: "poll reports no idle handles",
        ok: idle.connections.count == 0 && idle.listeners.count == 0)
    let invalid = tcpPoll(connections: [], listeners: [], timeoutMillis: 0)
    failures = failures + check(name: "poll rejects an empty set",
        ok: match invalid { .Err(.InvalidInput(_)) => true, _ => false })
    let invalidTimeout = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: -2)
    failures = failures + check(name: "poll rejects an invalid timeout",
        ok: match invalidTimeout { .Err(.InvalidInput(_)) => true, _ => false })
    let expired = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: 15)?
    failures = failures + check(name: "poll expiry returns empty indices",
        ok: expired.connections.count == 0 && expired.listeners.count == 0)

    tcpSend(connection: b, contents: "r")?
    let ready = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: 5000)?
    failures = failures + check(name: "poll returns the readable connection index",
        ok: ready.connections == [1] && ready.listeners.count == 0)
    let message = tcpReceive(connection: connections[1], maximumBytes: 1, timeoutMillis: 5000)?
    failures = failures + check(name: "poll does not read the socket", ok: message == "r")

    let _pending = tcpConnect(address: "127.0.0.1", port: port)?
    let accepting = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: 5000)?
    failures = failures + check(name: "poll returns the ready listener index",
        ok: accepting.connections.count == 0 && accepting.listeners == [0])
    let _accepted = tcpAccept(listener: listeners[0], timeoutMillis: 5000)?
    tcpCloseConnection(connection: consume a)?
    let closing = tcpPoll(connections: connections, listeners: listeners, timeoutMillis: 5000)?
    failures = failures + check(name: "poll treats end of stream as readable",
        ok: closing.connections == [0] && closing.listeners.count == 0)
    let eof = tcpReceive(connection: connections[0], maximumBytes: 1, timeoutMillis: 5000)?
    failures = failures + check(name: "receive observes end of stream after poll", ok: eof.count == 0)

    var many: [TcpListener] = []
    while many.count < 64 {
        &many.append(element: tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?)
    }
    let maximum = tcpPoll(connections: [], listeners: many, timeoutMillis: 0)?
    failures = failures + check(name: "poll accepts the maximum number of handles", ok: maximum.listeners.count == 0)
    &many.append(element: tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?)
    let oversized = tcpPoll(connections: [], listeners: many, timeoutMillis: 0)
    failures = failures + check(name: "poll rejects a set over the cap",
        ok: match oversized { .Err(.InvalidInput(_)) => true, _ => false })
    return .Ok(failures)
}

private func testSendAndConnectDeadlines(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 4)?
    let port = tcpLocalPort(listener: listener)?
    let invalid = tcpConnectWithin(address: "127.0.0.1", port: port, timeoutMillis: -2)
    failures = failures + check(name: "connect rejects an invalid timeout",
        ok: match invalid { .Err(.InvalidInput(_)) => true, _ => false })
    var client = tcpConnectWithin(address: "127.0.0.1", port: port, timeoutMillis: 5000)?
    let server = tcpAccept(listener: listener, timeoutMillis: 5000)?
    tcpSendWithin(connection: &client, contents: "s", timeoutMillis: 5000)?
    let small = tcpReceive(connection: server, maximumBytes: 1, timeoutMillis: 5000)?
    failures = failures + check(name: "finite send and connect work on loopback", ok: small == "s")

    let invalidSend = tcpSendWithin(connection: &client, contents: "", timeoutMillis: 2147483648)
    failures = failures + check(name: "send rejects an invalid timeout even for empty data",
        ok: match invalidSend { .Err(.InvalidInput(_)) => true, _ => false })
    // The other endpoint does not read. The whole send must finish with a timeout, not block.
    let payload = pattern(count: 16 * 1024 * 1024)
    let blocked = tcpSendWithin(connection: &client, contents: payload, timeoutMillis: 250)
    failures = failures + check(name: "send returns when an unread peer fills the send buffer",
        ok: match blocked { .Err(.TimedOut(_)) => true, _ => false })

    let unused = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let unusedPort = tcpLocalPort(listener: unused)?
    tcpCloseListener(listener: consume unused)?
    // Winsock can spend around two seconds resolving refusal even on loopback.
    let refused = tcpConnectWithin(address: "127.0.0.1", port: unusedPort, timeoutMillis: 8000)
    let refusedKind = match refused { .Err(error) => caseName(error: error), .Ok(_) => "ok" }
    failures = failures + checkCase(name: "connect reports SO_ERROR instead of treating readiness as success",
        actual: refusedKind, expected: "ConnectionRefused")
    return .Ok(failures)
}

private func testReadQueue(): Result<Int, NetworkError> {
    var failures = 0
    let empty = tcpOpenReadQueue(connections: consume [])
    failures = failures + check(name: "read queue rejects an empty set",
        ok: match empty { .Err(.InvalidInput(_)) => true, _ => false })

    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 4)?
    let port = tcpLocalPort(listener: listener)?
    var peers: [TcpConnection] = []
    var connections: [TcpConnection] = []
    while connections.count < 80 {
        &peers.append(element: tcpConnect(address: "127.0.0.1", port: port)?)
        &connections.append(element: tcpAccept(listener: listener, timeoutMillis: 5000)?)
    }
    var queue = tcpOpenReadQueue(connections: consume connections)?
    let idle = tcpReadQueueWait(queue: &queue, timeoutMillis: 20)?
    failures = failures + check(name: "read queue times out without a selected socket", ok: idle == nil)
    let receiveIdle = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)
    failures = failures + check(name: "read queue rejects reads without a selection",
        ok: match receiveIdle { .Err(.InvalidInput(_)) => true, _ => false })

    tcpSend(connection: peers[79], contents: "tu")?
    let ready = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "read queue notices a socket beyond the 64-entry poll cap", ok: ready == .Some(79))
    let invalid = tcpReadQueueWait(queue: &queue, timeoutMillis: -2)
    failures = failures + check(name: "invalid wait leaves the selection unchanged",
        ok: match invalid { .Err(.InvalidInput(_)) => true, _ => false })
    let first = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "queue notification leaves TCP bytes unread", ok: first == .Some("t"))
    let unbounded = tcpReadQueueSendWithin(queue: &queue, contents: "", timeoutMillis: -1)
    failures = failures + check(name: "selected send requires a finite timeout",
        ok: match unbounded { .Err(.InvalidInput(_)) => true, _ => false })
    tcpReadQueueSendWithin(queue: &queue, contents: "r", timeoutMillis: 5000)?
    let reply = tcpReceive(connection: peers[79], maximumBytes: 1, timeoutMillis: 5000)?
    failures = failures + check(name: "read queue sends only to the selected connection", ok: reply == "r")

    let rearmed = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "the previous selection can become ready again", ok: rearmed == .Some(79))
    let second = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "rearming delivers unread bytes", ok: second == .Some("u"))
    let drained = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "reading a drained selection does not block", ok: drained == nil)
    let clear = tcpReadQueueWait(queue: &queue, timeoutMillis: 0)?
    failures = failures + check(name: "zero wait times out after rearm", ok: clear == nil)
    let noSelection = tcpReadQueueCloseCurrent(queue: &queue)
    failures = failures + check(name: "a valid timed-out wait clears selection",
        ok: match noSelection { .Err(.InvalidInput(_)) => true, _ => false })
    tcpSend(connection: peers[79], contents: "x")?
    let again = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "a timed-out wait retains registrations", ok: again == .Some(79))
    let third = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "new data arrives after the timed-out wait", ok: third == .Some("x"))
    tcpReadQueueCloseCurrent(queue: &queue)?
    let eof = tcpReceive(connection: peers[79], maximumBytes: 1, timeoutMillis: 5000)?
    failures = failures + check(name: "closing the selected socket reaches its peer", ok: eof.count == 0)

    tcpSend(connection: peers[13], contents: "v")?
    let next = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "closing a selection preserves other input indices", ok: next == .Some(13))
    let blocked = tcpReadQueueSendWithin(queue: &queue, contents: pattern(count: 16 * 1024 * 1024), timeoutMillis: 250)
    failures = failures + check(name: "selected send stops when an unread peer fills the buffer",
        ok: match blocked { .Err(.TimedOut(_)) => true, _ => false })
    // Exit with one disarmed registration and other registrations still pending.
    return .Ok(failures)
}

private func testReadQueueEof(): Result<Int, NetworkError> {
    var failures = 0
    let listener = tcpListen(address: "127.0.0.1", port: 0, backlog: 1)?
    let port = tcpLocalPort(listener: listener)?
    let peer = tcpConnect(address: "127.0.0.1", port: port)?
    let connection = tcpAccept(listener: listener, timeoutMillis: 5000)?
    // Both data and FIN may already be pending when this connection is registered.
    tcpSend(connection: peer, contents: "z")?
    tcpCloseConnection(connection: consume peer)?
    var queue = tcpOpenReadQueue(connections: consume [consume connection])?
    let ready = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "data before FIN is ready", ok: ready == .Some(0))
    let byte = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "the queue delivers data before FIN", ok: byte == .Some("z"))
    let fin = tcpReadQueueWait(queue: &queue, timeoutMillis: 5000)?
    failures = failures + check(name: "EOF is readable after buffered data", ok: fin == .Some(0))
    let end = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    let repeated = tcpReadQueueReceive(queue: &queue, maximumBytes: 1)?
    failures = failures + check(name: "confirmed EOF repeats while selected",
        ok: end == .Some("") && repeated == .Some(""))
    let exhausted = tcpReadQueueWait(queue: &queue, timeoutMillis: -1)?
    failures = failures + check(name: "the last confirmed EOF retires without an infinite wait", ok: exhausted == nil)
    return .Ok(failures)
}

public func testNetwork(): Int {
    var failures = testAddressForms()
    failures = failures + reportLoopback(label: "timeouts", outcome: testTimeouts())
    failures = failures + reportLoopback(label: "poll", outcome: testPoll())
    failures = failures + reportLoopback(label: "send/connect deadlines", outcome: testSendAndConnectDeadlines())
    failures = failures + reportLoopback(label: "scalable read queue", outcome: testReadQueue())
    failures = failures + reportLoopback(label: "read queue EOF", outcome: testReadQueueEof())
    failures = failures + reportLoopback(label: "loopback", outcome: loopback())
    failures = failures + reportLoopback(label: "address in use", outcome: testAddressInUse())
    failures = failures + reportLoopback(label: "connection refused", outcome: testRefused())
    failures = failures + reportLoopback(label: "send to closed peer", outcome: testSendToClosedPeer())
    failures = failures + reportLoopback(label: "dropped handles close", outcome: testDroppedHandlesClose())
    return failures
}
