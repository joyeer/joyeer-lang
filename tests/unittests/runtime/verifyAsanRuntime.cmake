execute_process(COMMAND "${PROBE}" "${MODE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(MODE STREQUAL "valid")
    if(NOT status STREQUAL "0" OR NOT output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Sanitized runtime probe failed: ${status}\n${output}${error}")
    endif()
else()
    if(MODE STREQUAL "invalid")
        set(expected_access "READ of size 1 at")
    elseif(MODE STREQUAL "invalid-write")
        set(expected_access "WRITE of size 2 at")
    else()
        message(FATAL_ERROR "Unknown runtime ASan probe mode: ${MODE}")
    endif()
    if(status STREQUAL "0" OR NOT error MATCHES "AddressSanitizer: heap-buffer-overflow"
            OR NOT error MATCHES "${expected_access}")
        message(FATAL_ERROR "Expected a checked ${expected_access} in the Joyeer runtime: ${status}\n${output}${error}")
    endif()
endif()
