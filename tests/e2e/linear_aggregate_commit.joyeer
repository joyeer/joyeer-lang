// Spec 4.7.1: breaking out of construction leaves an original linear place live.
enum Work {
    Pair(JoinHandle<Int>, Int),
}

struct Worker {
    var handle: JoinHandle<Int>
    var extra: Int
}

func identity(value: consuming Int): Int { return value }

func arrayWork(abort: Bool): Int {
    let first = spawn(function: identity, input: consume 5)
    while true {
        var handles = [consume first, if abort { break } else {
            spawn(function: identity, input: consume 6)
        }]
        var sum = 0
        while true {
            match &handles.removeLast() {
                .Some(handle) => { sum = sum + consume handle.join() },
                .None => { break },
            }
        }
        consume handles.consumeEmpty()
        return sum
    }
    return consume first.join()
}

func enumWork(abort: Bool): Int {
    let worker = Worker(handle: spawn(function: identity, input: consume 7), extra: 8)
    while true {
        let work: Work = .Pair(consume worker.handle, if abort { break } else { worker.extra })
        match consume work {
            .Pair(handle, extra) => { return consume handle.join() + extra },
        }
    }
    return consume worker.handle.join()
}

func qualifiedWork(abort: Bool): Int {
    let handle = spawn(function: identity, input: consume 9)
    while true {
        let work = Work.Pair((consume handle), if abort { break } else { 10 })
        match consume work {
            .Pair(task, extra) => { return consume task.join() + extra },
        }
    }
    return consume handle.join()
}

func retryWork(): Int {
    let handle = spawn(function: identity, input: consume 20)
    var attempt = 0
    while true {
        let work: Work = .Pair((consume handle), if attempt == 0 {
            attempt = 1
            continue
        } else {
            while true { break }
            3
        })
        match consume work {
            .Pair(task, extra) => { return consume task.join() + extra },
        }
    }
    return consume handle.join()
}

func main() {
    print(value: arrayWork(abort: true))
    print(value: arrayWork(abort: false))
    print(value: enumWork(abort: true))
    print(value: enumWork(abort: false))
    print(value: qualifiedWork(abort: true))
    print(value: qualifiedWork(abort: false))
    print(value: retryWork())
}
