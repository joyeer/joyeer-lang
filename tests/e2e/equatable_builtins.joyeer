// Equality through `Equatable` (decision 0029, spec 20.13): the builtin conformers, a hand-written witness on a
// copyable and on a noncopyable struct, and `==`, `!=` and the requirement call in generic code.
struct Money {
    var cents: Int
}

extension Money: Equatable {
    func equals(other: Money): Bool {
        return self.cents == other.cents
    }
}

struct Handle {
    var fd: Int
    deinit() {}
}

extension Handle: Equatable {
    func equals(other: Handle): Bool {
        return self.fd == other.fd
    }
}

func same<T: Equatable>(left: T, right: T): Bool {
    return left == right
}

func differ<T: Equatable>(left: T, right: T): Bool {
    return left != right
}

func viaRequirement<T: Equatable>(left: T, right: T): Bool {
    return left.equals(other: right)
}

func main() {
    print(value: same(left: 3, right: 3))
    print(value: differ(left: 3, right: 4))
    print(value: same(left: "joy", right: "joy"))
    print(value: same(left: "joy", right: "jot"))
    let zero: Double = 0.0
    let nan = zero / zero
    let negativeZero: Double = -0.0
    print(value: same(left: nan, right: nan))
    print(value: differ(left: nan, right: nan))
    print(value: same(left: negativeZero, right: zero))
    print(value: same(left: true, right: false))
    print(value: same(left: (), right: ()))
    print(value: () != ())
    print(value: viaRequirement(left: 7, right: 7))
    let a = Money(cents: 100)
    let b = Money(cents: 250)
    print(value: a == b)
    print(value: a != b)
    print(value: same(left: a, right: Money(cents: 100)))
    print(value: viaRequirement(left: b, right: b))
    let h = Handle(fd: 1)
    let g = Handle(fd: 2)
    print(value: h == g)
    print(value: same(left: h, right: h))
    print(value: differ(left: h, right: g))
}
