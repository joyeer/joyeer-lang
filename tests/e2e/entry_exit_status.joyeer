func main(args: [String]): Int {
    let text = "clean" + "up"
    print(value: text)
    if args.count == 0 {
        return 0
    }
    if args[0] == "one" {
        return 1
    }
    if args[0] == "max" {
        return 255
    }
    if args[0] == "negative" {
        return -1
    }
    return 256
}
