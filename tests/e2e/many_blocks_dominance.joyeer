// Compile-time regression (verifier dominance): one function holding many array and dictionary literals
// separated by `if` blocks, and one array literal of `?` entries, so `main` and `build` have hundreds of
// basic blocks. The verifier's dominance check once grew faster than the square of the block count here.
enum Failure {
    Bad
}

func make(v: Int): Result<Int, Failure> {
    if v < 0 {
        return .Err(.Bad)
    }
    return .Ok(v)
}

func build(): Result<Int, Failure> {
    let items: [Int] = [
        make(v: 0)?, make(v: 1)?, make(v: 2)?, make(v: 3)?, make(v: 4)?, make(v: 5)?,
        make(v: 6)?, make(v: 7)?, make(v: 8)?, make(v: 9)?, make(v: 10)?, make(v: 11)?,
        make(v: 12)?, make(v: 13)?, make(v: 14)?, make(v: 15)?, make(v: 16)?, make(v: 17)?,
        make(v: 18)?, make(v: 19)?, make(v: 20)?, make(v: 21)?, make(v: 22)?, make(v: 23)?,
        make(v: 24)?, make(v: 25)?, make(v: 26)?, make(v: 27)?, make(v: 28)?, make(v: 29)?,
        make(v: 30)?, make(v: 31)?, make(v: 32)?, make(v: 33)?, make(v: 34)?, make(v: 35)?,
        make(v: 36)?, make(v: 37)?, make(v: 38)?, make(v: 39)?, make(v: 40)?, make(v: 41)?,
        make(v: 42)?, make(v: 43)?, make(v: 44)?, make(v: 45)?, make(v: 46)?, make(v: 47)?,
        make(v: 48)?, make(v: 49)?, make(v: 50)?, make(v: 51)?, make(v: 52)?, make(v: 53)?,
        make(v: 54)?, make(v: 55)?, make(v: 56)?, make(v: 57)?, make(v: 58)?, make(v: 59)?,
        make(v: 60)?, make(v: 61)?, make(v: 62)?, make(v: 63)?, make(v: 64)?, make(v: 65)?,
        make(v: 66)?, make(v: 67)?, make(v: 68)?, make(v: 69)?, make(v: 70)?, make(v: 71)?,
        make(v: 72)?, make(v: 73)?, make(v: 74)?, make(v: 75)?, make(v: 76)?, make(v: 77)?,
        make(v: 78)?, make(v: 79)?, make(v: 80)?, make(v: 81)?, make(v: 82)?, make(v: 83)?,
        make(v: 84)?, make(v: 85)?, make(v: 86)?, make(v: 87)?, make(v: 88)?, make(v: 89)?,
        make(v: 90)?, make(v: 91)?, make(v: 92)?, make(v: 93)?, make(v: 94)?, make(v: 95)?,
        make(v: 96)?, make(v: 97)?, make(v: 98)?, make(v: 99)?,
    ]
    return .Ok(items.count + items[99])
}

