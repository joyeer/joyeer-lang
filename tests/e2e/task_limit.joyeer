// At most 256 tasks may be unjoined at once (spec 21.5); the next spawn traps.
func work(value: consuming Int): Int {
    return value
}

func joinAll(handles: consuming [JoinHandle<Int>]): Int {
    var sum = 0
    while true {
        let popped = &handles.removeLast()
        match consume popped {
            .Some(handle) => { sum = sum + consume handle.join() }
            .None => { break }
        }
    }
    consume handles.consumeEmpty()
    return sum
}

func main() {
    var handles: [JoinHandle<Int>] = []
    var index = 0
    while index < 300 {
        &handles.append(element: consume spawn(function: work, input: consume (index + 1)))
        index = index + 1
    }
    print(value: joinAll(handles: consume handles))
}
