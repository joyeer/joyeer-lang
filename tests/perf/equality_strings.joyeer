// String equality (decision 0031, plan 0012 phase 4): `==` and `!=` on `String`, the collections prelude's inlined
// comparison before and after `Equatable`. The same program is compiled by both compilers. Not a test; see README.md.
func main() {
    let first = "alpha-beta-gamma"
    let second = "alpha-beta-gammb"
    let third = "alpha-beta-gamma"
    var total = 0
    var round = 0
    while round < 10000000 {
        if first == third {
            total = total + 1
        }
        if first != second {
            total = total + 2
        }
        if second == third {
            total = total + 4
        }
        round = round + 1
    }
    print(value: total)
}
