// The baseline of `equality_derived.joyeer` (plan 0012 phase 4): the derived comparison written field by field,
// for a compiler without derived `Equatable`. Not a test; see README.md.
struct Point {
    var x: Int
    var y: Int
    var z: Int
}

func same(a: Point, b: Point): Bool {
    return a.x == b.x && a.y == b.y && a.z == b.z
}

func main() {
    let base = Point(x: 1, y: 2, z: 3)
    var total = 0
    var round = 0
    while round < 50000000 {
        let other = Point(x: 1, y: 2, z: round % 4)
        if same(a: base, b: other) {
            total = total + 1
        }
        if !same(a: base, b: other) {
            total = total + 2
        }
        round = round + 1
    }
    print(value: total)
}
