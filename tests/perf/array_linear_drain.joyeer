// Linear drain baseline (plan 0011, phase 3): an array of join handles is filled and drained with
// removeLast, then ended with consumeEmpty. Not a test; see README.md.
func identity(value: consuming Int): Int {
    return value
}

func main() {
    var total = 0
    var batch = 0
    while batch < 24 {
        var handles: [JoinHandle<Int>] = []
        var index = 1
        while index <= 32 {
            &handles.append(element: consume spawn(function: identity,
                    input: consume (batch * 32 + index)))
            index = index + 1
        }
        while true {
            let popped = &handles.removeLast()
            match consume popped {
                .Some(handle) => { total = total + consume handle.join() },
                .None => { break },
            }
        }
        consume handles.consumeEmpty()
        batch = batch + 1
    }
    print(value: total)
}
