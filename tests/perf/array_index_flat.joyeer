// Flat element access over the builtin array (plan 0011, phase 3, decision 0026 measurement): the same
// reads, writes and compound updates as array_index_library.joyeer, so the two can be compared. The builtin
// `a[i]` is a bounds check plus a typed address, inline. Prints 221165568000.
func main() {
    var items: [Int] = []
    var index = 0
    while index < 1024 {
        &items.append(element: 0)
        index = index + 1
    }
    var total = 0
    var round = 0
    while round < 12000 {
        index = 0
        while index < 1024 {
            total = total + items[index]
            &items[index] = items[index] + 1
            &items[index] += 2
            index = index + 1
        }
        round = round + 1
    }
    print(value: total)
}
