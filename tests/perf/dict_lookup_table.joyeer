// dict_lookup.joyeer over the prototype `Table<K, V>` of dict_table_prelude.joyeer (decision 0027, stage 3): the
// strict read is `at(key:)` and the insertion `set(key:value:)`. Built only by benchmark_dicts.py through the
// array-addressor-probe tool. Prints 126332000.
func lookups(size: Int, rounds: Int): Int {
    var table: Table<Int, Int> = emptyTable(key: 0, value: 0)
    var key = 0
    while key < size {
        let inserted = key
        &table.set(key: consume inserted, value: consume (key * 3))
        key = key + 1
    }
    var total = 0
    var round = 0
    while round < rounds {
        key = 0
        while key < size {
            total = total + table.at(key: key)
            key = key + 1
        }
        key = 0
        while key < size * 2 {
            total = total + match table.get(key: key) {
                .Some(value) => value,
                .None => 1,
            }
            key = key + 1
        }
        round = round + 1
    }
    return total
}

func main() {
    print(value: lookups(size: 1, rounds: 500000) + lookups(size: 4, rounds: 125000) +
            lookups(size: 16, rounds: 32000) + lookups(size: 64, rounds: 8000))
}
