public enum CompressionError {
    InvalidArgument,
    InvalidArchive,
    UnsupportedArchive,
    LimitExceeded,
    EntryNotFound,
    DuplicateEntry,
    NativeFailure(Int),
}

public enum ZipMethod {
    Stored,
    Deflate,
}

public struct ZipEntry {
    public let name: String
    public let contents: [UInt8]
}

// Metadata for one archive entry, as recorded in the central directory. The
// location fields are internal; reading an entry re-validates them against the
// archive bytes, so a mismatched entry yields an error, never wrong memory access.
public struct ZipEntryInfo {
    public let name: String
    public let isDirectory: Bool
    // Uncompressed size in bytes.
    public let size: Int
    public let compressedSize: Int
    // CRC-32 of the uncompressed contents.
    public let crc32: UInt32
    // True for a STORE or DEFLATE entry that is not encrypted or a symbolic link.
    public let isSupported: Bool
    let headerOffset: Int
    let method: Int
    let flags: Int
}

@c_extern(symbol: "joyeer_compression_create_zip")
private func nativeCreateZip(names: [String], contents: [[UInt8]], method: Int,
    maximumBytes: Int, output: initializing [UInt8]): Int

@c_extern(symbol: "joyeer_compression_list_zip")
private func nativeListZip(archive: [UInt8], maximumEntries: Int,
    maximumNameBytes: Int, output: initializing [String]): Int

@c_extern(symbol: "joyeer_compression_extract_zip")
private func nativeExtractZip(archive: [UInt8], index: Int,
    maximumBytes: Int, output: initializing [UInt8]): Int

@c_extern(symbol: "joyeer_compression_entries_zip")
private func nativeEntriesZip(archive: [UInt8], maximumEntries: Int,
    maximumNameBytes: Int, names: initializing [String], table: initializing [UInt8]): Int

@c_extern(symbol: "joyeer_compression_read_entry")
private func nativeReadEntry(archive: [UInt8], headerOffset: Int, method: Int, flags: Int,
    compressedSize: Int, size: Int, checksum: Int, maximumBytes: Int,
    output: initializing [UInt8]): Int

private func compressionError(status: Int): CompressionError {
    return match status {
        1 => .InvalidArgument,
        2 => .InvalidArchive,
        3 => .UnsupportedArchive,
        4 => .LimitExceeded,
        5 => .EntryNotFound,
        6 => .DuplicateEntry,
        _ => .NativeFailure(status),
    }
}

extension [ZipEntry] {
    public func createZip(method: ZipMethod, maximumBytes: Int): Result<[UInt8], CompressionError> {
        if maximumBytes < 0 { return .Err(.InvalidArgument) }
        var names: [String] = []
        var contents: [[UInt8]] = []
        var index = 0
        while index < self.count {
            &names.append(element: self[index].name)
            &contents.append(element: self[index].contents)
            index = index + 1
        }
        let level = match method { .Stored => 0, .Deflate => 6 }
        var output: [UInt8]
        let status = nativeCreateZip(names: names, contents: contents, method: level,
            maximumBytes: maximumBytes, output: &output)
        if status != 0 { return .Err(compressionError(status: status)) }
        return .Ok(output)
    }
}

extension [UInt8] {
    public func listZip(maximumEntries: Int, maximumNameBytes: Int): Result<[String], CompressionError> {
        var output: [String]
        let status = nativeListZip(archive: self, maximumEntries: maximumEntries,
            maximumNameBytes: maximumNameBytes, output: &output)
        if status != 0 { return .Err(compressionError(status: status)) }
        return .Ok(output)
    }
}

extension [UInt8] {
    public func extractZipEntry(index: Int, maximumBytes: Int): Result<[UInt8], CompressionError> {
        var output: [UInt8]
        let status = nativeExtractZip(archive: self, index: index,
            maximumBytes: maximumBytes, output: &output)
        if status != 0 { return .Err(compressionError(status: status)) }
        return .Ok(output)
    }
}

extension [UInt8] {
    // One little-endian 64-bit field of the native metadata table (seven per entry).
    private func tableField(entry: Int, field: Int): Int {
        let start = entry * 56 + field * 8
        var value: UInt64 = 0
        var shift = 0
        while shift < 64 {
            value |= (self[start + shift / 8] as UInt64) << shift
            shift += 8
        }
        // Zip64 is rejected, so every stored value fits in 32 bits.
        return value as Int
    }
}

extension [UInt8] {
    // Lists every entry with its metadata, in central-directory order. Reads the
    // central directory once; pair it with readZipEntry to visit all entries in
    // linear time. Limits are inclusive, as for listZip.
    public func zipEntries(maximumEntries: Int, maximumNameBytes: Int): Result<[ZipEntryInfo], CompressionError> {
        var names: [String]
        var table: [UInt8]
        let status = nativeEntriesZip(archive: self, maximumEntries: maximumEntries,
            maximumNameBytes: maximumNameBytes, names: &names, table: &table)
        if status != 0 { return .Err(compressionError(status: status)) }
        var entries: [ZipEntryInfo] = []
        var index = 0
        while index < names.count {
            let attributes = table.tableField(entry: index, field: 6)
            &entries.append(element: ZipEntryInfo(
                name: names[index],
                isDirectory: (attributes & 1) != 0,
                size: table.tableField(entry: index, field: 2),
                compressedSize: table.tableField(entry: index, field: 1),
                crc32: table.tableField(entry: index, field: 3) as UInt32,
                isSupported: (attributes & 2) != 0,
                headerOffset: table.tableField(entry: index, field: 0),
                method: table.tableField(entry: index, field: 4),
                flags: table.tableField(entry: index, field: 5)))
            index += 1
        }
        return .Ok(entries)
    }
}

extension [UInt8] {
    // Reads one entry's contents directly from its local header, without parsing
    // the central directory again. `entry` must come from zipEntries on this same
    // archive. Directories and unsupported entries are refused. Checks size, CRC,
    // and the limit exactly like extractZipEntry.
    public func readZipEntry(entry: ZipEntryInfo, maximumBytes: Int): Result<[UInt8], CompressionError> {
        if maximumBytes < 0 { return .Err(.InvalidArgument) }
        if entry.isDirectory || !entry.isSupported { return .Err(.UnsupportedArchive) }
        var output: [UInt8]
        let status = nativeReadEntry(archive: self, headerOffset: entry.headerOffset,
            method: entry.method, flags: entry.flags, compressedSize: entry.compressedSize,
            size: entry.size, checksum: entry.crc32 as Int, maximumBytes: maximumBytes,
            output: &output)
        if status != 0 { return .Err(compressionError(status: status)) }
        return .Ok(output)
    }
}

// Why a ZIP or JAR file could not be opened or read.
public enum ZipFileError {
    ReadFailed(FileSystemError),
    FileTooLarge,
    Invalid(CompressionError),
}

// A ZIP or JAR file loaded into memory, with its entries listed. Use
// readEntry to read any entry without parsing the file again.
public struct ZipArchive {
    public let path: String
    public let entries: [ZipEntryInfo]
    let bytes: [UInt8]
}

// One entry together with its contents. Directories have empty contents.
public struct ZipFileEntry {
    public let info: ZipEntryInfo
    public let contents: [UInt8]
}

extension String {
    // Reads the whole file at `path` and lists its entries. Reading stops one byte
    // past `maximumFileBytes`, so an oversized file fails with FileTooLarge instead of
    // being loaded. The file is held in memory (twice, briefly, while it is copied
    // to bytes). Entry limits are inclusive, as for zipEntries.
    public func openZipFile(maximumFileBytes: Int, maximumEntries: Int, maximumNameBytes: Int): Result<ZipArchive, ZipFileError> {
        if maximumFileBytes < 0 { return .Err(.Invalid(.InvalidArgument)) }
        var readLimit = maximumFileBytes
        if readLimit < 9223372036854775807 { readLimit += 1 }
        let text = match readFilePrefix(path: self, maximumBytes: readLimit) {
            .Ok(value) => value,
            .Err(error) => { return .Err(.ReadFailed(error)) },
        }
        if text.count > maximumFileBytes { return .Err(.FileTooLarge) }
        let bytes = text.utf8()
        let entries = match bytes.zipEntries(maximumEntries: maximumEntries,
            maximumNameBytes: maximumNameBytes) {
            .Ok(value) => value,
            .Err(error) => { return .Err(.Invalid(error)) },
        }
        return .Ok(ZipArchive(path: self, entries: entries, bytes: bytes))
    }
}

extension ZipArchive {
    // Reads one entry of an opened file; see readZipEntry.
    public func readEntry(entry: ZipEntryInfo, maximumBytes: Int): Result<[UInt8], CompressionError> {
        return self.bytes.readZipEntry(entry: entry, maximumBytes: maximumBytes)
    }
}

extension String {
    // Opens a ZIP or JAR file and reads every entry, in central-directory order.
    // `maximumEntryBytes` limits each entry and `maximumTotalBytes` limits the sum
    // of all contents. An entry that cannot be read (encrypted, unsupported method,
    // symbolic link, or damaged) fails the whole call.
    public func readZipFile(maximumFileBytes: Int, maximumEntries: Int, maximumNameBytes: Int, maximumEntryBytes: Int, maximumTotalBytes: Int): Result<[ZipFileEntry], ZipFileError> {
        let archive = self.openZipFile(maximumFileBytes: maximumFileBytes,
            maximumEntries: maximumEntries, maximumNameBytes: maximumNameBytes)?
        var collected: [ZipFileEntry] = []
        var remaining = maximumTotalBytes
        var index = 0
        while index < archive.entries.count {
            let info = archive.entries[index]
            var contents: [UInt8] = []
            if !info.isDirectory {
                var limit = maximumEntryBytes
                if remaining < limit { limit = remaining }
                contents = match archive.readEntry(entry: info, maximumBytes: limit) {
                    .Ok(value) => value,
                    .Err(error) => { return .Err(.Invalid(error)) },
                }
                remaining -= contents.count
            }
            &collected.append(element: ZipFileEntry(info: info, contents: contents))
            index += 1
        }
        return .Ok(collected)
    }
}
