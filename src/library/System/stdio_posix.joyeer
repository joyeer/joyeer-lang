import Foundation

// POSIX (Linux and macOS) guards for stdio.joyeer. A stream is used as the C
// library left it: there is no text mode, and a closed descriptor makes the
// stdio call itself fail with EBADF.

// Returns the value to hand to leaveStderr, or a negated errno on failure.
@platform(posix)
func enterStderr(stream: Int): Int {
    return 0
}

// Returns 0, or the errno of a failure.
@platform(posix)
func leaveStderr(stream: Int, previous: Int): Int {
    return 0
}

// Returns 0, or the errno of a failure.
@platform(posix)
func prepareStdin(stream: Int): Int {
    return 0
}
