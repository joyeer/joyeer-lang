import Foundation

// Human-readable text for the host error and status types. Each message keeps
// the original platform code, so no information is lost by formatting.

extension FileSystemError {
    public func message(): String {
        return match self {
            .InvalidPath(code) => "invalid path (platform code " + code.decimalString() + ")",
            .NotFound(code) => "not found (platform code " + code.decimalString() + ")",
            .PermissionDenied(code) => "permission denied (platform code " + code.decimalString() + ")",
            .AlreadyExists(code) => "already exists (platform code " + code.decimalString() + ")",
            .NotDirectory(code) => "not a directory (platform code " + code.decimalString() + ")",
            .IsDirectory(code) => "is a directory (platform code " + code.decimalString() + ")",
            .Other(code) => "filesystem failure (platform code " + code.decimalString() + ")",
        }
    }
}

extension ProcessError {
    public func message(): String {
        return match self {
            .InvalidInput(code) => "invalid process input (platform code " + code.decimalString() + ")",
            .NotFound(code) => "executable or working directory not found (platform code " + code.decimalString() + ")",
            .PermissionDenied(code) => "process permission denied (platform code " + code.decimalString() + ")",
            .LaunchFailed(code) => "process launch failed (platform code " + code.decimalString() + ")",
            .WaitFailed(code) => "process wait failed (platform code " + code.decimalString() + ")",
        }
    }
}

extension ProcessStatus {
    public func message(): String {
        return match self {
            .Exited(code) => "exited with self " + code.decimalString(),
            .Signaled(signal) => "terminated by signal " + signal.decimalString(),
        }
    }
}
