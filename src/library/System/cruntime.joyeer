// The C library's per-thread `errno` and the process environment, for the POSIX
// operations that still call the C library (`fopen`, `readdir_r`, `posix_spawn`).
// Windows `System` calls only the operating system and has none of this. A Joyeer
// binding cannot dereference the pointer that `errno` expands to or name a C global
// as a value, so each platform binds what it offers: a function that returns the
// address (`__errno_location`, `__error`, `_NSGetEnviron`) or the address of the
// variable itself (`@c_data`), and the value is read with the runtime-only load
// intrinsics (spec §19.4.5).

@c_extern(symbol: "joyeer_intrinsic_load_u32")
private func load32(address: Int): UInt32

@c_extern(symbol: "joyeer_intrinsic_load_u64")
private func load64(address: Int): UInt64

@platform(linux)
@c_extern(symbol: "__errno_location")
private func errnoLocation(): Int

@platform(macos)
@c_extern(symbol: "__error")
private func errnoLocation(): Int

// The calling thread's `errno`.
@platform(posix)
func cErrno(): Int32 {
    return load32(address: errnoLocation()) as Int32
}

@platform(linux)
@c_data(symbol: "environ")
private func environVariable(): Int

@platform(macos)
@c_extern(symbol: "_NSGetEnviron")
private func environLocation(): Int

// The address of the process environment block, as `envp` for POSIX spawning.
@platform(linux)
func cEnvironment(): Int {
    return load64(address: environVariable()) as Int
}

@platform(macos)
func cEnvironment(): Int {
    return load64(address: environLocation()) as Int
}
