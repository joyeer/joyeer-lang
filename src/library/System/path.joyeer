import Foundation

// Lexical path helpers. The host is not detected: callers pass `windows`
// explicitly, so behavior is deterministic and testable on any platform.
// Nothing here touches the filesystem, canonicalizes, or proves confinement.

extension UInt8 {
    public func isPathSeparator(windows: Bool): Bool {
        return self == b'/' || (windows && self == b'\\')
    }
}

extension String {
    private func hasDrivePrefix(windows: Bool): Bool {
        if !windows || self.count < 2 { return false }
        let first = self[0]
        return ((first >= b'a' && first <= b'z') ||
            (first >= b'A' && first <= b'Z')) && self[1] == b':'
    }

    // Directory part of a path, preserving the caller's coordinates. Roots and
    // drive-relative paths keep their root; a path with no separator is ".".
    public func pathDirectory(windows: Bool): String {
        var last = -1
        var index = 0
        while index < self.count {
            if self[index].isPathSeparator(windows: windows) { last = index }
            index = index + 1
        }
        if last >= 0 {
            if windows && last > 0 && self[last - 1] == b':' {
                // Preserve both C:\ and extended \?\C:\ drive roots.
                return self.substring(start: 0, end: last + 1)
            }
            var rootPrefix = true
            index = 0
            while index < last {
                if !self[index].isPathSeparator(windows: windows) { rootPrefix = false }
                index = index + 1
            }
            if rootPrefix { return self.substring(start: 0, end: last + 1) }
            return self.substring(start: 0, end: last)
        }
        if self.hasDrivePrefix(windows: windows) {
            return self.substring(start: 0, end: 2)
        }
        return "."
    }

    // Removes trailing separators but never the root (`/`, or `C:\` on Windows).
    public func trimDirectoryPath(windows: Bool): String {
        var minimum = 1
        if self.hasDrivePrefix(windows: windows) && self.count >= 3 {
            if self[2].isPathSeparator(windows: windows) { minimum = 3 }
        }
        var end = self.count
        while end > minimum {
            if !self[end - 1].isPathSeparator(windows: windows) { break }
            end = end - 1
        }
        return self.substring(start: 0, end: end)
    }
}
