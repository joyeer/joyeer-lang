private func projectCommand(options: borrowing CliOptions): Int {
    let project = match loadProject(options: options) {
        .Ok(loaded) => loaded,
        .Err(error) => {
            return failureStatus(error: error.error, manifestPath: error.path,
                contents: error.contents, status: 1)
        },
    }
    let selected = match selectModules(project: project, options: options) {
        .Ok(modules) => modules,
        .Err(error) => {
            return failureStatus(error: error, manifestPath: "", contents: "", status: 2)
        },
    }
    return match executeProject(project: project, options: options, selected: selected) {
        .Ok(status) => status,
        .Err(error) => failureStatus(error: error, manifestPath: "", contents: "", status: 1),
    }
}

func main(args: [String]): Int {
    let options = match parseCli(args: args) {
        .Ok(parsed) => parsed,
        .Err(error) => {
            return failureStatus(error: error, manifestPath: "", contents: "", status: 2)
        },
    }
    if options.command == "--help" {
        printHelp()
        return 0
    }
    if options.command == "--version" {
        print(value: "joypm 0.1.0")
        return 0
    }
    if options.command == "init" {
        return match initializeProject(options: options) {
            .Ok(status) => status,
            .Err(error) => failureStatus(error: error, manifestPath: "", contents: "", status: 1),
        }
    }
    return projectCommand(options: options)
}
