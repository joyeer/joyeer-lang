struct CliOptions {
    let command: String
    let compiler: String
    let manifestPath: String
    let workspacePath: String
    let release: Bool
    let verbose: Bool
    let module: String
    let directory: String
    let name: String
    let kind: String
    let output: String
    let childArgs: [String]
}

private func cliValue(args: borrowing [String], index: Int, option: String): Result<String, ToolError> {
    if index < 0 || index >= args.count {
        return .Err(ToolError(message: "missing value for " + option, pos: -1))
    }
    let value = args[index]
    if value.count == 0 || value[0] == b'-' {
        return .Err(ToolError(message: "missing nonempty value for " + option +
            "; prefix a path beginning with '-' with './'", pos: -1))
    }
    if !validHostText(text: value) {
        return .Err(ToolError(message: "value for " + option +
            " must be UTF-8 without NUL", pos: -1))
    }
    return .Ok(value)
}

func parseCli(args: [String]): Result<CliOptions, ToolError> {
    if args.count == 0 {
        return .Err(ToolError(message: "expected a command; use joypm --help", pos: -1))
    }
    let command = args[0]
    let meta = command == "--help" || command == "--version"
    if meta && args.count != 1 {
        return .Err(ToolError(message: command + " must be used alone", pos: -1))
    }
    let project = command == "check" || command == "build" || command == "run" || command == "test"
    if !meta && !project && command != "init" {
        return .Err(ToolError(message: "unknown command: " + command + "; use joypm --help", pos: -1))
    }
    var compiler = ""
    var manifestPath = "project.toml"
    var workspacePath = ""
    var hasManifest = false
    var release = false
    var verbose = false
    var module = ""
    var directory = ""
    var name = ""
    var kind = "bin"
    var hasKind = false
    var output = ""
    var childArgs: [String] = []
    var index = 1
    while index < args.count {
        let argument = args[index]
        if argument == "--" {
            if command != "run" && command != "test" {
                return .Err(ToolError(message: "child arguments after '--' are only valid for run and test", pos: -1))
            }
            index = index + 1
            while index < args.count {
                let childArgument = args[index]
                &childArgs.append(element: childArgument)
                index = index + 1
            }
            break
        } else if argument == "--compiler" {
            if !project || compiler.count != 0 {
                return .Err(ToolError(message: "duplicate --compiler or --compiler is not valid for init", pos: -1))
            }
            compiler = cliValue(args: args, index: index + 1, option: argument)?
            index = index + 2
        } else if argument == "--manifest-path" || argument == "--workspace" {
            if !project || hasManifest || workspacePath.count != 0 {
                return .Err(ToolError(message: "--manifest-path and --workspace are mutually exclusive project options", pos: -1))
            }
            let path = cliValue(args: args, index: index + 1, option: argument)?
            if argument == "--manifest-path" {
                hasManifest = true
                manifestPath = path
            } else {
                workspacePath = path
            }
            index = index + 2
        } else if argument == "--release" || argument == "--verbose" {
            if !project || (argument == "--release" && release) || (argument == "--verbose" && verbose) {
                return .Err(ToolError(message: "duplicate or invalid project option: " + argument, pos: -1))
            }
            if argument == "--release" { release = true }
            else { verbose = true }
            index = index + 1
        } else if argument == "--module" {
            if !project || module.count != 0 {
                return .Err(ToolError(message: "duplicate --module or --module is not valid for init", pos: -1))
            }
            module = cliValue(args: args, index: index + 1, option: argument)?
            if !validModuleName(name: module) {
                return .Err(ToolError(message: "--module requires an exact logical module name", pos: -1))
            }
            index = index + 2
        } else if argument == "--target" {
            return .Err(ToolError(message: "--target is removed; use --module <logical module name>", pos: -1))
        } else if argument == "--name" || argument == "--kind" || argument == "--output" {
            if command != "init" {
                return .Err(ToolError(message: argument + " is only valid for init", pos: -1))
            }
            let value = cliValue(args: args, index: index + 1, option: argument)?
            if argument == "--name" {
                if name.count != 0 || !validModuleName(name: value) {
                    return .Err(ToolError(message: "--name requires one logical module name", pos: -1))
                }
                name = value
            } else if argument == "--kind" {
                if hasKind || (value != "source" && value != "bin" && value != "test") {
                    return .Err(ToolError(message: "--kind requires source, bin, or test and may occur once", pos: -1))
                }
                hasKind = true
                kind = value
            } else {
                if output.count != 0 || !validPortableName(name: value) {
                    return .Err(ToolError(message: "--output requires one portable artifact name", pos: -1))
                }
                output = value
            }
            index = index + 2
        } else {
            if command != "init" || directory.count != 0 || argument.count == 0 ||
                argument[0] == b'-' || !validHostText(text: argument) {
                return .Err(ToolError(message: "unexpected argument or option: " + argument, pos: -1))
            }
            directory = argument
            index = index + 1
        }
    }
    if project && compiler.count == 0 {
        return .Err(ToolError(message: command + " requires --compiler <explicit executable path>", pos: -1))
    }
    if command == "init" {
        if directory.count == 0 || name.count == 0 {
            return .Err(ToolError(message: "init requires <directory> and --name <logical module name>", pos: -1))
        }
        if kind == "source" && output.count != 0 {
            return .Err(ToolError(message: "source modules do not declare an output", pos: -1))
        }
        if kind != "source" && !validArtifactModuleName(name: name) {
            return .Err(ToolError(message: "bin/test module name is not a valid artifact-directory component", pos: -1))
        }
        if kind != "source" && output.count == 0 {
            var start = 0
            var cursor = 0
            while cursor < name.count {
                if name[cursor] == b'.' { start = cursor + 1 }
                cursor = cursor + 1
            }
            output = textSlice(text: name, start: start, end: name.count)
            if !validPortableName(name: output) {
                return .Err(ToolError(message: "module name needs an explicit portable --output", pos: -1))
            }
        }
    }
    return .Ok(CliOptions(command: command, compiler: compiler, manifestPath: manifestPath,
        workspacePath: workspacePath, release: release, verbose: verbose, module: module,
        directory: directory, name: name, kind: kind, output: output, childArgs: childArgs))
}

func printHelp() {
    print(value: "joypm 0.1.0 - local Joyeer module and workspace manager\n" +
        "Usage:\n" +
        "  joypm --help\n" +
        "  joypm --version\n" +
        "  joypm init <directory> --name <module> [--kind source|bin|test] [--output <name>]\n" +
        "  joypm check|build|run|test --compiler <path> [project options] [--module <name>]\n" +
        "Project options: --manifest-path <project.toml> OR --workspace <workspace.toml>, --release, --verbose\n" +
        "Default input: project.toml in the current directory; no upward discovery.\n" +
        "Module schema 1: one [module], explicit sources/dependencies, kind, and bin/test output.\n" +
        "Workspace schema 1: one [workspace] with explicit member directories.\n" +
        "check selects all module kinds; build/run select bin; test selects test.\n" +
        "run/test forward arguments after '--'. Compiler paths are explicit; no shell or PATH lookup.\n" +
        "Debug: -O0 -gfull. Release: -O2 -g0. Selected modules always rebuild.\n" +
        "Outputs: target/<profile>/<module>/build-1 through build-128; no automatic cleanup.\n" +
        "Limits: 65536 bytes/manifest, 4096 bytes/string, 256 members, 1024 entries/array.\n" +
        "Status: 0 success, 1 manifest/build/host failure, 2 usage/selection error.")
}
