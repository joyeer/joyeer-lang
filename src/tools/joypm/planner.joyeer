struct PlannedModule {
    let name: String
    let sources: [String]
}

struct BuildPlan {
    let moduleName: String
    let outputName: String
    let modules: [PlannedModule]
    let profile: String
    let native: Bool
    let workingDirectory: String
    let artifactParent: String
}

struct CompilerInvocation {
    let executable: String
    let arguments: [String]
    let workingDirectory: String
}

private func sortModuleIndexes(modules: borrowing [ProjectModule], indexes: inout [Int]) {
    var index = 1
    while index < indexes.count {
        let current = indexes[index]
        let name = modules[current].spec.name
        var destination = index
        while destination > 0 {
            let previous = indexes[destination - 1]
            if !(name < modules[previous].spec.name) { break }
            &indexes[destination] = previous
            destination = destination - 1
        }
        &indexes[destination] = current
        index = index + 1
    }
}

func selectModules(project: borrowing Project, options: borrowing CliOptions): Result<[Int], ToolError> {
    var selected: [Int] = []
    var index = 0
    var found = false
    while index < project.modules.count {
        let name = project.modules[index].spec.name
        let kind = project.modules[index].spec.kind
        if options.module.count == 0 || name == options.module {
            found = true
            let eligible = options.command == "check" ||
                (options.command == "test" && kind == "test") ||
                ((options.command == "build" || options.command == "run") && kind == "bin")
            if eligible {
                &selected.append(element: index)
            } else if options.module.count != 0 {
                return .Err(ToolError(message: "module '" + name + "' has kind '" + kind +
                    "', which cannot be selected for " + options.command, pos: -1))
            }
        }
        index = index + 1
    }
    if options.module.count != 0 && !found {
        return .Err(ToolError(message: "unknown module '" + options.module + "' for " + options.command, pos: -1))
    }
    if options.command == "run" && selected.count != 1 {
        return .Err(ToolError(message: "run requires exactly one bin module; select one with --module <name>", pos: -1))
    }
    sortModuleIndexes(modules: project.modules, indexes: &selected)
    return .Ok(selected)
}

private func moduleClosure(project: borrowing Project, root: Int): [Int] {
    var seen: [Bool] = []
    var index = 0
    while index < project.modules.count {
        &seen.append(element: false)
        index = index + 1
    }
    &seen[root] = true
    var queue: [Int] = [root]
    var cursor = 0
    while cursor < queue.count {
        let node = queue[cursor]
        var edge = 0
        while edge < project.modules[node].dependencyIndexes.count {
            let dependency = project.modules[node].dependencyIndexes[edge]
            if !seen[dependency] {
                &seen[dependency] = true
                &queue.append(element: dependency)
            }
            edge = edge + 1
        }
        cursor = cursor + 1
    }
    sortModuleIndexes(modules: project.modules, indexes: &queue)
    return queue
}

private func planSources(sources: borrowing [String], base: String): Result<[String], ToolError> {
    let ordered = sortedStrings(values: sources)
    var paths: [String] = []
    var index = 0
    while index < ordered.count {
        let path = toolJoin(base: base, path: ordered[index])?
        &paths.append(element: path)
        index = index + 1
    }
    return .Ok(paths)
}

func planModule(project: borrowing Project, options: borrowing CliOptions,
    moduleIndex: Int): Result<BuildPlan, ToolError> {
    if moduleIndex < 0 || moduleIndex >= project.modules.count {
        return .Err(ToolError(message: "internal invalid selected module index", pos: -1))
    }
    let name = project.modules[moduleIndex].spec.name
    let closure = moduleClosure(project: project, root: moduleIndex)
    var modules: [PlannedModule] = []
    var index = 0
    while index < closure.count {
        let node = closure[index]
        let paths = planSources(sources: project.modules[node].spec.sources, base: project.modules[node].directory)?
        &modules.append(element: PlannedModule(name: project.modules[node].spec.name, sources: paths))
        index = index + 1
    }
    var profile = "debug"
    if options.release { profile = "release" }
    let native = options.command != "check"
    var artifactParent = ""
    if native {
        let targetDirectory = toolJoin(base: project.directory, path: "target")?
        let profileDirectory = toolJoin(base: targetDirectory, path: profile)?
        artifactParent = toolJoin(base: profileDirectory, path: name)?
    }
    return .Ok(BuildPlan(moduleName: name, outputName: project.modules[moduleIndex].spec.output,
        modules: modules, profile: profile, native: native,
        workingDirectory: project.directory, artifactParent: artifactParent))
}

func compilerInvocation(plan: borrowing BuildPlan, compiler: String, output: String): Result<CompilerInvocation, ToolError> {
    if (plan.native && output.count == 0) || (!plan.native && output.count != 0) {
        return .Err(ToolError(message: "internal invalid output for module '" + plan.moduleName + "'", pos: -1))
    }
    var arguments: [String] = ["--module-name", plan.moduleName]
    var rootIndex = -1
    var index = 0
    while index < plan.modules.count {
        if plan.modules[index].name == plan.moduleName {
            rootIndex = index
        } else {
            var source = 0
            while source < plan.modules[index].sources.count {
                let input = plan.modules[index].name + "=" + plan.modules[index].sources[source]
                &arguments.append(element: "--module-source")
                &arguments.append(element: input)
                source = source + 1
            }
        }
        index = index + 1
    }
    if rootIndex < 0 {
        return .Err(ToolError(message: "internal missing root module '" + plan.moduleName + "'", pos: -1))
    }
    if plan.profile == "release" {
        &arguments.append(element: "-O2")
        &arguments.append(element: "-g0")
    } else {
        &arguments.append(element: "-O0")
        &arguments.append(element: "-gfull")
    }
    if plan.native {
        &arguments.append(element: "-o")
        &arguments.append(element: output)
    }
    &arguments.append(element: "--")
    var source = 0
    while source < plan.modules[rootIndex].sources.count {
        let input = plan.modules[rootIndex].sources[source]
        &arguments.append(element: input)
        source = source + 1
    }
    return .Ok(CompilerInvocation(executable: compiler, arguments: arguments, workingDirectory: "."))
}
