// `print` for strings, integers, `Float`, `Double`, `Bool` and bytes
// (`joyeer_print_string_abi`, `joyeer_print_{int,uint,float,double,bool,byte}`), written to the C library's standard
// output stream so buffering and ordering stay those of the rest of the program
// (`System` shares the same stream). A value is followed by one newline.
//
// Integers and strings allocate nothing: digits go out one `fputc` at a time, most
// significant first. Floating-point values are formatted in scratch memory from
// the allocator (floats.joyeer).
//
// This is a runtime core unit: scalars and addresses held as `Int` only (runtime
// plan §4).

@c_extern(symbol: "joyeer_intrinsic_literal_address")
private func literalAddress(text: String): Int

@c_extern(symbol: "joyeer_intrinsic_load_u64")
private func load64(address: Int): UInt64

@c_extern(symbol: "joyeer_intrinsic_store_u8")
private func store8(address: Int, value: UInt8): Void

@platform(windows)
@c_extern(symbol: "__acrt_iob_func")
private func iobFunction(index: UInt32): Int

@platform(linux)
@c_data(symbol: "stdout")
private func stdoutVariable(): Int

@platform(macos)
@c_data(symbol: "__stdoutp")
private func stdoutVariable(): Int

// The C `FILE*` of standard output, the stream `System` also writes through.
@platform(windows)
private func standardOutput(): Int { return iobFunction(index: 1) }

@platform(posix)
private func standardOutput(): Int { return load64(address: stdoutVariable()) as Int }

@c_extern(symbol: "fwrite")
private func writeStream(buffer: Int, size: Int, count: Int, stream: Int): Int

@c_extern(symbol: "fputc")
private func putByte(byte: Int32, stream: Int): Int32

private func endLine(stream: Int) {
    putByte(byte: 10, stream: stream)
}

private func putDecimal(stream: Int, value: UInt64) {
    // The largest power of ten not above `value`; 10^19 is the most a UInt64 holds.
    var divisor: UInt64 = 1
    while value / divisor >= 10 { divisor = divisor * 10 }
    var remaining = value
    while divisor != 0 {
        let digit = remaining / divisor
        putByte(byte: (48 + digit) as Int32, stream: stream)
        remaining = remaining - digit * divisor
        divisor = divisor / 10
    }
}

@c_export(symbol: "joyeer_print_string_abi")
public func printString(data: Int, count: Int): Void {
    if count < 0 || (count != 0 && data == 0) {
        panic(message: literalAddress(text: "invalid string"))
    }
    let stream = standardOutput()
    if count != 0 { writeStream(buffer: data, size: 1, count: count, stream: stream) }
    endLine(stream: stream)
}

@c_export(symbol: "joyeer_print_uint")
public func printUnsigned(value: UInt64): Void {
    let stream = standardOutput()
    putDecimal(stream: stream, value: value)
    endLine(stream: stream)
}

@c_export(symbol: "joyeer_print_int")
public func printInteger(value: Int): Void {
    let stream = standardOutput()
    if value < 0 {
        putByte(byte: 45, stream: stream)
        // value + 1 cannot overflow below zero, and the magnitude of Int.min
        // does not fit an Int: take it from the UInt64 side.
        putDecimal(stream: stream, value: ((0 - (value + 1)) as UInt64) + 1)
    } else {
        putDecimal(stream: stream, value: value as UInt64)
    }
    endLine(stream: stream)
}

@c_export(symbol: "joyeer_print_byte")
public func printByte(value: UInt8): Void {
    let stream = standardOutput()
    putDecimal(stream: stream, value: value as UInt64)
    endLine(stream: stream)
}

@c_export(symbol: "joyeer_print_bool")
public func printBool(value: Bool): Void {
    let stream = standardOutput()
    if value {
        writeStream(buffer: literalAddress(text: "true"), size: 1, count: 4, stream: stream)
    } else {
        writeStream(buffer: literalAddress(text: "false"), size: 1, count: 5, stream: stream)
    }
    endLine(stream: stream)
}

// Writes the `count` bytes of formatted text in `scratch`, then a newline, with
// one `fwrite`, and gives the scratch memory back.
private func finishFormatted(scratch: Int, count: Int) {
    store8(address: scratch + formatTextOffset + count, value: 10)
    writeStream(buffer: scratch + formatTextOffset, size: 1, count: count + 1, stream: standardOutput())
    release(address: scratch, size: formatScratchBytes)
}

// A Double with 17 significant digits.
@c_export(symbol: "joyeer_print_double")
public func printDouble(value: Double): Void {
    let scratch = allocate(size: formatScratchBytes)
    finishFormatted(scratch: scratch, count: formatDouble(scratch: scratch, precision: 17, value: value))
}

// A Float with the 9 significant digits that identify it.
@c_export(symbol: "joyeer_print_float")
public func printFloat(value: Float): Void {
    let scratch = allocate(size: formatScratchBytes)
    finishFormatted(scratch: scratch, count: formatFloat(scratch: scratch, precision: 9, value: value))
}
